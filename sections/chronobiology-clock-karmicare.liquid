{{ 'section-chronobiology-clock-karmicare.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'chronobiology-clock-karmicare.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  @font-face {
    font-family: 'Proxima Nova';
    src: url('{{ 'proxima-nova-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Proxima Nova';
    src: url('{{ 'proxima-nova-medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500 800;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gotham Rounded';
    src: url('{{ 'gotham-rounded-medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-display: swap;
  }

  #shopify-section-{{ section.id }} .chronobiology-clock {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .chronobiology-clock {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Day Mode custom colors/gradient */
  {%- if section.settings.bg_gradient_day != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock {
      background: {{ section.settings.bg_gradient_day }};
    }
  {%- elsif section.settings.bg_color_day != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock {
      --page: {{ section.settings.bg_color_day }};
      background: {{ section.settings.bg_color_day }};
    }
  {%- endif -%}

  {%- if section.settings.text_color_day != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock {
      --ink: {{ section.settings.text_color_day }};
      color: {{ section.settings.text_color_day }};
    }
  {%- endif -%}

  /* Night Mode custom colors/gradient */
  {%- if section.settings.bg_gradient_night != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock[data-theme="night"],
    body.night-mode #shopify-section-{{ section.id }} .chronobiology-clock {
      background: {{ section.settings.bg_gradient_night }};
    }
  {%- elsif section.settings.bg_color_night != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock[data-theme="night"],
    body.night-mode #shopify-section-{{ section.id }} .chronobiology-clock {
      --page: {{ section.settings.bg_color_night }};
      background: {{ section.settings.bg_color_night }};
    }
  {%- endif -%}

  {%- if section.settings.text_color_night != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock[data-theme="night"],
    body.night-mode #shopify-section-{{ section.id }} .chronobiology-clock {
      --ink: {{ section.settings.text_color_night }};
      color: {{ section.settings.text_color_night }};
    }
  {%- endif -%}

  {%- if section.settings.link_color != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock .science {
      color: {{ section.settings.link_color }};
    }
  {%- endif -%}
{%- endstyle -%}

<div
  id="ChronobiologyClock-{{ section.id }}"
  class="chronobiology-clock"
  data-theme="day"
  aria-label="{{ section.settings.title | escape }}"
>
  <main class="chrono" aria-labelledby="clock-heading-{{ section.id }}">
    <header class="heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
        <{{ heading_tag }} id="clock-heading-{{ section.id }}" class="clock-heading">
          {{ section.settings.title }}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="lede">{{ section.settings.description }}</p>
      {%- endif -%}
    </header>

    <div class="stage">
      <div class="dial">
        <div class="artwork" aria-hidden="true">
          <img class="blue-orb" src="{{ 'orb-blue.webp' | asset_url }}" alt="" width="440" height="440" loading="lazy">
          <img class="white-orb" src="{{ 'orb-white.webp' | asset_url }}" alt="" width="440" height="440" loading="lazy">
          <div class="arcs">
            <img class="arc-asleep" src="{{ 'arc-asleep.svg' | asset_url }}" alt="" width="273" height="214">
            <img class="arc-awake" src="{{ 'arc-awake.svg' | asset_url }}" alt="" width="361" height="340">
          </div>
          <img class="ticks" src="{{ 'hour-ticks.svg' | asset_url }}" alt="" width="420" height="420">
          <img class="sun" src="{{ 'sun.svg' | asset_url }}" alt="" width="32" height="32">
          <img class="moon" src="{{ 'moon.svg' | asset_url }}" alt="" width="32" height="32">
          <img class="leader leader-morning" src="{{ 'leader.svg' | asset_url }}" alt="" width="58" height="1">
          <img class="leader leader-evening" src="{{ 'leader.svg' | asset_url }}" alt="" width="58" height="1">
          <span class="pin pin-morning">
            <img src="{{ 'pin-morning.svg' | asset_url }}" alt="" width="30" height="30">
            <img src="{{ 'pin-dot.svg' | asset_url }}" alt="" width="14" height="14">
          </span>
          <span class="pin pin-evening">
            <img src="{{ 'pin-evening.svg' | asset_url }}" alt="" width="30" height="30">
            <img src="{{ 'pin-dot.svg' | asset_url }}" alt="" width="14" height="14">
          </span>
          <span class="shift-label shift-awake">Awake</span>
          <span class="shift-label shift-asleep">Asleep</span>
        </div>

        <div class="orbit" aria-hidden="true"></div>

        <div
          class="knob"
          id="clock-knob-{{ section.id }}"
          tabindex="0"
          role="slider"
          aria-label="Explore your mouth's 24-hour clock"
          aria-describedby="clock-help-{{ section.id }}"
          aria-valuemin="0"
          aria-valuemax="1439"
          aria-valuenow="0"
          aria-valuetext="Loading current local time"
        >
          <img src="{{ 'drag.svg' | asset_url }}" alt="" draggable="false" width="24" height="24">
        </div>
      </div>

      <section class="callout callout-morning" aria-labelledby="morning-heading-{{ section.id }}">
        {%- if section.settings.morning_badge != blank -%}
          <p class="callout-badge">{{ section.settings.morning_badge | escape }}</p>
        {%- endif -%}
        {%- if section.settings.morning_title != blank -%}
          <h3 id="morning-heading-{{ section.id }}">{{ section.settings.morning_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.morning_text != blank -%}
          <p class="description">{{ section.settings.morning_text | escape }}</p>
        {%- endif -%}
      </section>

      <section class="callout callout-evening" aria-labelledby="evening-heading-{{ section.id }}">
        {%- if section.settings.night_badge != blank -%}
          <p class="callout-badge">{{ section.settings.night_badge | escape }}</p>
        {%- endif -%}
        {%- if section.settings.night_title != blank -%}
          <h3 id="evening-heading-{{ section.id }}">{{ section.settings.night_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.night_text != blank -%}
          <p class="description">{{ section.settings.night_text | escape }}</p>
        {%- endif -%}
      </section>
    </div>

    <div class="readout" data-mode="live">
      <button type="button" class="hint" aria-controls="clock-knob-{{ section.id }}">
        <img src="{{ 'drag.svg' | asset_url }}" alt="" width="24" height="24">
        <span>EXPLORE YOUR DAILY RHYTHM</span>
      </button>
      <p class="time-line"><time id="clock-time-{{ section.id }}" class="clock-time">--:--</time> · <span id="clock-caption-{{ section.id }}" class="clock-caption">your mouth right now:</span></p>
      <p class="state-copy clock-copy" id="clock-copy-{{ section.id }}"></p>
      <p class="sr-only" id="clock-help-{{ section.id }}">Drag the knob around the ring to preview a local time. Release to return to the current time. Hold an arrow key to preview in five-minute steps; Page Up and Page Down change one hour. Home selects midnight; End selects 23:59. Release the key, press Escape, or leave the control to return to now.</p>
      <noscript><p>Enable JavaScript to explore the clock and see your current local time.</p></noscript>
    </div>

    {%- if section.settings.footer_text != blank or section.settings.footer_link_text != blank -%}
      <footer class="footer">
        {%- if section.settings.footer_text != blank -%}
          <span>{{ section.settings.footer_text | escape }} </span>
        {%- endif -%}
        {%- if section.settings.footer_link_text != blank -%}
          <a
            class="science"
            href="{{ section.settings.footer_link | default: 'https://karmicare.com/en/why-karmicare' }}"
            target="_blank"
            rel="noopener"
          >
            {{- section.settings.footer_link_text | escape -}}
            <img src="{{ 'arrow-right.svg' | asset_url }}" alt="" width="16" height="16">
            <span class="sr-only"> (opens a new tab)</span>
          </a>
        {%- endif -%}
      </footer>
    {%- endif -%}
  </main>
</div>

{% schema %}
{
  "name": "Circadian 24h Clock",
  "tag": "section",
  "class": "section-chronobiology-clock",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subheading",
      "default": "CHRONOBIOLOGY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Your mouth runs on a 24-hour clock."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2 (Recommended)" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bacteria, saliva and acids each keep their own hours. What it needs at 07:00 is not what it needs at 22:00."
    },
    {
      "type": "header",
      "content": "Morning Shift (Left Callout)"
    },
    {
      "type": "text",
      "id": "morning_badge",
      "label": "Morning Time Badge",
      "default": "≈ 06:40 · Neisseria peaks"
    },
    {
      "type": "text",
      "id": "morning_title",
      "label": "Morning Title",
      "default": "Your mouth wakes up"
    },
    {
      "type": "textarea",
      "id": "morning_text",
      "label": "Morning Description",
      "default": "Cortisol rises; coffee, breakfast and the day's first acids follow. Enamel needs its shield on first."
    },
    {
      "type": "header",
      "content": "Night Shift (Right Callout)"
    },
    {
      "type": "text",
      "id": "night_badge",
      "label": "Night Time Badge",
      "default": "≈ 22:00 · Fusobacterium peaks"
    },
    {
      "type": "text",
      "id": "night_title",
      "label": "Night Title",
      "default": "Your mouth switches to repair"
    },
    {
      "type": "textarea",
      "id": "night_text",
      "label": "Night Description",
      "default": "Melatonin rises and saliva slows to a trickle. What's on your enamel at 22:00 is still there at 07:00."
    },
    {
      "type": "header",
      "content": "Live Rhythm Status (Center Bottom)"
    },
    {
      "type": "text",
      "id": "status_eyebrow",
      "label": "Status Eyebrow (Fallback)",
      "default": "09:06 · YOUR MOUTH RIGHT NOW:"
    },
    {
      "type": "textarea",
      "id": "status_text",
      "label": "Status Text (Fallback)",
      "default": "Breakfast and coffee pulled your pH down within minutes. Saliva needs about half an hour to bring it back."
    },
    {
      "type": "header",
      "content": "Footer Link / CTA"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Note",
      "default": "Formulated for both shifts: Awake by day, Asleep by night."
    },
    {
      "type": "text",
      "id": "footer_link_text",
      "label": "Link Label",
      "default": "Read the science"
    },
    {
      "type": "url",
      "id": "footer_link",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#7FB9FF"
    },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)",
      "default": "linear-gradient(180deg, #FFFBF6 0%, #F2F8FF 100%)"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)",
      "default": "#191F38"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)",
      "default": "linear-gradient(180deg, #101526 0%, #1C2A45 100%)"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 44
    }
  ],
  "presets": [
    {
      "name": "Circadian 24h Clock"
    }
  ]
}
{% endschema %}
