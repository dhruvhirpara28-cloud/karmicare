{{ 'section-chronobiology-clock-karmicare.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'chronobiology-clock-karmicare.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} .chronobiology-clock {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .chronobiology-clock {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Optional overrides. Blank (the default) keeps the KC token colours. */
  {%- if section.settings.text_color_day != blank -%}
    #shopify-section-{{ section.id }} .chronobiology-clock {
      --chrono-ink: {{ section.settings.text_color_day }};
    }
  {%- endif -%}

  {%- if section.settings.text_color_night != blank -%}
    body.night-mode #shopify-section-{{ section.id }} .chronobiology-clock {
      --chrono-ink: {{ section.settings.text_color_night }};
    }
  {%- endif -%}
{%- endstyle -%}

<div
  id="ChronobiologyClock-{{ section.id }}"
  class="chronobiology-clock chronobiology-clock--time-{{ section.settings.time_label_size | default: 'large' }} kc-surface"
  data-kc-surface="{{ section.settings.surface }}"
  data-theme="day"
  aria-label="{{ section.settings.title | escape }}"
>
  <div class="chrono" aria-labelledby="clock-heading-{{ section.id }}">
    <div class="heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
        <{{ heading_tag }} id="clock-heading-{{ section.id }}" class="clock-heading">
          {{- section.settings.title -}}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="lede">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="stage">
      <div class="timeline">
        <div class="dial">
          <div class="artwork" aria-hidden="true">
            <img class="blue-orb" src="{{ 'orb-blue.webp' | asset_url }}" alt="" width="440" height="440" loading="lazy">
            <img class="white-orb" src="{{ 'orb-white.webp' | asset_url }}" alt="" width="440" height="440" loading="lazy">
            <div class="arcs">
              <img class="arc-asleep" src="{{ 'arc-asleep.svg' | asset_url }}" alt="" width="273" height="214">
              <img class="arc-awake" src="{{ 'arc-awake.svg' | asset_url }}" alt="" width="361" height="340">
            </div>
            {%- comment -%} Figma "hour ticks · 24h, noon on top" (its 23 tick paths drawn as one path), coloured by token {%- endcomment -%}
            <svg class="ticks" viewBox="0 0 420 420" fill="none" focusable="false">
              <path d="M210 402V413M160.31 395.461L159.01 400.291M114 376.279L111.5 380.609M74.2392 345.76L70.6992 349.3M43.7206 306L39.3906 308.5M24.5409 259.689L19.7109 260.989M18 210H7M24.5409 160.31L19.7109 159.01M43.7206 114L39.3906 111.5M74.2392 74.2392L70.6992 70.6992M114 43.7206L111.5 39.3906M160.31 24.5409L159.01 19.7109M210 18V7M259.689 24.5409L260.989 19.7109M306 43.7206L308.5 39.3906M345.76 74.2392L349.3 70.6992M376.279 114L380.609 111.5M395.461 160.31L400.291 159.01M402 210H413M395.461 259.689L400.291 260.989M376.279 306L380.609 308.5M345.76 345.76L349.3 349.3M259.689 395.461L260.989 400.291" stroke="currentColor"/>
            </svg>
            {%- comment -%} Figma "anchor · noon (sun)" and "anchor · midnight (moon)" {%- endcomment -%}
            <svg class="sun" viewBox="0 0 36 36" fill="none" focusable="false">
              <path d="M18 23.5C21.0376 23.5 23.5 21.0376 23.5 18C23.5 14.9624 21.0376 12.5 18 12.5C14.9624 12.5 12.5 14.9624 12.5 18C12.5 21.0376 14.9624 23.5 18 23.5Z" stroke="currentColor" stroke-width="1.25"/>
              <path d="M27.5 18H31M24.7207 24.7207L27.1907 27.1907M18 27.5V31M11.2805 24.7207L8.81055 27.1907M8.5 18H5M11.2805 11.2805L8.81055 8.81055M18 8.5V5M24.7207 11.2805L27.1907 8.81055" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <svg class="moon" viewBox="0 0 28 28" fill="none" focusable="false">
              <path d="M17.0005 3.39992C14.9221 2.83867 12.7248 2.89964 10.6807 3.57526C8.63663 4.25088 6.83575 5.51145 5.50123 7.20076C4.16672 8.89006 3.35724 10.9338 3.17312 13.0788C2.989 15.2237 3.43833 17.3755 4.46543 19.2675C5.49253 21.1596 7.05224 22.7086 8.95126 23.7227C10.8503 24.7368 13.0051 25.1713 15.1488 24.9725C17.2924 24.7737 19.3306 23.9502 21.0107 22.6041C22.6908 21.2581 23.939 19.4486 24.6005 17.3999C22.987 17.3567 21.4133 16.8897 20.0374 16.0458C18.6614 15.202 17.5317 14.011 16.7616 12.5925C15.9916 11.1739 15.6082 9.57774 15.6502 7.9642C15.6921 6.35066 16.1578 4.77655 17.0005 3.39992Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
            </svg>
            <span class="leader leader-morning"></span>
            <span class="leader leader-evening"></span>
            <svg class="pin pin-morning" viewBox="0 0 30 30" focusable="false">
              <circle class="pin-ring" cx="15" cy="15" r="14" stroke-width="2"/>
              <circle class="pin-dot" cx="15" cy="15" r="7"/>
            </svg>
            <svg class="pin pin-evening" viewBox="0 0 30 30" focusable="false">
              <circle class="pin-ring" cx="15" cy="15" r="14" stroke-width="2"/>
              <circle class="pin-dot" cx="15" cy="15" r="7"/>
            </svg>
            <span class="shift-label shift-awake">Awake</span>
            <span class="shift-label shift-asleep">Asleep</span>
            <span class="time-label time-label-morning">06:40</span>
            <span class="time-label time-label-evening">22:00</span>
          </div>

          <div class="orbit" aria-hidden="true"></div>

          <div
            class="knob"
            id="clock-knob-{{ section.id }}"
            tabindex="0"
            role="slider"
            aria-label="{{ 'kc.clock.aria_label' | t }}"
            aria-describedby="clock-help-{{ section.id }}"
            aria-valuemin="0"
            aria-valuemax="1439"
            aria-valuenow="0"
            aria-valuetext="{{ 'kc.clock.loading' | t }}"
          >
            {%- comment -%} Figma "now-dot" icon, cropped to the 40px dot {%- endcomment -%}
            <svg viewBox="4 4 40 40" width="40" height="40" fill="none" aria-hidden="true" focusable="false">
              <path d="M22.9584 16.6392C19.7481 14.7222 16.662 14.2932 15.1283 15.8269C12.9591 17.9961 14.7174 23.2727 19.0567 27.612C23.396 31.9512 28.6726 33.7096 30.8418 31.5403C31.1105 31.2716 31.3195 30.9542 31.4704 30.5975M26.8358 22.5152L31.2937 20.98L32.8289 25.438M31.2897 20.9887C30.5676 23.1014 29.0552 25.4702 26.9135 27.612C22.5742 31.9512 17.2976 33.7096 15.1283 31.5403C12.9591 29.3711 14.7174 24.0945 19.0567 19.7552C22.8578 15.9541 27.3778 14.1337 29.899 15.1983" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="callouts">
        <section class="callout callout-morning" aria-labelledby="morning-heading-{{ section.id }}">
          {%- if section.settings.morning_badge != blank -%}
            <p class="callout-badge">{{ section.settings.morning_badge | escape }}</p>
          {%- endif -%}
          {%- if section.settings.morning_title != blank -%}
            <h3 id="morning-heading-{{ section.id }}" class="callout-title h4">{{ section.settings.morning_title | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.morning_text != blank -%}
            <p class="callout-text">{{ section.settings.morning_text | escape }}</p>
          {%- endif -%}
        </section>

        <section class="callout callout-evening" aria-labelledby="evening-heading-{{ section.id }}">
          {%- if section.settings.night_badge != blank -%}
            <p class="callout-badge">{{ section.settings.night_badge | escape }}</p>
          {%- endif -%}
          {%- if section.settings.night_title != blank -%}
            <h3 id="evening-heading-{{ section.id }}" class="callout-title h4">{{ section.settings.night_title | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.night_text != blank -%}
            <p class="callout-text">{{ section.settings.night_text | escape }}</p>
          {%- endif -%}
        </section>
      </div>
    </div>

    {%- comment -%} The script's copy, from the locale keys: captions, aria-valuetext tails, the seven hour windows {%- endcomment -%}
    <div
      class="readout"
      data-mode="live"
      data-caption-live="{{ 'kc.clock.caption_live' | t }}"
      data-caption-preview="{{ 'kc.clock.caption_preview' | t }}"
      data-valuetext-live="{{ 'kc.clock.valuetext_live' | t }}"
      data-valuetext-preview="{{ 'kc.clock.valuetext_preview' | t }}"
      data-window-1="{{ 'kc.clock.window_1' | t }}"
      data-window-2="{{ 'kc.clock.window_2' | t }}"
      data-window-3="{{ 'kc.clock.window_3' | t }}"
      data-window-4="{{ 'kc.clock.window_4' | t }}"
      data-window-5="{{ 'kc.clock.window_5' | t }}"
      data-window-6="{{ 'kc.clock.window_6' | t }}"
      data-window-7="{{ 'kc.clock.window_7' | t }}"
    >
      <button type="button" class="hint" aria-controls="clock-knob-{{ section.id }}">
        {%- comment -%} Figma "interaction hint · drag the ring" icon {%- endcomment -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
          <path d="M10.9773 5C10.4287 2.82467 9.30133 1.33333 8 1.33333C6.15933 1.33333 4.66667 4.318 4.66667 8C4.66667 11.682 6.15933 14.6667 8 14.6667C8.228 14.6667 8.45133 14.6207 8.66667 14.5333M10.1294 9.13802L12.6721 10.378L11.4321 12.9207M12.6667 10.38C11.464 10.97 9.81733 11.3333 8 11.3333C4.318 11.3333 1.33333 9.84067 1.33333 8C1.33333 6.15933 4.318 4.66667 8 4.66667C11.2253 4.66667 13.9153 5.812 14.5333 7.33333" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ section.settings.hint_label | escape }}</span>
      </button>
      <p class="time-line">
        <time id="clock-time-{{ section.id }}" class="clock-time">--:--</time> ·
        <span id="clock-caption-{{ section.id }}" class="clock-caption">{{ 'kc.clock.caption_live' | t }}</span>
      </p>
      <p class="state-copy clock-copy" id="clock-copy-{{ section.id }}"></p>
      {%- comment -%} How the knob works, for screen readers only (the knob's aria-describedby) {%- endcomment -%}
      <p class="visually-hidden" id="clock-help-{{ section.id }}">{{ 'kc.clock.help' | t }}</p>
    </div>

    {%- if section.settings.footer_text != blank or section.settings.footer_link_text != blank -%}
      <div class="chronobiology-clock__footer">
        {%- if section.settings.footer_text != blank -%}
          <span class="footer-text">{{ section.settings.footer_text | escape }} </span>
        {%- endif -%}
        {%- if section.settings.footer_link_text != blank -%}
          <a
            class="science"
            href="{{ section.settings.footer_link | default: 'https://karmicare.com/en/why-karmicare' }}"
            target="_blank"
            rel="noopener"
          >
            {{- section.settings.footer_link_text | escape -}}
            {%- comment -%} KC/Icon/arrow-right {%- endcomment -%}
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <path d="M3.33333 8H12.6667M8 12.6667L12.6667 8L8 3.33333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Circadian 24h Clock",
  "tag": "section",
  "class": "section-chronobiology-clock",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subheading",
      "default": "CHRONOBIOLOGY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Your mouth runs on a 24-hour clock."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2 (Recommended)" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "One paragraph per line on desktop; the lines run on as one paragraph on mobile."
    },
    {
      "type": "header",
      "content": "Morning Shift (Left Callout)"
    },
    {
      "type": "text",
      "id": "morning_badge",
      "label": "Morning Time Badge",
      "default": "≈ 06:40 · Neisseria peaks"
    },
    {
      "type": "text",
      "id": "morning_title",
      "label": "Morning Title",
      "default": "Your mouth wakes up"
    },
    {
      "type": "textarea",
      "id": "morning_text",
      "label": "Morning Description",
      "default": "Cortisol rises; coffee, breakfast and the day's first acids follow. Enamel needs its shield on first."
    },
    {
      "type": "header",
      "content": "Night Shift (Right Callout)"
    },
    {
      "type": "text",
      "id": "night_badge",
      "label": "Night Time Badge",
      "default": "≈ 22:00 · Fusobacterium peaks"
    },
    {
      "type": "text",
      "id": "night_title",
      "label": "Night Title",
      "default": "Your mouth switches to repair"
    },
    {
      "type": "textarea",
      "id": "night_text",
      "label": "Night Description",
      "default": "Melatonin rises and saliva slows to a trickle. What's on your enamel at 22:00 is still there at 07:00."
    },
    {
      "type": "text",
      "id": "hint_label",
      "label": "Explore Button Label",
      "info": "Shown under the dial at every width.",
      "default": "DRAG THE DOT · EXPLORE 24 HOURS"
    },
    {
      "type": "select",
      "id": "time_label_size",
      "label": "Current time label size",
      "options": [
        { "value": "large", "label": "Label Large" },
        { "value": "small", "label": "Label Small" }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Footer Link / CTA"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Note",
      "default": "Formulated for both shifts: Awake by day, Asleep by night."
    },
    {
      "type": "text",
      "id": "footer_link_text",
      "label": "Link Label",
      "default": "Read the science"
    },
    {
      "type": "url",
      "id": "footer_link",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Section surface",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "accent", "label": "Accent" },
        { "value": "transition", "label": "Transition" }
      ],
      "default": "transition",
      "info": "Page and Accent hold their colour. Transition fades from the colour of the section above to the other one. A hold that follows the other colour is shown as a transition and flagged here."
    },
    {
      "type": "header",
      "content": "Day Mode Colors (optional overrides)"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)",
      "info": "Leave blank to use the KC tokens."
    },
    {
      "type": "header",
      "content": "Night Mode Colors (optional overrides)"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)",
      "info": "Leave blank to use the KC tokens."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Circadian 24h Clock"
    }
  ]
}
{% endschema %}
