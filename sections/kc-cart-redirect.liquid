{%- comment -%}
  /cart (Victor, 16 Oct): there is no theme cart, customers see the product page and the Shopify
  checkout. Shopify's URL redirects cannot redirect /cart, so this template does: a cart with lines goes
  to checkout (with the "Welcome Kit" code when it holds kit lines, as assets/karmi-add-to-cart.js), an
  empty cart to the main product page. The checkout's bag icon links here. layout/kc-redirect.liquid
  holds nothing else, so nothing paints first. Without JS: a plain link.
{%- endcomment -%}
{%- liquid
  if cart.item_count > 0
    assign kc_target = '/checkout'
    for kc_item in cart.items
      if kc_item.properties['_welcome_kit'] == 'true'
        assign kc_target = '/checkout?discount=Welcome%20Kit'
        break
      endif
    endfor
    assign kc_label = 'sections.cart.checkout' | t
  else
    assign kc_target = all_products['karmicare-biorhythmic-oral-care-system'].url | default: routes.root_url
    assign kc_label = 'general.continue_shopping' | t
  endif
-%}
<script>
  window.location.replace({{ kc_target | json }});
</script>
<noscript>
  <p><a href="{{ kc_target | escape }}">{{ kc_label }}</a></p>
</noscript>

{% schema %}
{
  "name": "Cart redirect",
  "settings": []
}
{% endschema %}
