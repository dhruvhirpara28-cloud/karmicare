<style>
      {%- if section.settings.bg_gradient_day != blank -%}
          body:not(.night-mode) .section-{{ section.id }},
          body.day-mode .section-{{ section.id }} {
            background: {{ section.settings.bg_gradient_day }};
        }
    {%- elsif section.settings.bg_color_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
            background-color: {{ section.settings.bg_color_day }};
        }
    {%- endif -%}

      {%- if section.settings.bg_gradient_night != blank -%}
      body.night-mode .section-{{ section.id }} {
          background: {{ section.settings.bg_gradient_night }};
      }
      {%- elsif section.settings.bg_color_night != blank -%}
      body.night-mode .section-{{ section.id }} {
          background-color: {{ section.settings.bg_color_night }};
      }
      {%- endif -%}

  {% if section.settings.border_color_night != blank %}
      body.night-mode #LegalToc-{{ section.id }} .legal-toc__section + .legal-toc__section,
      body.night-mode #LegalToc-{{ section.id }} .legal-toc__blockbody p,
      body.night-mode #LegalToc-{{ section.id }} .legal-toc__nav-link {
        border-color: {{ section.settings.border_color_night }};
      }
    {%- endif -%}
    
    {% if section.settings.border_color_day != blank %}
      body.day-mode #LegalToc-{{ section.id }} .legal-toc__section + .legal-toc__section,
      body.day-mode #LegalToc-{{ section.id }} .legal-toc__blockbody p,
      body:not(.night-mode) #LegalToc-{{ section.id }} .legal-toc__blockbody p,
      body:not(.night-mode) #LegalToc-{{ section.id }} .legal-toc__section + .legal-toc__section,
      body.day-mode #LegalToc-{{ section.id }} .legal-toc__nav-link,
      body:not(.night-mode) #LegalToc-{{ section.id }} .legal-toc__nav-link {
        border-color: {{ section.settings.border_color_day }};
      }
    {%- endif -%}

    /* DAY MODE */
    {% if section.settings.text_color_day != blank %}
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody p,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody ul,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody ul li,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody ol li,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody ol,
          body.day-mode .section-{{ section.id }} .legal-toc__blockbody ol,
          body.day-mode .section-{{ section.id }} .legal-toc__blockbody ol li,
          body.day-mode .section-{{ section.id }} .legal-toc__blockbody ul li,
          body.day-mode .section-{{ section.id }} .legal-toc__blockbody ul,
          body.day-mode .section-{{ section.id }} .legal-toc__blockbody p,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__body p,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__body ul,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__body ul li,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__body ol li,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__body ol,
          body.day-mode .section-{{ section.id }} .legal-toc__body ol,
          body.day-mode .section-{{ section.id }} .legal-toc__body ol li,
          body.day-mode .section-{{ section.id }} .legal-toc__body ul li,
          body.day-mode .section-{{ section.id }} .legal-toc__body ul,
          body.day-mode .section-{{ section.id }} .legal-toc__body p{
            color: rgb(from {{ section.settings.text_color_day }} r g b / 68%);
          }
          body:not(.night-mode) #LegalToc-{{ section.id }} .legal-toc__nav-link.is-active,
          body.day-mode #LegalToc-{{ section.id }} .legal-toc__nav-link.is-active{
            border-color:  {{ section.settings.text_color_day }};
          }
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody p a,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody li a,
          body.day-mode .section-{{ section.id }} .legal-toc__blockbody li a,
          body.day-mode .section-{{ section.id }} .legal-toc__blockbody p a,
        body:not(.night-mode) .section-{{ section.id }} .legal-toc__blockbody strong,
        body.day-mode .section-{{ section.id }} .legal-toc__blockbody strong,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__body p a,
          body:not(.night-mode) .section-{{ section.id }} .legal-toc__body li a,
          body.day-mode .section-{{ section.id }} .legal-toc__body li a,
          body.day-mode .section-{{ section.id }} .legal-toc__body p a,
        body:not(.night-mode) .section-{{ section.id }} .legal-toc__body strong,
        body.day-mode .section-{{ section.id }} .legal-toc__body strong{
          color:  {{ section.settings.text_color_day }};
        }
        body:not(.night-mode) .section-{{ section.id }} *,
        body.day-mode .section-{{ section.id }} * {
          color: {{ section.settings.text_color_day }};
        }
      {% endif %}


      /* NIGHT MODE */
      {% if section.settings.text_color_night != blank %}
        body.night-mode .section-{{ section.id }} .legal-toc__body ul,
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody ul,
        body.night-mode .section-{{ section.id }} .legal-toc__body ul li,
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody ul li,
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody ol li,
        body.night-mode .section-{{ section.id }} .legal-toc__body ol li,
        body.night-mode .section-{{ section.id }} .legal-toc__body ol,
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody ol,
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody p,
        body.night-mode .section-{{ section.id }} .legal-toc__body p{
          color: rgb(from {{ section.settings.text_color_night }} r g b / 68%);
      }
        body.night-mode .section-{{ section.id }} .legal-toc__body p a,
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody p a,
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody li a,
        body.night-mode .section-{{ section.id }} .legal-toc__body li a {
          color: {{ section.settings.text_color_night }};
        }
        body.night-mode .section-{{ section.id }} .legal-toc__blockbody strong,
        body.night-mode .section-{{ section.id }} .legal-toc__body strong {
          color: {{ section.settings.text_color_night }};
        }
         body.night-mode #LegalToc-{{ section.id }} .legal-toc__nav-link.is-active{
          border-color:  {{ section.settings.text_color_night }};
        }
        body.night-mode .section-{{ section.id }} * {
          color: {{ section.settings.text_color_night }};
        }
      {% endif %}

      #LegalToc-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        }

      @media only screen and (max-width: 767px) {
        #LegalToc-{{ section.id }} {
            padding-top: {{ section.settings.padding_top_mobile }}px;
            padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        }
  }
</style>

<section
  id="LegalToc-{{ section.id }}"
  class="legal-toc section-{{ section.id }}"
  data-legal-toc
>
  <div class="legal-toc__container">
    {% if section.blocks.size > 0 %}
      <div class="legal-toc__layout">
        {%- comment -%} LEFT NAVIGATION {%- endcomment -%}
        <aside class="legal-toc__sidebar" data-legal-toc-sidebar>
          <div class="legal-toc__sidebar-inner">
            {% if section.settings.nav_title != blank %}
              <div class="legal-toc__eyebrow">
                {{ section.settings.nav_title | escape }}
              </div>
            {% endif %}

            <nav
              class="legal-toc__nav"
              aria-label="{{ section.settings.nav_title | default: 'On this page' | escape }}"
            >
              <ul class="legal-toc__nav-list" role="list">
                {% for block in section.blocks %}
                  {% assign target_id = 'LegalToc-' | append: section.id | append: '-section-' | append: block.id %}

                  <li class="legal-toc__nav-item" {{ block.shopify_attributes }}>
                    <a
                      href="#{{ target_id }}"
                      class="legal-toc__nav-link{% if forloop.first %} is-active{% endif %}"
                      data-legal-toc-link
                      data-target="{{ target_id }}"
                    >
                      {{ block.settings.nav_label | default: block.settings.title | escape }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          </div>
        </aside>

        {%- comment -%} CONTENT {%- endcomment -%}
        <main class="legal-toc__content">
          {% for block in section.blocks %}
            {% assign target_id = 'LegalToc-' | append: section.id | append: '-section-' | append: block.id %}

            <article
              id="{{ target_id }}"
              class="legal-toc__section"
              data-legal-toc-section
              data-target="{{ target_id }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.title != blank %}
                <h5 class="legal-toc__title">
                  {{ block.settings.title | escape }}
                </h5>
              {% endif %}

              {% if block.settings.lead != blank %}
                <div class="legal-toc__lead rte">
                  {{ block.settings.lead }}
                </div>
              {% endif %}

              {% if block.settings.content != blank %}
                <div class="legal-toc__body rte">
                  {{ block.settings.content }}
                </div>
              {% endif %}

              {% if block.settings.block_content != blank %}
                <div class="legal-toc__blockbody rte">
                  {{ block.settings.block_content }}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </main>
      </div>
    {% else %}
      <div class="legal-toc__empty">Add a content section from the Theme Editor.</div>
    {% endif %}
  </div>
</section>

<style>
