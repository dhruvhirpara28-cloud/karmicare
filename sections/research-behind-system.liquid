    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CLINICALLY BACKED ORAL CARE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The research behind the system"
    },
    {
      "type": "header",
      "content": "Footer Content"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Bottom Text",
      "default": "<p>Built for people who read the label, check the research and want their daily care to hold up...</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE THE FULL EVIDENCE BASE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "card_bg_color_day",
      "label": "Card Background Color (Day)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "color",
      "id": "card_bg_color_night",
      "label": "Card Background Color (Night)",
      "default": "#191f38"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
