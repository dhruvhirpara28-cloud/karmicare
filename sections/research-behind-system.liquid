{{ 'section-research-behind-system.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- comment -%} Figma mobile 2766:10305: a hairline above the heading on mobile only {%- endcomment -%}
{%- if section.settings.show_border_top or section.settings.show_border_top_mobile -%}
  <div class="block__border-top research-behind-system__border{% unless section.settings.show_border_top %} research-behind-system__border--mobile{% endunless %} border-{{ section.id }}">
    <div class="page-width">
      <div class="kc-section-border"></div>
    </div>
  </div>
{%- endif -%}

<div class="research-behind-system section-{{ section.id }} kc-surface" data-kc-surface="{{ section.settings.surface }}">
  {%- style -%}
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_desktop }}px;
        padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      }
    }

    /* Day Mode Colors */
    {%- if section.settings.text_color_day != blank -%}
      body:not(.night-mode) .section-{{ section.id }},
      body.day-mode .section-{{ section.id }} {
        color: {{ section.settings.text_color_day }};
      }
    {%- endif -%}

    /* Night Mode Colors */
    {%- if section.settings.text_color_night != blank -%}
      body.night-mode .section-{{ section.id }} {
        color: {{ section.settings.text_color_night }};
      }
    {%- endif -%}

    /* Card Background Colors */
    {%- if section.settings.card_bg_color_day != blank -%}
      body:not(.night-mode) .section-{{ section.id }} .research-card {
        --card-bg: {{ section.settings.card_bg_color_day }};
      }
    {%- endif -%}

    {%- if section.settings.card_bg_color_night != blank -%}
      body.night-mode .section-{{ section.id }} .research-card {
        --card-bg: {{ section.settings.card_bg_color_night }};
      }
    {%- endif -%}
  {%- endstyle -%}

  <div class="page-width">
    <div class="research-behind-system__header">
      {%- if section.settings.subheading != blank -%}
        <span class="kc-caption-subheading subtitle-item">{{ section.settings.subheading }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="research-behind-system__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- liquid
      # The slider classes only apply to the grid; the marquee ignores them
      assign show_slider = false
      if section.settings.slider_mobile or section.settings.slider_tablet or section.settings.slider_laptop or section.settings.slider_desktop
        assign show_slider = true
      endif
      assign item_class = ''
      if show_slider and section.settings.marquee == false
        assign item_class = ' slider__slide'
      endif
    -%}

    {%- comment -%}
      The cards, once, for the marquee or the grid. With the Research cards
      setting filled they are the research_card metaobject entries (one copy
      shared by every page); without it, the section's own blocks, as before.
      An image makes the card the wide variant (research-card--media).
    {%- endcomment -%}
    {%- capture card_items -%}
      {%- if section.settings.cards != blank -%}
        {%- for card in section.settings.cards -%}
          <li class="research-card{% if card.image.value != blank %} research-card--media{% endif %}{{ item_class }}">
            {%- render 'research-card', card: card -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <li class="research-card{% if block.settings.image != blank %} research-card--media{% endif %}{{ item_class }}" {{ block.shopify_attributes }}>
            {%- render 'research-card', block: block -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.marquee -%}
      <kc-marquee
        class="research-behind-system__marquee"
        data-speed="{{ section.settings.marquee_speed }}"
        data-align-start
      >
        <ul class="research-behind-system__track" id="Slider-{{ section.id }}" role="list" data-marquee-track>
          {{- card_items -}}
        </ul>
      </kc-marquee>
      <script src="{{ 'kc-marquee.js' | asset_url }}" defer="defer"></script>
    {%- else -%}

    {%- capture slider_classes -%}
      {% if section.settings.slider_mobile %} slider--mobile{% endif %}
      {% if section.settings.slider_tablet %} slider--tablet{% endif %}
      {% if section.settings.slider_laptop %} slider--desktop{% endif %}
      {% if section.settings.slider_desktop %} slider--desktop{% endif %}
    {%- endcapture -%}

    {%- if show_slider -%}
      <slider-component>
    {%- endif -%}

    <ul
      class="research-behind-system__grid{% if show_slider %} slider{{ slider_classes }}{% endif %}"
      id="Slider-{{ section.id }}"
      role="list"
      style="
        --cols-desktop: {{ section.settings.columns_desktop }};
        --cols-laptop: {{ section.settings.columns_laptop }};
        --cols-tablet: {{ section.settings.columns_tablet }};
        --cols-mobile: {{ section.settings.columns_mobile }};
        --cols-desktop-int: {{ section.settings.columns_desktop | round }};
        --cols-laptop-int: {{ section.settings.columns_laptop | round }};
        --cols-tablet-int: {{ section.settings.columns_tablet | round }};
        --cols-mobile-int: {{ section.settings.columns_mobile | round }};
      "
    >
      {{- card_items -}}
    </ul>

    {%- if show_slider -%}
      </slider-component>
    {%- endif -%}
    {%- endif -%}

    {%- if section.settings.bottom_text != blank or section.settings.button_label != blank -%}
      <div class="research-behind-system__footer">
        {%- if section.settings.bottom_text != blank -%}
          <div class="research-behind-system__note">{{ section.settings.bottom_text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- comment -%} KC/Button, secondary, medium (Figma 3391:12659) {%- endcomment -%}
          {%- capture cta_icon -%}{{- 'kc-icon-arrow-right.svg' | inline_asset_content -}}{%- endcapture -%}
          {%- if section.settings.button_link == blank or section.settings.button_link == '#' -%}
            {%- comment -%} No page yet: the shared "Coming soon" state (Victor's rule H8) {%- endcomment -%}
            {{ 'kc-coming-soon.css' | asset_url | stylesheet_tag }}
            <script src="{{ 'kc-coming-soon.js' | asset_url }}" defer="defer"></script>
            {%- assign cta_id = 'ResearchCta-' | append: section.id -%}
            {%- render 'kc-coming-soon',
              id: cta_id,
              label: section.settings.button_label,
              class: 'research-behind-system__button',
              icon: cta_icon
            -%}
          {%- else -%}
            <a href="{{ section.settings.button_link }}" class="research-behind-system__button">
              <span>{{ section.settings.button_label }}</span>
              {{- cta_icon -}}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_border_bottom != blank -%}
  <div class="block__border-bottom border-{{ section.id }}">
    <div class="page-width">
      <div class="kc-section-border"></div>
    </div>
  </div>
{%- endif -%}

{%- if show_slider and section.settings.marquee == false -%}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sliders = document.querySelectorAll('.research-behind-system__grid.slider:not([data-initialized="true"])');
      sliders.forEach((slider) => {
        slider.setAttribute('data-initialized', 'true');
        let isDown = false;
        let startX;
        let scrollLeft;

        slider.style.cursor = 'grab';

        slider.addEventListener('mousedown', (e) => {
          if (slider.scrollWidth <= slider.clientWidth) return;
          isDown = true;
          slider.style.cursor = 'grabbing';
          startX = e.pageX - slider.offsetLeft;
          scrollLeft = slider.scrollLeft;
        });
        slider.addEventListener('mouseleave', () => {
          isDown = false;
          slider.style.cursor = 'grab';
        });
        slider.addEventListener('mouseup', () => {
          isDown = false;
          slider.style.cursor = 'grab';
        });
        slider.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - slider.offsetLeft;
          const walk = (x - startX) * 2;
          slider.scrollLeft = scrollLeft - walk;
        });
      });
    });
  </script>
{%- endif -%}

