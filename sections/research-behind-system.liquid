          "type": "header",
          "content": "Details (Result & Method)"
        },
        {
          "type": "text",
          "id": "result_label",
          "label": "Result Label",
          "default": "RESULT"
        },
        {
          "type": "inline_richtext",
          "id": "result_text",
          "label": "Result Text",
          "default": "98% occlusion vs 82% and 65% for two other desensitising technologies"
        },
        {
          "type": "text",
          "id": "method_label",
          "label": "Method Label",
          "default": "METHOD"
        },
        {
          "type": "inline_richtext",
          "id": "method_text",
          "label": "Method Text",
          "default": "In vitro SEM comparison of three pastes, ~1% nHAp."
        },
        {
          "type": "header",
          "content": "Footer Link & Logo"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Kulai Et Al. - 2016"
