        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Nano-HAp sealed 98% of open dentine tubules."
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Human dentine discs - 7 days"
        },
