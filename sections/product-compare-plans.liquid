{%- liquid
  assign compare_table = product.metafields.custom.compare_table.value
  assign kc = false
  if section.settings.design == 'kc'
    assign kc = true
  endif
-%}
{% style %}
  #compare-plans-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #compare-plans-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{% endstyle %}
{%- if compare_table != blank and compare_table.enable.value != false -%}
  {{ 'product-compare-plans.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign plans = compare_table.compare_plans.value
    assign rows = compare_table.compare_rows.value

    assign eyebrow = section.settings.eyebrow
    assign title = section.settings.title
    assign subtitle = section.settings.subtitle
    assign footer_text = section.settings.footer_text
  -%}

  {%- comment -%} KC design (Figma 3391:12660): the info icon is Figma's 16px "Interface" glyph {%- endcomment -%}
  {%- capture kc_info_icon -%}
    <svg class="pc-info-icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 10.6667V8M8 5.33333H8.00667M14.6667 8C14.6667 11.6819 11.6819 14.6667 8 14.6667C4.3181 14.6667 1.33333 11.6819 1.33333 8C1.33333 4.3181 4.3181 1.33333 8 1.33333C11.6819 1.33333 14.6667 4.3181 14.6667 8Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- endcapture -%}

  <div
    aria-label="Compare plans"
    class="plan-compare{% if kc %} plan-compare--kc{% endif %} kc-surface"
    id="compare-plans-{{ section.id }}"
    data-kc-surface="{{ section.settings.surface }}"
  >
    <div class="page-width">
      <div class="pc-head">
        <span class="subtitle-item">{{ eyebrow }}</span>
        <h2 class="pc-title">{{ title }}</h2>
        <div class="pc-sub text-xl">{{ subtitle }}</div>
      </div>

      <div class="pc-table">
        <!-- LABEL COLUMN -->
        <div class="pc-col pc-col-label">
          <div class="pc-lhead">
            <span class="pc-lhead-tag">Compare</span>
          </div>
          {%- for row in rows -%}
            {%- if row.show_row.value == false -%}{%- continue -%}{%- endif -%}
            <div class="pc-lcell">
              {%- liquid
                assign row_type = row.row_type.value | default: row.row_type | downcase
                assign row_key = row.row_key.value | default: row.row_key | downcase
                assign row_handle = row.system.handle | default: row.handle | downcase
                assign row_label = row.label.value | default: row.label | downcase
                assign is_welcome_kit = false
                if row_type == 'welcome_kit' or row_key == 'welcome_kit' or row_handle == 'welcome-kit' or row_handle == 'welcome_kit' or row_label contains 'welcome kit'
                  assign is_welcome_kit = true
                endif
              -%}
              {%- if is_welcome_kit -%}
                <span class="pc-kit">
                  <span>{{ row.label.value | default: row.label }}</span>
                  {%- if row.welcome_kit.value != blank -%}
                    <span aria-hidden="true" class="pc-kit-thumbs">
                      {%- for prod in row.welcome_kit.value -%}
                        <img
                          alt="{{ prod.title | escape }}"
                          decoding="async"
                          height="22"
                          src="{{ prod.featured_image | image_url: width: 44 }}"
                          width="22"
                        >
                      {%- endfor -%}
                    </span>
                    <span class="pc-kit-pop" role="tooltip">
                      {%- assign total_value = 0 -%}
                      {%- for prod in row.welcome_kit.value -%}
                        {%- if prod.compare_at_price > 0 -%}
                          {%- assign total_value = total_value | plus: prod.compare_at_price -%}
                        {%- else -%}
                          {%- assign total_value = total_value | plus: prod.price -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <span class="pc-kit-poptitle">
                        {{- row.label.value | default: row.label -}}
                        <span class="value">
                          {%- if total_value > 0 -%}
                            · {{ total_value | money_without_trailing_zeros }} Value
                          {%- endif -%}
                          · <b>Free</b>
                        </span>
                      </span>
                      {%- for prod in row.welcome_kit.value -%}
                        <span class="pc-kit-item">
                          <img
                            alt="{{ prod.title | escape }}"
                            decoding="async"
                            height="34"
                            src="{{ prod.featured_image | image_url: width: 68 }}"
                            width="34"
                          >
                          <span class="pc-kit-itxt">
                            <b>{{ prod.title }}</b>
                            <em
                              >Free
                              {%- if prod.compare_at_price > prod.price %}
                                · <s>{{ prod.compare_at_price | money_without_trailing_zeros }}</s>
                              {%- elsif prod.price > 0 %}
                                · <s>{{ prod.price | money_without_trailing_zeros }}</s>
                              {%- endif -%}
                            </em>
                          </span>
                        </span>
                      {%- endfor -%}
                    </span>
                  {%- endif -%}
                </span>
              {%- else -%}
                {{ row.label.value | default: row.label }}
                {%- if row.tooltip.value != blank -%}
                  <span class="info-tip">
                    {%- if kc -%}
                      {{ kc_info_icon }}
                    {%- else -%}
                      <span aria-hidden="true" class="info-icon">i</span>
                    {%- endif -%}
                    <span class="info-tip-popover" role="tooltip">
                      {%- if row.tooltip.type == 'rich_text_field' -%}
                        {{ row.tooltip | metafield_tag }}
                      {%- else -%}
                        {{ row.tooltip.value | default: row.tooltip }}
                      {%- endif -%}
                    </span>
                  </span>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
          <div class="pc-lcta"></div>
        </div>

        <!-- PLAN COLUMNS -->
        {%- for plan in plans -%}
          {%- if plan.hide_plan.value == true -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign plan_handle = plan.handle_item.value | default: plan.handle_item
            assign plan_title = plan.title.value | default: plan.title

            # handle_item 'once', 'one-time' or 'one time' (any case) is the Try Once card: one time,
            # straight to checkout. Any other card selects its selling_plan_id in the buybox, by ID only;
            # a missing or wrong ID selects nothing (it never falls back to one time).
            # handle_item and selling_plan_id are keys and must not be translated. Should handle_item be
            # translated anyway, a card without a selling_plan_id whose own entry handle (never
            # translated, e.g. "try-onceonce") says once still counts as the Try Once card.
            # selling_plan_name is no longer read: plans are matched by ID, not by name.
            assign plan_raw_id = plan.selling_plan_id.value | default: plan.selling_plan_id | append: '' | strip
            assign plan_kind = plan_handle | downcase | replace: '-', ' ' | strip
            assign plan_entry_kind = plan.system.handle | downcase | replace: '-', ' '
            assign plan_is_once = false
            assign plan_once_by_entry = false
            if plan_kind == 'once' or plan_kind == 'one time'
              assign plan_is_once = true
            elsif plan_raw_id == blank
              if plan_entry_kind contains 'once' or plan_entry_kind contains 'one time'
                assign plan_is_once = true
                assign plan_once_by_entry = true
              endif
            endif

            assign plan_resolved = ''
            unless plan_is_once
              capture plan_resolved
                render 'kc-plan-resolve', product: product, plan_id: plan_raw_id
              endcapture
            endunless
            assign plan_selling_plan_id = plan_raw_id
            assign plan_group_id = ''
            assign plan_group_name = ''
            if plan_resolved != blank
              assign plan_resolved_parts = plan_resolved | split: '|'
              assign plan_selling_plan_id = plan_resolved_parts[0]
              assign plan_group_id = plan_resolved_parts[1]
              assign plan_group_prefix = plan_selling_plan_id | append: '|' | append: plan_group_id | append: '|'
              assign plan_group_name = plan_resolved | remove_first: plan_group_prefix
            endif
          -%}
          <div
            class="pc-col{% if plan.featured.value == true %} pc-featured{% endif %}"
            data-plan="{{ plan_handle | escape }}"
          >
            {%- if plan.ribbon_text.value != blank -%}
              <span class="pc-ribbon">{{ plan.ribbon_text.value }}</span>
            {%- endif -%}
            {%- if plan.top_badge.value != blank -%}
              <span class="pc-tag pc-tag-top">{{ plan.top_badge.value }}</span>
            {%- endif -%}

            <div class="pc-hcell">
              <span class="pc-name text-xl">{{ plan.title.value | default: plan.title }}</span>
              <span class="pc-price h4">{{ plan.price_override.value | default: plan.price_override }}</span>
              <span class="pc-cycle opacity-xl">{{ plan.cycle_text.value | default: plan.cycle_text }}</span>
            </div>

            {%- for row in rows -%}
              {%- if row.show_row.value == false -%}{%- continue -%}{%- endif -%}

              {%- comment -%} Find matching Compare Value cell {%- endcomment -%}
              {%- assign cell_value = null -%}
              {%- for val in shop.metaobjects.compare_value.values -%}
                {%- assign val_plan = val.compare_plan.value -%}
                {%- assign val_row = val.compare_row.value -%}
                {%- assign val_plan_id = val_plan.system.id | default: val_plan.id -%}
                {%- assign plan_id = plan.system.id | default: plan.id -%}
                {%- assign val_row_id = val_row.system.id | default: val_row.id -%}
                {%- assign row_id = row.system.id | default: row.id -%}
                {%- if val_plan_id == plan_id and val_row_id == row_id -%}
                  {%- assign cell_value = val -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              <div class="pc-cell" data-label="{{ row.label.value | default: row.label | escape }}">
                {%- if cell_value == blank or cell_value.hide_cell.value == true -%}
                  <span aria-label="Not included" class="pc-no" role="img">—</span>
                {%- else -%}
                  {%- assign display_type = cell_value.display_type.value
                    | default: cell_value.display_type
                    | downcase
                  -%}
                  {%- if display_type == 'checkmark' or display_type == 'yes' or display_type == 'true' -%}
                    <span aria-label="Included" class="pc-yes" role="img">✓</span>
                  {%- elsif display_type == 'dash' or display_type == 'no' or display_type == 'false' -%}
                    <span aria-label="Not included" class="pc-no" role="img">—</span>
                  {%- else -%}
                    {%- if cell_value.value.type == 'rich_text_field' -%}
                      {{ cell_value.value | metafield_tag }}
                    {%- else -%}
                      {{ cell_value.value }}
                    {%- endif -%}
                    {%- if cell_value.tooltip != blank -%}
                      <span class="info-tip pc-tip-end">
                        {%- if kc -%}
                          {{ kc_info_icon }}
                        {%- else -%}
                          <span aria-hidden="true" class="info-icon">i</span>
                        {%- endif -%}
                        <span class="info-tip-popover" role="tooltip">
                          {%- if cell_value.tooltip.type == 'rich_text_field' -%}
                            {{ cell_value.tooltip | metafield_tag }}
                          {%- else -%}
                            {{ cell_value.tooltip.value | default: cell_value.tooltip }}
                          {%- endif -%}
                        </span>
                      </span>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endfor -%}

            <div class="pc-ctacell center"{% if request.design_mode %} style="position: relative;"{% endif %}>
              <button
                {%- if kc %}
                  class="pc-cta{% if plan.featured.value == true %} pc-cta--primary{% else %} pc-cta--secondary{% endif %}"
                {%- else %}
                  class="pc-cta subtitle-item{% if plan.featured.value == true %} karmicare__btn-primary{% else %} karmicare__btn-secondary{% endif %}"
                {%- endif %}
                data-kc-plan-product="{{ product.id }}"
                data-kc-plan-title="{{ plan_title | escape }}"
                {%- if plan_is_once %}
                  data-kc-plan-choose="once"
                {%- else %}
                  data-kc-plan-choose="plan"
                  data-selling-plan-id="{{ plan_selling_plan_id | escape }}"
                  data-selling-plan-group-id="{{ plan_group_id }}"
                {%- endif %}
                type="button"
              >
                {{ plan.cta_button.value | default: plan.cta_button | default: 'Choose plan' }}
              </button>
              {%- if request.design_mode -%}
                {%- comment -%}
                  Theme editor only: what this button selects, hung below the button so the table keeps
                  its row heights
                {%- endcomment -%}
                <div style="position: absolute; top: 100%; left: 0; right: 0; z-index: 2; padding: 0 0.8rem; font-size: 1.2rem; line-height: 1.4;">
                  {%- if plan_is_once -%}
                    <p style="margin: 0;">
                      {%- if plan_once_by_entry %}
                        <span style="color: #b42318;">
                          handle_item "{{ plan_handle | escape }}" looks translated; read as once from the
                          entry handle "{{ plan.system.handle | escape }}"
                        </span>
                        <br>
                      {%- endif %}
                      handle_item "{{ plan_handle | escape }}" → one time, no selling plan, straight to checkout ✓
                      <br>handle_item and selling_plan_id are keys: never translate them in Translate &amp; Adapt
                      ("once" stays "once" in every language)
                    </p>
                  {%- elsif plan_group_id != blank -%}
                    {%- capture plan_loyalty_key -%}
                      {%- render 'kc-plan-loyalty', product: product, plan_id: plan_selling_plan_id -%}
                    {%- endcapture -%}
                    <p style="margin: 0;">
                      Plan-ID {{ plan_selling_plan_id }} → {{ plan_group_name | escape }} ✓
                      {%- if plan_loyalty_key != blank %}
                        <br>Subscription Name "{{ plan_loyalty_key | escape }}" (Care Credit) ✓
                      {%- else %}
                        <br><span style="color: #b42318;">no Subscription Name: orders on this plan earn no Care Credit</span>
                      {%- endif %}
                      <br>selling_plan_id and handle_item are keys: never translate them in Translate &amp; Adapt
                    </p>
                  {%- else -%}
                    {%- capture plan_public_ids -%}{%- render 'kc-plan-public', product: product -%}{%- endcapture -%}
                    <div
                      role="note"
                      style="padding: 0.6rem 0.8rem; border: 2px solid #b42318; border-radius: 8px; background: #fef3f2; color: #b42318; text-align: left;"
                    >
                      Plan-ID "{{ plan_raw_id | escape }}" is not a selling plan of this product: this button
                      selects nothing. Set selling_plan_id to one of:
                      {%- render 'kc-plan-editor-list', product: product, public_plans: plan_public_ids -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if footer_text != blank -%}
        <div class="pc-foot">{{ footer_text }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    The plan buttons (data-kc-plan-choose) select their selling plan in the buybox, or buy one time
    straight to checkout: assets/kc-plan-select.js, loaded in layout/theme.liquid.
  {%- endcomment -%}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Tooltip handling to ensure only one shows at a time on mobile
      const tooltips = document.querySelectorAll('.info-tip, .pc-kit');

      tooltips.forEach((tooltip) => {
        tooltip.addEventListener('click', function (e) {
          if (window.innerWidth <= 768) {
            const isActive = this.classList.contains('active-tip');

            tooltips.forEach((t) => t.classList.remove('active-tip'));

            if (!isActive) {
              this.classList.add('active-tip');
            }
          }
        });
      });

      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768) {
          if (!e.target.closest('.info-tip') && !e.target.closest('.pc-kit')) {
            tooltips.forEach((t) => t.classList.remove('active-tip'));
          }
        }
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product Compare Plans",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "kc",
          "label": "KC tokens (Figma 2026)"
        }
      ],
      "default": "classic",
      "info": "KC tokens: the product page table from Figma, Day and Night through the KC tokens. Classic keeps the earlier look."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Choose your rhythm"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title text override (Defaults to Metaobject Title)"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle text",
      "default": "<p>Start with one set, refill every 60 days, or choose the full year — the ritual stays the same: <b>Awake</b> in the morning, <b>Asleep</b> at night.</p>"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "default": "<p>Every subscription earns <b>Care Credit</b>: real euros toward more Karmicare products — a return on the care you keep.</p>"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Section surface",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "accent", "label": "Accent" },
        { "value": "transition", "label": "Transition" }
      ],
      "default": "transition",
      "info": "Page and Accent hold their colour. Transition fades from the colour of the section above to the other one. A hold that follows the other colour is shown as a transition and flagged here."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Product Compare Plans"
    }
  ]
}
{% endschema %}
