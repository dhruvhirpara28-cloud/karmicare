{%- liquid
  assign compare_table = product.metafields.custom.compare_table.value
  assign kc = false
  if section.settings.design == 'kc'
    assign kc = true
  endif
-%}
{% style %}
  #compare-plans-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #compare-plans-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{% endstyle %}
{%- if compare_table != blank and compare_table.enable.value != false -%}
  {{ 'product-compare-plans.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign plans = compare_table.compare_plans.value
    assign rows = compare_table.compare_rows.value

    assign eyebrow = section.settings.eyebrow
    assign title = section.settings.title
    assign subtitle = section.settings.subtitle
    assign footer_text = section.settings.footer_text
  -%}

  {%- capture kc_info_icon -%}
    <svg class="pc-info-icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 10.6667V8M8 5.33333H8.00667M14.6667 8C14.6667 11.6819 11.6819 14.6667 8 14.6667C4.3181 14.6667 1.33333 11.6819 1.33333 8C1.33333 4.3181 4.3181 1.33333 8 1.33333C11.6819 1.33333 14.6667 4.3181 14.6667 8Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- endcapture -%}

  <div
    aria-label="{{ 'kc.plans.compare_label' | t }}"
    class="plan-compare{% if kc %} plan-compare--kc{% endif %} kc-surface"
    id="compare-plans-{{ section.id }}"
    data-kc-surface="{{ section.settings.surface }}"
    data-kc-plan-feedback-scope
  >
    <div class="page-width">
      <div class="pc-head">
        <span class="subtitle-item">{{ eyebrow }}</span>
        <h2 class="pc-title">{{ title }}</h2>
        <div class="pc-sub text-xl">{{ subtitle }}</div>
      </div>

      <div class="pc-table">
        <div class="pc-col pc-col-label">
          <div class="pc-lhead">
            <span class="pc-lhead-tag">{{ 'kc.plans.compare' | t }}</span>
          </div>
          {%- for row in rows -%}
            {%- if row.show_row.value == false -%}{%- continue -%}{%- endif -%}
            <div class="pc-lcell">
              {%- liquid
                assign row_type = row.row_type.value | default: row.row_type | downcase
                assign row_key = row.row_key.value | default: row.row_key | downcase
                assign row_handle = row.system.handle | default: row.handle | downcase
                assign row_label = row.label.value | default: row.label | downcase
                assign is_welcome_kit = false
                if row_type == 'welcome_kit' or row_key == 'welcome_kit' or row_handle == 'welcome-kit' or row_handle == 'welcome_kit' or row_label contains 'welcome kit'
                  assign is_welcome_kit = true
                endif
              -%}
              {%- if is_welcome_kit -%}
                <span class="pc-kit">
                  <span>{{ row.label.value | default: row.label }}</span>
                  {%- if settings.welcome_kit_free_product != blank -%}
                    <span aria-hidden="true" class="pc-kit-thumbs">
                      {%- for prod_item in settings.welcome_kit_free_product -%}
                        {%- liquid
                          assign prod = prod_item
                          if prod_item.id == null
                            assign prod = all_products[prod_item]
                          endif
                          if prod == blank
                            continue
                          endif
                          # The close-up tile of the buybox kit (custom.kit_thumbnail, snippets/loop-widget-standard.liquid),
                          # falling back to the featured image (Victor, 23 Oct)
                          assign prod_thumb = prod.metafields.custom.kit_thumbnail.value | default: prod.featured_image
                        -%}
                        <img
                          alt="{{ prod.title | escape }}"
                          decoding="async"
                          height="22"
                          src="{{ prod_thumb | image_url: width: 66 }}"
                          width="22"
                        >
                      {%- endfor -%}
                    </span>
                    <span class="pc-kit-pop" role="tooltip">
                      {%- capture total_value -%}{%- render 'kc-kit-value' -%}{%- endcapture -%}
                      {%- assign total_value = total_value | plus: 0 -%}
                      <span class="pc-kit-poptitle">
                        {{- row.label.value | default: row.label -}}
                        <span class="value">
                          {%- if total_value > 0 -%}
                            {%- capture kit_total -%}{% render 'kc-money', cents: total_value, trim: true %}{%- endcapture -%}
                            {{ 'kc.plans.kit_value' | t: total_value: kit_total }}
                          {%- endif -%}
                          · <b>{{ 'kc.plans.free' | t }}</b>
                        </span>
                      </span>
                      {%- for prod_item in settings.welcome_kit_free_product -%}
                        {%- liquid
                          assign prod = prod_item
                          if prod_item.id == null
                            assign prod = all_products[prod_item]
                          endif
                          if prod == blank
                            continue
                          endif
                          capture prod_value
                            render 'kc-kit-value', kit_product: prod
                          endcapture
                          assign prod_value = prod_value | plus: 0
                        -%}
                        <span class="pc-kit-item">
                          <img
                            alt="{{ prod.title | escape }}"
                            decoding="async"
                            height="34"
                            src="{{ prod.featured_image | image_url: width: 68 }}"
                            width="34"
                          >
                          <span class="pc-kit-itxt">
                            <b>{{ prod.title }}</b>
                            <em>
                              {{- 'kc.plans.free' | t }}
                              {%- if prod_value > 0 %}
                                · <s>{% render 'kc-money', cents: prod_value, trim: true %}</s>
                              {%- endif -%}
                            </em>
                          </span>
                        </span>
                      {%- endfor -%}
                    </span>
                  {%- endif -%}
                </span>
              {%- else -%}
                {%- liquid
                  assign row_display_label = row.label.value | default: row.label
                  if row_display_label contains '€'
                    assign euro_parts = row_display_label | split: '€'
                    for ep in euro_parts
                      if forloop.first
                        continue
                      endif
                      assign ep_num = ep | strip | plus: 0
                      if ep_num > 0
                        assign ep_cents = ep_num | times: 100 | round
                        capture ep_money
                          echo '<span class="kc-currency-eur" data-kc-eur="' | append: ep_num | append: '">'
                          render 'kc-money', cents: ep_cents, trim: true, euro: true
                          echo '</span>'
                        endcapture
                        assign ep_target_sp = '€ ' | append: ep_num
                        assign ep_target_no = '€' | append: ep_num
                        assign row_display_label = row_display_label | replace: ep_target_sp, ep_money | replace: ep_target_no, ep_money
                      endif
                    endfor
                  endif
                -%}
                {{ row_display_label }}
                {%- if row.tooltip.value != blank -%}
                  <span class="info-tip">
                    {%- if kc -%}
                      {{ kc_info_icon }}
                    {%- else -%}
                      <span aria-hidden="true" class="info-icon">i</span>
                    {%- endif -%}
                    <span class="info-tip-popover" role="tooltip">
                      {%- liquid
                        if row.tooltip.type == 'rich_text_field'
                          assign row_tip_text = row.tooltip | metafield_tag
                        else
                          assign row_tip_text = row.tooltip.value | default: row.tooltip
                        endif
                        if row_tip_text contains '€'
                          assign euro_tip_parts = row_tip_text | split: '€'
                          for ep in euro_tip_parts
                            if forloop.first
                              continue
                            endif
                            assign ep_num = ep | strip | plus: 0
                            if ep_num > 0
                              assign ep_cents = ep_num | times: 100 | round
                              capture ep_money
                                echo '<span class="kc-currency-eur" data-kc-eur="' | append: ep_num | append: '">'
                                render 'kc-money', cents: ep_cents, trim: true, euro: true
                                echo '</span>'
                              endcapture
                              assign ep_target_sp = '€ ' | append: ep_num
                              assign ep_target_no = '€' | append: ep_num
                              assign row_tip_text = row_tip_text | replace: ep_target_sp, ep_money | replace: ep_target_no, ep_money
                            endif
                          endfor
                        endif
                      -%}
                      {{ row_tip_text }}
                    </span>
                  </span>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
          <div class="pc-lcta"></div>
        </div>

        {%- for plan in plans -%}
          {%- if plan.hide_plan.value == true -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign plan_handle = plan.handle_item.value | default: plan.handle_item
            assign plan_title = plan.title.value | default: plan.title
            assign plan_raw_id = plan.selling_plan_id.value | default: plan.selling_plan_id | append: '' | strip
            assign plan_kind = plan_handle | downcase | replace: '-', ' ' | strip
            assign plan_entry_kind = plan.system.handle | downcase | replace: '-', ' '
            assign plan_is_once = false
            if plan_kind == 'once' or plan_kind == 'one time'
              assign plan_is_once = true
            elsif plan_raw_id == blank
              if plan_entry_kind contains 'once' or plan_entry_kind contains 'one time'
                assign plan_is_once = true
              endif
            endif

            assign plan_resolved = ''
            unless plan_is_once
              capture plan_resolved
                render 'kc-plan-resolve', product: product, plan_id: plan_raw_id
              endcapture
            endunless
            assign plan_selling_plan_id = plan_raw_id
            assign plan_group_id = ''
            if plan_resolved != blank
              assign plan_resolved_parts = plan_resolved | split: '|'
              assign plan_selling_plan_id = plan_resolved_parts[0]
              assign plan_group_id = plan_resolved_parts[1]
            endif
          -%}
          <div
            class="pc-col{% if plan.featured.value == true %} pc-featured{% endif %}"
            data-plan="{{ plan_handle | escape }}"
          >
            {%- if plan.ribbon_text.value != blank -%}
              <span class="pc-ribbon">{{ plan.ribbon_text.value }}</span>
            {%- endif -%}
            {%- if plan.top_badge.value != blank -%}
              <span class="pc-tag pc-tag-top">{{ plan.top_badge.value }}</span>
            {%- endif -%}

            <div class="pc-hcell">
              <span class="pc-name text-xl" id="pc-name-{{ section.id }}-{{ forloop.index }}">
                {{- plan.title.value | default: plan.title -}}
              </span>
              {%- liquid
                assign pc_alloc_price = 0
                assign pc_units = 1
                assign pc_deliveries = 1
                assign pc_credit_pct = 0

                if plan_is_once
                  assign pc_alloc_price = product.selected_or_first_available_variant.price
                elsif plan_selling_plan_id != blank
                  for alloc in product.selected_or_first_available_variant.selling_plan_allocations
                    assign alloc_id = alloc.selling_plan.id | append: ''
                    if alloc_id == plan_selling_plan_id
                      assign pc_alloc_price = alloc.price
                      break
                    endif
                  endfor

                  capture pc_units
                    render 'kc-plan-type', plan_id: plan_selling_plan_id, field: 'units'
                  endcapture
                  assign pc_units = pc_units | default: 1 | plus: 0

                  capture pc_deliveries
                    render 'kc-plan-type', plan_id: plan_selling_plan_id, field: 'deliveries'
                  endcapture
                  assign pc_deliveries = pc_deliveries | default: 1 | plus: 0

                  capture pc_credit_pct
                    render 'kc-plan-type', plan_id: plan_selling_plan_id, field: 'care_credit_percent'
                  endcapture
                  assign pc_credit_pct = pc_credit_pct | default: 0 | plus: 0
                endif

                assign pc_header_cents = pc_alloc_price | times: pc_units

                assign pc_brushings = 120
                if pc_deliveries == 2
                  assign pc_brushings = pc_units | times: 2 | times: 120
                endif
                assign pc_per_brushing_cents = pc_header_cents | divided_by: 1.0 | divided_by: pc_brushings | round

                assign pc_annual_cents = pc_header_cents
                if pc_deliveries == 1 and pc_credit_pct > 0
                  assign pc_annual_cents = pc_header_cents | times: 6
                endif
                assign pc_care_credit_cents = pc_annual_cents | times: pc_credit_pct | divided_by: 100.0 | round

                capture pc_live_price
                  if pc_header_cents > 0
                    render 'kc-money', cents: pc_header_cents, trim: true
                  endif
                endcapture

                capture pc_brushing_price
                  if pc_per_brushing_cents > 0
                    render 'kc-money', cents: pc_per_brushing_cents
                  endif
                endcapture

                capture pc_care_credit_price
                  if pc_alloc_price > 0
                    render 'kc-money', cents: pc_care_credit_cents, trim: true
                  endif
                endcapture
              -%}
              <span class="pc-price h4">{{- pc_live_price -}}</span>
              <span class="pc-cycle opacity-xl">{{ plan.cycle_text.value | default: plan.cycle_text }}</span>
            </div>

            {%- for row in rows -%}
              {%- if row.show_row.value == false -%}{%- continue -%}{%- endif -%}

              {%- assign cell_value = null -%}
              {%- for val in shop.metaobjects.compare_value.values -%}
                {%- assign val_plan = val.compare_plan.value -%}
                {%- assign val_row = val.compare_row.value -%}
                {%- assign val_plan_id = val_plan.system.id | default: val_plan.id -%}
                {%- assign plan_id = plan.system.id | default: plan.id -%}
                {%- assign val_row_id = val_row.system.id | default: val_row.id -%}
                {%- assign row_id = row.system.id | default: row.id -%}
                {%- if val_plan_id == plan_id and val_row_id == row_id -%}
                  {%- assign cell_value = val -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              <div class="pc-cell" data-label="{{ row.label.value | default: row.label | escape }}">
                {%- if cell_value == blank or cell_value.hide_cell.value == true -%}
                  <span aria-label="{{ 'kc.plans.not_included' | t }}" class="pc-no" role="img">—</span>
                {%- else -%}
                  {%- assign display_type = cell_value.display_type.value
                    | default: cell_value.display_type
                    | downcase
                  -%}
                  {%- if display_type == 'checkmark' or display_type == 'yes' or display_type == 'true' -%}
                    <span aria-label="{{ 'kc.plans.included' | t }}" class="pc-yes" role="img">✓</span>
                  {%- elsif display_type == 'dash' or display_type == 'no' or display_type == 'false' -%}
                    <span aria-label="{{ 'kc.plans.not_included' | t }}" class="pc-no" role="img">—</span>
                  {%- else -%}
                    {%- liquid
                      assign r_key = row.system.handle | default: row.row_key.value | default: row.label.value | default: row.label | downcase
                      assign cell_rendered_value = ''

                      if r_key contains 'brushing'
                        assign cell_rendered_value = pc_brushing_price
                      elsif r_key contains 'care-credit' or r_key contains 'care_credit' or r_key contains 'care credit'
                        assign cell_rendered_value = pc_care_credit_price
                      endif
                    -%}
                    {%- if cell_rendered_value != blank -%}
                      {{ cell_rendered_value }}
                    {%- elsif cell_value.value.type == 'rich_text_field' -%}
                      {{ cell_value.value | metafield_tag | strip_html | strip }}
                    {%- else -%}
                      {{ cell_value.value }}
                    {%- endif -%}
                    {%- if cell_value.tooltip != blank -%}
                      <span class="info-tip pc-tip-end">
                        {%- if kc -%}
                          {{ kc_info_icon }}
                        {%- else -%}
                          <span aria-hidden="true" class="info-icon">i</span>
                        {%- endif -%}
                        <span class="info-tip-popover" role="tooltip">
                          {%- if cell_value.tooltip.type == 'rich_text_field' -%}
                            {{ cell_value.tooltip | metafield_tag }}
                          {%- else -%}
                            {{ cell_value.tooltip.value | default: cell_value.tooltip }}
                          {%- endif -%}
                        </span>
                      </span>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endfor -%}

            <div class="pc-ctacell center">
              {%- liquid
                assign plan_cta_label = plan.cta_button.value | default: plan.cta_button | default: 'Choose plan'
                assign plan_cta_label_id = 'pc-cta-' | append: section.id | append: '-' | append: forloop.index
                assign plan_cta_named_by = plan_cta_label_id
                unless plan_cta_label contains plan_title
                  assign plan_cta_named_by = plan_cta_named_by | append: ' pc-name-' | append: section.id | append: '-' | append: forloop.index
                endunless
              -%}
              <button
                aria-labelledby="{{ plan_cta_named_by }}"
                {%- if kc %}
                  class="pc-cta{% if plan.featured.value == true %} pc-cta--primary{% else %} pc-cta--secondary{% endif %}"
                {%- else %}
                  class="pc-cta subtitle-item{% if plan.featured.value == true %} karmicare__btn-primary{% else %} karmicare__btn-secondary{% endif %}"
                {%- endif %}
                data-kc-plan-product="{{ product.id }}"
                data-kc-plan-title="{{ plan_title | escape }}"
                {%- if plan_is_once %}
                  data-kc-plan-choose="once"
                {%- else %}
                  data-kc-plan-choose="plan"
                  data-selling-plan-id="{{ plan_selling_plan_id | escape }}"
                  data-selling-plan-group-id="{{ plan_group_id }}"
                {%- endif %}
                type="button"
              >
                <span id="{{ plan_cta_label_id }}">{{ plan_cta_label }}</span>
                {%- render 'kc-plan-spinner' -%}
              </button>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- render 'kc-plan-feedback' -%}

      {%- if footer_text != blank -%}
        <div class="pc-foot">{{ footer_text }}</div>
      {%- endif -%}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const tooltips = document.querySelectorAll('.info-tip, .pc-kit');

      tooltips.forEach((tooltip) => {
        tooltip.addEventListener('click', function (e) {
          if (window.innerWidth <= 768) {
            const isActive = this.classList.contains('active-tip');

            tooltips.forEach((t) => t.classList.remove('active-tip'));

            if (!isActive) {
              this.classList.add('active-tip');
            }
          }
        });
      });

      // A plan CTA focused from the keyboard comes fully into view in the scrolling strip, clear
      // of the sticky labels (scroll-padding in the CSS). Focus alone scrolls only a CTA that is
      // wholly out of view, so a CTA half under the labels or half off the edge stayed cut
      // (R39b B2). Keyboard focus only: on a click the scroll moved the button between
      // pointerdown and pointerup, and the click missed it (R39c B3).
      document.querySelectorAll('.plan-compare--kc .pc-table').forEach(function (strip) {
        strip.addEventListener('focusin', function (e) {
          const cta = e.target.closest('.pc-cta');
          if (!cta) return;
          let fromKeyboard = false;
          try {
            fromKeyboard = cta.matches(':focus-visible');
          } catch (err) {
            fromKeyboard = false;
          }
          if (fromKeyboard) cta.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        });
      });

      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768) {
          if (!e.target.closest('.info-tip') && !e.target.closest('.pc-kit')) {
            tooltips.forEach((t) => t.classList.remove('active-tip'));
          }
        }
      });
    });
  </script>
  {%- comment -%} The table's fixed euro amounts in the active currency, this section only (R35 B2) {%- endcomment -%}
  {%- assign kc_eur_root = '#compare-plans-' | append: section.id -%}
  {%- render 'kc-eur-convert', root: kc_eur_root -%}
{%- endif -%}

{% schema %}
{
  "name": "Product Compare Plans",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "kc",
          "label": "KC tokens (Figma 2026)"
        }
      ],
      "default": "classic",
      "info": "KC tokens: the product page table from Figma, Day and Night through the KC tokens. Classic keeps the earlier look."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Choose your rhythm"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title text override (Defaults to Metaobject Title)"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle text",
      "default": "<p>Start with one set, refill every 60 days, or choose the full year — the ritual stays the same: <b>Awake</b> in the morning, <b>Asleep</b> at night.</p>"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "default": "<p>Every subscription earns <b>Care Credit</b>: real euros toward more Karmicare products — a return on the care you keep.</p>"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Section surface",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "accent", "label": "Accent" },
        { "value": "transition", "label": "Transition" }
      ],
      "default": "transition",
      "info": "Page and Accent hold their colour. Transition fades from the colour of the section above to the other one. A hold that follows the other colour is shown as a transition and flagged here."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Product Compare Plans"
    }
  ]
}
{% endschema %}
