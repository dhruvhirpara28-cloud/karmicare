      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Stat Value / Heading",
          "default": "Clinically backed"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Stat Description / Subtext",
          "default": "Formulated on +36 studies"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stat Strip - Karmicare",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "heading": "0%",
            "text": "fluoride, SLS"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "1 pump",
            "text": "the full dose"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "Clinically backed",
            "text": "Formulated on +36 studies"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "64 days",
            "text": "of AM/PM care per duo"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "No rinse",
