{%- comment -%}
  Trusted Professionals Section
{%- endcomment -%}

{{ 'section-trusted-professionals.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_border_top != blank %}
  <div class="block__border-top border-{{ section.id }}">
    <div class="page-width">
      <div class="kc-section-border"></div>
    </div>
  </div>
{% endif %}

<div class="trusted-professionals section-{{ section.id }}">
  {%- style -%}
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_desktop }}px;
        padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      }
    }

    {%- if section.settings.heading_bold_opacity != blank -%}
      .section-{{ section.id }} .trusted-professionals__header h2 strong,
      .section-{{ section.id }} .trusted-professionals__header h2 b {
        opacity: {{ section.settings.heading_bold_opacity | divided_by: 100.0 }};
      }
    {%- endif -%}

    {%- if section.settings.bg_gradient_day != blank -%}
      .section-{{ section.id }},
      .border-{{ section.id }} {
        background: {{ section.settings.bg_gradient_day }};
      }
    {%- elsif section.settings.bg_color_day != blank -%}
      .section-{{ section.id }},
      .border-{{ section.id }} {
        background-color: {{ section.settings.bg_color_day }};
      }
    {%- endif -%}

    {%- if section.settings.bg_gradient_night != blank -%}
      body.night-mode .section-{{ section.id }},
      body.night-mode .border-{{ section.id }} {
        background: {{ section.settings.bg_gradient_night }};
      }
    {%- elsif section.settings.bg_color_night != blank -%}
      body.night-mode .section-{{ section.id }},
      body.night-mode .border-{{ section.id }} {
        background-color: {{ section.settings.bg_color_night }};
      }
    {%- endif -%}

    {%- if section.settings.card_bg_color_day != blank -%}
      .section-{{ section.id }} .trusted-professionals__card-content {
        background-color: {{ section.settings.card_bg_color_day }};
      }
    {%- endif -%}

    {%- if section.settings.card_bg_color_night != blank -%}
      body.night-mode .section-{{ section.id }} .trusted-professionals__card-content {
        background-color: {{ section.settings.card_bg_color_night }};
      }
    {%- endif -%}
  {%- endstyle -%}

  <div class="page-width">
    <div class="trusted-professionals__inner">
      <div class="trusted-professionals__header">
        {%- if section.settings.subheading != blank -%}
          <span class="kc-caption-subheading subtitle-item">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- capture slider_classes -%}
        {% if section.settings.slider_mobile %} slider--mobile{% endif %}
        {% if section.settings.slider_tablet %} slider--tablet{% endif %}
        {% if section.settings.slider_laptop %} slider--desktop{% endif %}
        {% if section.settings.slider_desktop %} slider--desktop{% endif %}
      {%- endcapture -%}

      {%- assign show_slider = false -%}
      {%- if section.settings.slider_mobile
        or section.settings.slider_tablet
        or section.settings.slider_laptop
        or section.settings.slider_desktop
      -%}
        {%- assign show_slider = true -%}
      {%- endif -%}

      {%- if show_slider -%}
        <slider-component class="slider-mobile-gutter">
      {%- endif -%}

      <ul
        class="trusted-professionals__grid{% if show_slider %} slider{{ slider_classes }}{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
        style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-laptop: {{ section.settings.columns_laptop }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="trusted-professionals__card{% if show_slider %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="trusted-professionals__card-image">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="trusted-professionals__card-content">
              {%- if block.settings.hover_text != blank -%}
                <div class="trusted-professionals__card-quote">
                  {{ block.settings.hover_text }}
                </div>
              {%- endif -%}
              <div class="trusted-professionals__card-body">
                {%- if block.settings.heading != blank -%}
                  <h5>{{ block.settings.heading }}</h5>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_slider and section.settings.show_slider_arrows -%}
        <div class="slider-buttons no-js-hidden" style="justify-content: center; margin-top: 1rem;">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">
              <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.5366 1.46451C10.9271 1.07399 11.5603 1.07399 11.9508 1.46451C12.3413 1.85504 12.3413 2.4882 11.9508 2.87873L8.8295 6.00005C8.43898 6.39057 7.80581 6.39057 7.41529 6.00005L4.29402 2.87878C3.90349 2.48825 3.90349 1.85509 4.29402 1.46456C4.68454 1.07404 5.3177 1.07404 5.70823 1.46456L8.12239 3.87873L10.5366 1.46451Z" fill="currentColor"/>
              </svg>
            </span>
          </button>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">
              <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M3.4634 8.53549C3.07288 8.92601 2.43971 8.92601 2.04919 8.53549C1.65867 8.14496 1.65867 7.5118 2.04919 7.12127L5.1705 3.99995C5.56102 3.60943 6.19419 3.60943 6.58471 3.99995L9.70598 7.12122C10.0965 7.51175 10.0965 8.14491 9.70598 8.53544C9.31546 8.92596 8.6823 8.92596 8.29177 8.53544L5.87761 6.12127L3.4634 8.53549Z" fill="currentColor"/>
              </svg>
            </span>
          </button>
        </div>
      {%- endif -%}

      {%- if show_slider -%}
        </slider-component>
      {%- endif -%}

      <div class="trusted-professionals__footer">
        {%- if section.settings.bottom_text != blank -%}
          <div class="trusted-professionals__bottom-text kc-caption-text">
            {{ section.settings.bottom_text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="karmicare__btn-secondary">
            {{ section.settings.button_label }}
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none">
              <path d="M0.75 5.41667L10.0833 5.41667M5.41667 10.0833L10.0833 5.41667L5.41667 0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.show_border_bottom != blank -%}
  <div class="block__border-bottom border-{{ section.id }}">
    <div class="page-width">
      <div class="kc-section-border"></div>
    </div>
  </div>
{% endif %}

{%- if show_slider -%}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sliders = document.querySelectorAll('.trusted-professionals__grid.slider:not([data-initialized="true"])');
      sliders.forEach((slider) => {
        slider.setAttribute('data-initialized', 'true');
        let isDown = false;
        let startX;
        let scrollLeft;

        slider.style.cursor = 'grab';

        slider.addEventListener('mousedown', (e) => {
          if (slider.scrollWidth <= slider.clientWidth) return;
          isDown = true;
          slider.style.cursor = 'grabbing';
          startX = e.pageX - slider.offsetLeft;
          scrollLeft = slider.scrollLeft;
        });
        slider.addEventListener('mouseleave', () => {
          isDown = false;
          slider.style.cursor = 'grab';
        });
        slider.addEventListener('mouseup', () => {
          isDown = false;
          slider.style.cursor = 'grab';
        });
        slider.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - slider.offsetLeft;
          const walk = (x - startX) * 2;
          slider.scrollLeft = scrollLeft - walk;
        });
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Trusted Professionals",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Top / Bottom Border"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show Top Border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show Bottom Border",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_bold_opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Heading Bold Text Opacity",
      "default": 70
    },
    {
      "type": "header",
      "content": "Footer Content"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Bottom Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "color",
      "id": "card_bg_color_day",
      "label": "Card Background Color (Day)"
    },
    {
      "type": "color",
      "id": "card_bg_color_night",
      "label": "Card Background Color (Night)"
    },
    {
      "type": "header",
      "content": "Grid & Slider Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop (1200px+)",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "slider_desktop",
      "label": "Enable Slider on Desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_laptop",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columns on Laptop (990px - 1199px)",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "slider_laptop",
      "label": "Enable Slider on Laptop",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columns on Tablet (750px - 989px)",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "slider_tablet",
      "label": "Enable Slider on Tablet",
      "default": false
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile (< 750px)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.3", "label": "1.3" },
        { "value": "1.5", "label": "1.5" },
        { "value": "1.8", "label": "1.8" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "1.5"
    },
    {
      "type": "checkbox",
      "id": "slider_mobile",
      "label": "Enable Slider on Mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slider_arrows",
      "label": "Show Slider Arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Professional Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "hover_text",
          "label": "Hover Quote"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trusted Professionals",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
