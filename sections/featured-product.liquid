  {%- unless placeholder -%}
  <script>
  (function() {
    var SECTION_ID = '{{ section.id }}';
    var FAKE_PRODUCT_ID = {{ fake_loop_id }};
    var LOOP_CONTAINER_ID = 'loop-subscription-container-' + FAKE_PRODUCT_ID;
    var PRICE_WRAPPER_ID = 'price-' + FAKE_PRODUCT_ID;

    /**
     * Format price in cents to locale string using Shopify's money format.
     * Falls back to loopFormatMoney if available, otherwise a simple fallback.
     */
    function formatPrice(cents) {
      if (typeof loopFormatMoney === 'function') {
        return loopFormatMoney(cents, true);
      }
      // Fallback: simple currency format
      var moneyFormat = window.Shopify && window.Shopify.money_format
        ? window.Shopify.money_format
        : '{{amount}}';
      var amount = (cents / 100).toFixed(2);
      return moneyFormat.replace('{{amount}}', amount)
                        .replace('{{amount_no_decimals}}', Math.floor(cents / 100))
                        .replace('{{amount_with_comma_separator}}', amount.replace('.', ','));
    }

    /**
     * Get the currently selected price for the Loop widget.
     * Returns price in cents, or null if not yet initialized.
     */
    function getSelectedLoopPrice() {
      var props = window.loopProps && window.loopProps[FAKE_PRODUCT_ID];
      if (!props) return null;

      // Check if a subscription plan is selected (not one-time)
      var sellingPlanGroupId = props.sellingPlanGroupId;
      var isOneTime = !sellingPlanGroupId || sellingPlanGroupId === 'loop-one-time-purchase';

      if (!isOneTime) {
        // Use the selling plan allocation price
        var spPrice = props.sellingPlanAllocation && props.sellingPlanAllocation.price;
        if (spPrice != null) return spPrice;
        // Fall back to sellingPlan price
        var sp = props.sellingPlan;
        if (sp && sp.price != null) return sp.price;
      }

      // One-time or fallback: use variant price
      var variantId = props.selectedVariantId;
      var product = props.product;
      if (product && product.variants) {
        var variant = product.variants.find(function(v) { return v.id == variantId; });
        if (variant) return variant.price;
      }
      return null;
    }

    /**
     * Get the compare-at price for compare display.
     */
    function getCompareAtPrice() {
      var props = window.loopProps && window.loopProps[FAKE_PRODUCT_ID];
      if (!props) return null;
      var variantId = props.selectedVariantId;
      var product = props.product;
      if (product && product.variants) {
        var variant = product.variants.find(function(v) { return v.id == variantId; });
        if (variant) return variant.compare_at_price;
      }
      return null;
    }

    /**
     * Update the price display elements inside the featured product price wrapper.
     */
    function updateFeaturedProductPrice() {
      var price = getSelectedLoopPrice();
      if (price == null) return;

      var compareAtPrice = getCompareAtPrice();
      var priceWrapper = document.getElementById(PRICE_WRAPPER_ID);
      if (!priceWrapper) return;

      var formattedPrice = formatPrice(price);
      var isOnSale = compareAtPrice && compareAtPrice > price;

      // Toggle on-sale class on the price container
      var priceEl = priceWrapper.querySelector('.price');
      if (priceEl) {
        if (isOnSale) {
          priceEl.classList.add('price--on-sale');
          priceEl.classList.remove('price--sold-out');
        } else {
          priceEl.classList.remove('price--on-sale');
        }
      }

      if (isOnSale) {
        // On sale: show compare-at in .price-item--regular (strikethrough), subscription price in .price-item--sale
        var regularEls = priceWrapper.querySelectorAll('.price-item--regular');
        regularEls.forEach(function(el) {
          el.innerHTML = formatPrice(compareAtPrice);
        });
        var saleEls = priceWrapper.querySelectorAll('.price-item--sale');
        saleEls.forEach(function(el) {
          el.innerHTML = formattedPrice;
        });
      } else {
        // No sale: show current price in .price-item--regular
        var regularEls = priceWrapper.querySelectorAll('.price-item--regular');
        regularEls.forEach(function(el) {
          el.innerHTML = formattedPrice;
        });
        // Also update sale element if present (in case switching back from sale to non-sale state)
        var saleEls = priceWrapper.querySelectorAll('.price-item--sale');
        saleEls.forEach(function(el) {
          el.innerHTML = formattedPrice;
        });
      }
    }


    /**
     * Attach listeners to Loop widget radio buttons and dropdowns.
     */
    function attachLoopListeners() {
      var container = document.getElementById(LOOP_CONTAINER_ID);
      if (!container) return false;

      // Listen to radio button changes (plan group selection)
      var radios = container.querySelectorAll('input[name="loop_purchase_option_' + FAKE_PRODUCT_ID + '"], input[name^="loop_purchase_option"]');
      radios.forEach(function(radio) {
        if (!radio.dataset.kcFpBound) {
          radio.dataset.kcFpBound = '1';
          radio.addEventListener('change', function() {
            setTimeout(updateFeaturedProductPrice, 50);
          });
          radio.addEventListener('click', function() {
            setTimeout(updateFeaturedProductPrice, 50);
          });
        }
      });

      // Listen to dropdown (delivery frequency) changes
      var selects = container.querySelectorAll('.loop-selling-plan-selector');
      selects.forEach(function(sel) {
        if (!sel.dataset.kcFpBound) {
          sel.dataset.kcFpBound = '1';
          sel.addEventListener('change', function() {
            setTimeout(updateFeaturedProductPrice, 50);
          });
        }
      });

      return true;
    }

    /**
     * Wait for Loop widget to initialize, then set up price syncing.
     */
    function initFeaturedProductLoopPriceSync() {
      // Try attaching listeners immediately
      if (attachLoopListeners()) {
        updateFeaturedProductPrice();
      }

      // Also watch for DOM changes in case Loop renders after this script
      var observer = new MutationObserver(function() {
        if (attachLoopListeners()) {
          updateFeaturedProductPrice();
        }
      });

      var productInfoWrapper = document.getElementById('ProductInfo-' + SECTION_ID);
      if (productInfoWrapper) {
        observer.observe(productInfoWrapper, { childList: true, subtree: true });
      }

      // Poll loopProps until it's populated with our fake product ID
      var pollCount = 0;
      var poll = setInterval(function() {
        pollCount++;
        if (pollCount > 100) { clearInterval(poll); return; } // give up after ~10s

        var props = window.loopProps && window.loopProps[FAKE_PRODUCT_ID];
        if (props && props.product) {
          clearInterval(poll);
          attachLoopListeners();
          updateFeaturedProductPrice();

          // Re-run after a short delay as the widget may still be setting defaults
          setTimeout(updateFeaturedProductPrice, 500);
          setTimeout(updateFeaturedProductPrice, 1500);
        }
      }, 100);
    }

    // Initialize after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFeaturedProductLoopPriceSync);
    } else {
      initFeaturedProductLoopPriceSync();
    }
  })();
  </script>
  {%- endunless -%}
</product-info>

