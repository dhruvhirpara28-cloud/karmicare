{%- if section.blocks.size > 1 -%}
  {{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{%- if social_icons and section.settings.show_social -%}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  /* KC announcement bar: Figma homepage desktop 2642:1903 (28px, hairline below) and mobile
     2766:10306 (30px, one line scrolling in from the page gutter). Colours default to the
     KC tokens; the Day/Night colour settings below override them when filled. */
  #AnnouncementBar-{{ section.id }} {
    background: var(--kc-mapped-gradient-section-accent);
    color: var(--kc-mapped-text-default-heading);
  }
  #AnnouncementBar-{{ section.id }} .announcement-bar {
    color: inherit;
  }
  #AnnouncementBar-{{ section.id }}.utility-bar--bottom-border {
    border-bottom: var(--kc-shape-stroke-thin) solid var(--kc-mapped-border-primary-hairline);
  }

  {%- if section.settings.bg_color_day != blank -%}
    body.day-mode #AnnouncementBar-{{ section.id }} {
      background: {{ section.settings.bg_color_day }};
    }
  {%- endif -%}
  {%- if section.settings.text_color_day != blank -%}
    body.day-mode #AnnouncementBar-{{ section.id }},
    body.day-mode #AnnouncementBar-{{ section.id }} a {
      color: {{ section.settings.text_color_day }};
    }
    body.day-mode #AnnouncementBar-{{ section.id }} svg {
      fill: {{ section.settings.text_color_day }};
    }
  {%- endif -%}

  /* Figma: 28px bar (8px above a 12px line, the hairline closes it). From 750px the line stands
     still and centred; it only moves when one copy plus the gutters is wider than the bar, which
     the script under the markup measures with the real text and fonts (Victor, 24 Oct: no
     animation unless on mobile or the text is longer than the viewport). Without the script a
     long line wraps instead of being clipped. */
  @media screen and (min-width: 750px) {
    /* The still line sits between the page gutters (32px from 750px), not Dawn's utility padding
       (15px, then 50px from 990px); the script measures the room between them */
    #AnnouncementBar-{{ section.id }} .utility-bar__grid {
      padding-left: var(--kc-responsive-spacing-page-gutter);
      padding-right: var(--kc-responsive-spacing-page-gutter);
    }

    #AnnouncementBar-{{ section.id }} .announcement-bar__message {
      padding: 0.8rem 0 0.7rem;
      min-height: 0;
      line-height: 1.2rem;
    }

    #AnnouncementBar-{{ section.id }} .announcement-bar__message * {
      line-height: inherit;
    }

    /* One line while the script measures, whatever the state */
    #AnnouncementBar-{{ section.id }} .announcement-bar--marquee.is-measuring .announcement-bar__message {
      white-space: nowrap;
    }
  }

  {%- if section.settings.border_color_day != blank -%}
    body.day-mode #AnnouncementBar-{{ section.id }}.utility-bar--bottom-border {
      border-bottom-color: {{ section.settings.border_color_day }};
    }
  {%- endif -%}

  {%- if section.settings.bg_color_night != blank -%}
    body.night-mode #AnnouncementBar-{{ section.id }} {
      background: {{ section.settings.bg_color_night }};
    }
  {%- endif -%}
  {%- if section.settings.text_color_night != blank -%}
    body.night-mode #AnnouncementBar-{{ section.id }},
    body.night-mode #AnnouncementBar-{{ section.id }} a {
      color: {{ section.settings.text_color_night }};
    }
    body.night-mode #AnnouncementBar-{{ section.id }} svg {
      fill: {{ section.settings.text_color_night }};
    }
  {%- endif -%}
  {%- if section.settings.border_color_night != blank -%}
    body.night-mode #AnnouncementBar-{{ section.id }}.utility-bar--bottom-border {
      border-bottom-color: {{ section.settings.border_color_night }};
    }
  {%- endif -%}

  {%- if section.settings.font_size != blank -%}
    #AnnouncementBar-{{ section.id }} .announcement-bar__message {
      font-size: {{ section.settings.font_size }}px;
      letter-spacing: var(--kc-responsive-Nunito-letter-spacing);
      font-family: var(--kc-font-family-Nunito);
      font-weight:var(--font-700-weight);
    }
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.font_size != blank -%}
      #AnnouncementBar-{{ section.id }} .announcement-bar-message-{{ block.id }} {
        font-size: {{ block.settings.font_size }}px;
      }
    {%- endif -%}
  {%- endfor -%}

  /* The copies of the text only exist for the loop */
  #AnnouncementBar-{{ section.id }} .announcement-bar__copy {
    display: none;
  }

  /* Mobile: 30px bar, no hairline (Figma 2766:10306). The line starts at the page gutter and
     scrolls left. Type 10/14 as in Figma, under the 12px block setting; no token has that
     size. With reduced motion the line stands still and wraps, centred between the gutters. */
  @media screen and (max-width: 749px) {
    #AnnouncementBar-{{ section.id }}.utility-bar--bottom-border {
      border-bottom: none;
    }
    #AnnouncementBar-{{ section.id }} .utility-bar__grid {
      padding: 0;
    }
    #AnnouncementBar-{{ section.id }} .announcement-bar--marquee {
      padding: 0 var(--kc-responsive-spacing-page-gutter);
    }
    #AnnouncementBar-{{ section.id }} .announcement-bar--marquee .announcement-bar__message {
      min-height: 0;
      padding: 0.8rem 0;
      font-size: 1rem;
      line-height: 1.4rem;
      letter-spacing: var(--kc-responsive-caption-letter-spacing);
    }
    #AnnouncementBar-{{ section.id }} .announcement-bar--marquee .announcement-bar__message > span {
      line-height: inherit;
    }
  }

  /* The loop, written once and printed twice: below 750px always, from 750px only while the
     script holds .is-moving on the bar, never with reduced motion. Four copies with equal
     trailing space make the loop seamless at -25%, one copy per loop. Two copies left a blank
     at the right end of every loop once the bar was wider than one copy (the short EN line is
     about 530px a copy, so from about 560px). The three copies still in view cover the widest
     marquee bar. One copy takes 20s, half the earlier speed (Victor, 18 Oct). From 750px the
     moving line keeps the desktop type and the hairline, so the bar is 28px either way. */
  {%- assign bar = '#AnnouncementBar-' | append: section.id -%}
  {%- for state in (1..2) -%}
    {%- if state == 1 -%}
      {%- assign marquee = bar | append: ' .announcement-bar--marquee' -%}
      @media screen and (max-width: 749px) and (prefers-reduced-motion: no-preference) {
    {%- else -%}
      {%- assign marquee = bar | append: ' .announcement-bar--marquee.is-moving' -%}
      @media screen and (min-width: 750px) and (prefers-reduced-motion: no-preference) {
        /* The moving line takes the whole bar, as on mobile. The gutters come back while the
           script measures, so it reads the room the still line would have */
        {{ bar }} .utility-bar__grid:has(> .announcement-bar--marquee.is-moving:not(.is-measuring)) {
          padding: 0;
        }
    {%- endif -%}
      {{ marquee }} {
        display: flex;
        justify-content: flex-start;
        overflow: hidden;
        padding-left: var(--kc-responsive-spacing-page-gutter);
      }
      {{ marquee }} .announcement-bar__message {
        display: flex;
        white-space: nowrap;
        animation: kc-announcement-marquee-{{ section.id }} 20s linear infinite;
      }
      {{ marquee }} .announcement-bar__message > span {
        padding-right: 4rem;
      }
      {{ marquee }} .announcement-bar__copy {
        display: inline;
      }
      /* Pause: pointer over the line, or keyboard focus on it (the region is focusable while
         it moves, as the stat strip; no pause button, Victor, 20 Oct). Tab moves on and the
         line resumes. */
      {{ marquee }}:hover .announcement-bar__message,
      {{ marquee }}:focus-within .announcement-bar__message {
        animation-play-state: paused;
      }
      {{ marquee }}:focus-visible {
        outline: 2px solid var(--kc-mapped-border-focus-default);
        outline-offset: -2px;
      }
    }
  {%- endfor -%}
  @keyframes kc-announcement-marquee-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }
{%- endstyle -%}

<div
  id="AnnouncementBar-{{ section.id }}"
  class="utility-bar announcement-bar-{{ section.id }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if section.blocks.size == 1 -%}
      <div
        class="announcement-bar announcement-bar--marquee{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {% if section.blocks.first.settings.link == blank %}data-kc-marquee-focus{% endif %}
        {{ section.blocks.first.shopify_attributes }}
      >
        {%- if section.blocks.first.settings.text != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message announcement-bar-message-{{ section.blocks.first.id }} h5">
            <span>{{ section.blocks.first.settings.text | escape }}</span>
            {%- for copy in (1..3) -%}
              <span class="announcement-bar__copy" aria-hidden="true">
                {{- section.blocks.first.settings.text | escape -}}
              </span>
            {%- endfor -%}
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- comment -%}
        From 750px the line only moves when one copy plus the gutters is wider than the bar. The
        script measures that before first paint (so nothing flips on load), again on resize, once
        the fonts are in and when the theme editor reloads the section, and holds .is-moving on
        the bar. It leaves the moving state only once the line fits with 8px to spare, so a 1px
        change of width never flips it back and forth. The region is a tab stop only while the
        line moves (below 750px, or .is-moving; never with reduced motion), so keyboard focus can
        pause it; a linked announcement pauses through its link instead
      {%- endcomment -%}
      <script>
        (function () {
          var id = 'AnnouncementBar-{{ section.id }}';
          var wide = window.matchMedia('(min-width: 750px)');
          var still = window.matchMedia('(prefers-reduced-motion: reduce)');
          var slack = 8;
          var observer = window.ResizeObserver ? new ResizeObserver(sync) : null;
          var section, grid, bar, text;

          function fits(moving) {
            bar.classList.add('is-measuring');
            var range = document.createRange();
            range.selectNodeContents(text);
            var line = range.getBoundingClientRect().width;
            var arrow = bar.querySelector('.icon-arrow');
            if (arrow) line += arrow.getBoundingClientRect().width + parseFloat(getComputedStyle(arrow).marginLeft);
            var gutters = getComputedStyle(grid);
            var room = grid.clientWidth - parseFloat(gutters.paddingLeft) - parseFloat(gutters.paddingRight);
            bar.classList.remove('is-measuring');
            return Math.ceil(line) <= Math.floor(room) - (moving ? slack : 0);
          }

          function sync() {
            if (!bar) return;
            var moving = wide.matches && !still.matches && !fits(bar.classList.contains('is-moving'));
            bar.classList.toggle('is-moving', moving);
            if (!bar.hasAttribute('data-kc-marquee-focus')) return;
            if (!still.matches && (moving || !wide.matches)) {
              bar.setAttribute('tabindex', '0');
            } else {
              bar.removeAttribute('tabindex');
            }
          }

          function bind() {
            section = document.getElementById(id);
            bar = section && section.querySelector('.announcement-bar--marquee');
            text = bar && bar.querySelector('.announcement-bar__message > span');
            grid = text && bar.parentNode;
            if (!grid) {
              bar = null;
              return;
            }
            if (observer) {
              observer.disconnect();
              observer.observe(section);
            }
            sync();
          }

          bind();
          if (!observer) window.addEventListener('resize', sync);
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(sync);
          if (still.addEventListener) still.addEventListener('change', sync);
          document.addEventListener('shopify:section:load', function (event) {
            if (event.detail && event.detail.sectionId === '{{ section.id }}') bind();
          });
        })();
      </script>
    {%- elsif section.blocks.size > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in section.blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                >
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message announcement-bar-message-{{ block.id }} h5">
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 13
    },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background color (Day)"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text color (Day)"
    },
    {
      "type": "color",
      "id": "border_color_day",
      "label": "Border color (Day)"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background color (Night)"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text color (Night)"
    },
    {
      "type": "color",
      "id": "border_color_night",
      "label": "Border color (Night)"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.announcement-bar.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "range",
          "id": "font_size",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "default": 13
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
