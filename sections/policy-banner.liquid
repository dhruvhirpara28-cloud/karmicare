<style>
  /* ==========================================================================
     Policy Banner / Consumer Rights Section
     ========================================================================== */

  /* Base Section Layout */
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .section-{{ section.id }} .page-width {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Content Elements */
  .section-{{ section.id }} .consumer-rights__eyebrow {
    margin-bottom: 24px;
  }

  .section-{{ section.id }} .consumer-rights__heading {
    margin: 0 0 24px;
    line-height: 1;
    letter-spacing: -2px;
  }

  .section-{{ section.id }} .consumer-rights__description {
    margin: 0 0 24px;
  }

  .section-{{ section.id }} .consumer-rights__company-info {
    margin: 0 0 3px;
    font-size: var(--font-body-medium-size-desktop);
  }

  .section-{{ section.id }} .consumer-rights__company-info-inner {
    margin: 0 0 24px;
    font-size: var(--font-body-medium-size-desktop);
  }

  .section-{{ section.id }} .consumer-rights__company-info-inner a {
    text-decoration: underline;
  }

  /* Cards Grid */
  .section-{{ section.id }} .consumer-rights__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-xl);
    padding-top: 24px;
    border-top: 1px solid #2C3A60;
  }

  .section-{{ section.id }} .consumer-rights__card {
    padding: 14px;
    border-radius: var(--extra-primary-border-radius);
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    justify-content: flex-start;
  }

  .section-{{ section.id }} .consumer-rights__card-description {
    font-weight: var(--font-500-weight);
    font-size: var(--font-body-medium-size-desktop);
  }

  .section-{{ section.id }} .consumer-rights__card-bottom {
    font-size: var(--font-body-medium-size-desktop);
  }

  /* A card with a link: the description is the link, the whole card its hit area */
  .section-{{ section.id }} .consumer-rights__card:has(.consumer-rights__card-link) {
    position: relative;
  }

  .section-{{ section.id }} .consumer-rights__card-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .section-{{ section.id }} .consumer-rights__card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .section-{{ section.id }} .consumer-rights__card-link:hover {
    color: var(--kc-link-hover-color);
  }

  .section-{{ section.id }} .consumer-rights__card-link:focus-visible {
    outline: 2px solid var(--kc-mapped-border-focus-strong);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Day Mode Colors */
  {%- if section.settings.box_color_day != blank -%}
    body:not(.night-mode) .section-{{ section.id }} .consumer-rights__card,
    body.day-mode .section-{{ section.id }} .consumer-rights__card {
      background-color: {{ section.settings.box_color_day }};
    }
  {%- endif -%}

  {%- if section.settings.text_color_day != blank -%}
    /* Every text in the section at full colour, the company line included (Victor, 26 Oct:
       body text is never translucent; it was 68%, with the links kept full on top) */
    body:not(.night-mode) .section-{{ section.id }} *,
    body.day-mode .section-{{ section.id }} * {
      color: {{ section.settings.text_color_day }};
    }
  {%- endif -%}

  /* Night Mode Colors */
  {%- if section.settings.box_color_night != blank -%}
    body.night-mode .section-{{ section.id }} .consumer-rights__card {
      background-color: {{ section.settings.box_color_night }};
    }
  {%- endif -%}

  {%- if section.settings.text_color_night != blank -%}
    body.night-mode .section-{{ section.id }} * {
      color: {{ section.settings.text_color_night }};
    }
  {%- endif -%}

  /* Responsive - Tablet & Mobile (< 768px) */
  @media only screen and (max-width: 767px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .section-{{ section.id }} .consumer-rights__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Responsive - Small Mobile (< 641px) */
  @media only screen and (max-width: 640px) {
    .section-{{ section.id }} .consumer-rights__cards {
      padding-top: 20px;
      gap: 12px;
    }

    .section-{{ section.id }} .consumer-rights__eyebrow,
    .section-{{ section.id }} .consumer-rights__heading,
    .section-{{ section.id }} .consumer-rights__description,
    .section-{{ section.id }} .consumer-rights__company-info-inner {
      margin-bottom: 20px;
    }

    .section-{{ section.id }} .consumer-rights__eyebrow {
      font-size: var(--kc-responsive-label-sm-text-size);
      line-height: 12px;
    }

    .section-{{ section.id }} .consumer-rights__card {
      padding: 20px;
    }

    .section-{{ section.id }} .consumer-rights__card-title {
      font-size: 20px;
      line-height: 24px;
    }

    .section-{{ section.id }} .consumer-rights__card-description,
    .section-{{ section.id }} .consumer-rights__card-bottom,
    .section-{{ section.id }} .consumer-rights__company-info,
    .section-{{ section.id }} .consumer-rights__company-info-inner {
      font-size: var(--kc-responsive-label-sm-text-size);
    }
  }
</style>

<div
  id="section-{{ section.id }}"
  class="consumer-rights section-{{ section.id }} kc-surface"
  data-kc-surface="{{ section.settings.surface }}"
>
  <div class="page-width">
    {% if section.settings.eyebrow != blank %}
      <div class="consumer-rights__eyebrow subtitle-item opacity-xl">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="consumer-rights__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="consumer-rights__description opacity-xl h5">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.company_info != blank %}
      <div class="consumer-rights__company-info">
        {{ section.settings.company_info }}
      </div>
    {% endif %}
    {% if section.settings.company_last_updated != blank %}
      <div class="consumer-rights__company-info-inner">
        {{ section.settings.company_last_updated }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="consumer-rights__cards">
        {% for block in section.blocks %}
          {% if block.settings.card_title != blank %}
            <div
              class="consumer-rights__card"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.card_title != blank %}
                <div class="consumer-rights__card-title h4">
                  {{ block.settings.card_title }}
                </div>
              {% endif %}

              {% if block.settings.card_description != blank %}
                <div class="consumer-rights__card-description">
                  {%- comment -%}
                    With a link the description carries it and the whole card is clickable
                    (::after stretches over the card): "2 years / Legal guarantee" lands on the
                    legal guarantee section further down, #two-year-guarantee (Victor, 24 Oct).
                  {%- endcomment -%}
                  {% if block.settings.card_link != blank %}
                    <a class="consumer-rights__card-link" href="{{ block.settings.card_link | escape }}">{{ block.settings.card_description }}</a>
                  {% else %}
                    {{ block.settings.card_description }}
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.card_bottom_text != blank %}
                <div class="consumer-rights__card-bottom">
                  {{ block.settings.card_bottom_text }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Policy Bannner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LEGAL"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Consumer Rights & Transparency Charter"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Your rights under Belgian and EU law, together with the promises Karmicare adds on top.</p>"
    },
    {
      "type": "richtext",
      "id": "company_info",
      "label": "Company / Legal Information",
      "default": "<p>KARMICA BV, trading as KARMICARE · Vriezestraat 28, 8000 Bruges, Belgium · VAT BE 0676.972.896 · EORI BE0676972896<br>care@karmicare.com · Last updated October 2026</p>"
    },
    {
      "type": "richtext",
      "id": "company_last_updated",
      "label": "Last Updated Information"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Section surface",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "accent", "label": "Accent" },
        { "value": "transition", "label": "Transition" }
      ],
      "default": "page",
      "info": "Page and Accent hold their colour. Transition fades from the colour of the section above to the other one. A hold that follows the other colour is shown as a transition and flagged here."
    },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "box_color_day",
      "label": "Box Background Color (Day)"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "color",
      "id": "box_color_night",
      "label": "Box Background Color (Night)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "benefit_card",
      "name": "Rights Card",
      "settings": [
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title",
          "default": "14 days"
        },
        {
          "type": "textarea",
          "id": "card_description",
          "label": "Card Description",
          "default": "To change your mind"
        },
        {
          "type": "textarea",
          "id": "card_bottom_text",
          "label": "Card Bottom Text",
          "default": "Legal right · one-time orders"
        },
        {
          "type": "text",
          "id": "card_link",
          "label": "Link (URL or #anchor)",
          "info": "Optional. The whole card becomes a link, for example #two-year-guarantee for the legal guarantee section further down the page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy Bannner",
      "blocks": [
        {
          "type": "benefit_card",
          "settings": {
            "card_title": "14 days",
            "card_description": "To change your mind",
            "card_bottom_text": "Legal right · one-time orders"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "card_title": "60 days",
            "card_description": "Money-back guarantee",
            "card_bottom_text": "Karmicare promise · plans"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "card_title": "14 days",
            "card_description": "To receive your refund",
            "card_bottom_text": "Legal right · same payment method"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "card_title": "2 years",
            "card_description": "Legal guarantee",
            "card_bottom_text": "Legal right · every order"
          }
        }
      ]
    }
  ]
}
{% endschema %}
