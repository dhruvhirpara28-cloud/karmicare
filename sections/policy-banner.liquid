      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "benefit_card",
      "name": "Rights Card",
      "settings": [
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title",
          "default": "14 days"
        },
        {
          "type": "textarea",
          "id": "card_description",
          "label": "Card Description",
          "default": "To change your mind"
        },
        {
          "type": "textarea",
          "id": "card_bottom_text",
          "label": "Card Bottom Text",
          "default": "Legal right · one-time orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy Bannner",
      "blocks": [
        {
          "type": "benefit_card",
          "settings": {
            "card_title": "14 days",
            "card_description": "To change your mind",
