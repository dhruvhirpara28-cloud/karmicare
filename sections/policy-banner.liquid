      "id": "company_info",
      "label": "Company / Legal Information",
      "default": "<p>KARMICA BV, trading as KARMICARE · Vriezestraat 28, 8000 Bruges, Belgium · VAT BE 0676.972.896 · EORI BE0676972896<br>care@karmicare.com · Last updated October 2026</p>"
    },
    {
      "type": "richtext",
      "id": "company_last_updated",
      "label": "Last Updated Information"
     },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
