<style>
    {%- if section.settings.bg_gradient_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
          background: {{ section.settings.bg_gradient_day }};
      }
  {%- elsif section.settings.bg_color_day != blank -%}
      body:not(.night-mode) .section-{{ section.id }},
      body.day-mode .section-{{ section.id }} {
          background-color: {{ section.settings.bg_color_day }};
      }
  {%- endif -%}

    {%- if section.settings.bg_gradient_night != blank -%}
    body.night-mode .section-{{ section.id }} {
        background: {{ section.settings.bg_gradient_night }};
    }
    {%- elsif section.settings.bg_color_night != blank -%}
    body.night-mode .section-{{ section.id }} {
        background-color: {{ section.settings.bg_color_night }};
    }
    {%- endif -%}
  /* DAY MODE */
    {% if section.settings.text_color_day != blank %}
      body:not(.night-mode) .section-{{ section.id }} *,
      body.day-mode .section-{{ section.id }} * {
        color: {{ section.settings.text_color_day }};
      }
       body:not(.night-mode) .section-{{ section.id }} .consumer-rights__company-info-inner p,
      body.day-mode .section-{{ section.id }} .consumer-rights__company-info-inner p{
       color: rgb(from {{ section.settings.text_color_day }} r g b / 68%);
      }
       body:not(.night-mode) .section-{{ section.id }} .consumer-rights__company-info-inner a,
      body.day-mode .section-{{ section.id }} .consumer-rights__company-info-inner a{
        color: {{ section.settings.text_color_day }};
      }
    {% endif %}


    /* NIGHT MODE */
    {% if section.settings.text_color_night != blank %}
      body.night-mode .section-{{ section.id }} * {
        color: {{ section.settings.text_color_night }};
      }
      body.night-mode .section-{{ section.id }} .consumer-rights__company-info-inner p{
       color: rgb(from {{ section.settings.text_color_night }} r g b / 68%);
      }
       body.night-mode .section-{{ section.id }} .consumer-rights__company-info-inner a{
        color: {{ section.settings.text_color_night }};
      }
    {% endif %}

    #section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      @media only screen and (max-width: 767px) {
      #section-{{ section.id }} {
          padding-top: {{ section.settings.padding_top_mobile }}px;
          padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
      }
</style>

<section
  id="section-{{ section.id }}"
  class="consumer-rights section-{{ section.id }}"
>
  <div class="consumer-rights__container">

    {% if section.settings.eyebrow != blank %}
      <div class="consumer-rights__eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="consumer-rights__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="consumer-rights__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.company_info != blank %}
      <div class="consumer-rights__company-info">
        {{ section.settings.company_info }}
      </div>
    {% endif %}
    {% if section.settings.company_last_updated != blank %}
      <div class="consumer-rights__company-info-inner">
        {{ section.settings.company_last_updated }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="consumer-rights__cards">

        {% for block in section.blocks %}
          <div
            class="consumer-rights__card"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.card_title != blank %}
              <div class="consumer-rights__card-title">
                {{ block.settings.card_title }}
              </div>
            {% endif %}

            {% if block.settings.card_description != blank %}
              <div class="consumer-rights__card-description">
                {{ block.settings.card_description }}
              </div>
            {% endif %}

            {% if block.settings.card_bottom_text != blank %}
              <div class="consumer-rights__card-bottom">
                {{ block.settings.card_bottom_text }}
              </div>
            {% endif %}

          </div>
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>

<style>

  #section-{{ section.id }} .consumer-rights__container {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #section-{{ section.id }} .consumer-rights__eyebrow {
    margin-bottom: 24px;
    font-weight: 500;
    font-size: 14px;
    line-height: 16px;
    letter-spacing: 1.25px;
    text-transform: uppercase;
    opacity:0.68;
}

#section-{{ section.id }} .consumer-rights__heading {
    margin: 0 0 24px;
    line-height: 1;
    letter-spacing: -2px;
}

#section-{{ section.id }} .consumer-rights__description {
    margin: 0 0 24px;
    font-size: 20px;
    letter-spacing:0px;
    line-height: 28px;
    opacity:0.68;
}

#section-{{ section.id }} .consumer-rights__company-info {
    margin: 0 0 3px;
    font-size: 15px;
    line-height: 20px;
    letter-spacing:0px;
    opacity:0.68;
}
#section-{{ section.id }} .consumer-rights__company-info-inner {
    margin: 0 0 49px;
    font-size: 15px;
    line-height: 20px;
    letter-spacing:0px;
}
#section-{{ section.id }} .consumer-rights__company-info-inner a{
    text-decoration:underline;
}

  #section-{{ section.id }} .consumer-rights__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    padding-top: 11px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  #section-{{ section.id }} .consumer-rights__card {
    min-height: 105px;
    padding: 15px 14px 13px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
  }

  #section-{{ section.id }} .consumer-rights__card-title {
    margin-bottom: 5px;
    font-size: 14px;
    line-height: 1.1;
    font-weight: 500;
  }

  #section-{{ section.id }} .consumer-rights__card-description {
    font-size: 8px;
    line-height: 1.35;
    font-weight: 500;
  }

  #section-{{ section.id }} .consumer-rights__card-bottom {
    margin-top: auto;
    padding-top: 8px;
    font-size: 8px;
    line-height: 1.35;
  }

  @media screen and (max-width: 767px) {

    #section-{{ section.id }} .consumer-rights__container {
      padding: 0 18px;
    }

    #section-{{ section.id }} .consumer-rights__heading {
      font-size: 26px;
    }

    #section-{{ section.id }} .consumer-rights__cards {
      grid-template-columns: repeat(2, 1fr);
    }

    #section-{{ section.id }} .consumer-rights__card {
      min-height: 110px;
    }
  }

  @media screen and (max-width: 480px) {
    #section-{{ section.id }} .consumer-rights__cards {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    #section-{{ section.id }} .consumer-rights__card {
      padding: 13px 12px;
    }
  }
</style>

{% schema %}
{
