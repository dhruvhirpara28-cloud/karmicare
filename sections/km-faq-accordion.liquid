{%- comment -%}
  Section: KM FAQ Accordion ("Before you start")
  File: sections/km-faq-accordion.liquid
  Note: koi pan class / CSS ma section.id vaparyu nathi. Root variables (:root) vaparya che.
{%- endcomment -%}

<section class="km-faq section-{{ section.id }}">
  <div class="km-faq__container">

    {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="km-faq__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="km-faq__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="km-faq__subtext">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="km-faq__list">
      {%- for block in section.blocks -%}
        <details
          class="km-faq__item"
          {% if section.settings.open_first and forloop.first %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="km-faq__question">
            <span class="km-faq__question-text">{{ block.settings.question | escape }}</span>
            <span class="km-faq__icon" aria-hidden="true">
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.75 5.41667L10.0833 5.41667M5.41667 0.75L5.41667 10.0833" stroke="#191F38" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
          </summary>
          <div class="km-faq__answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>

  </div>
</section>

{% style %}
    {%- if section.settings.bg_gradient_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
        background: {{ section.settings.bg_gradient_day }};
        --text-color: {{ section.settings.text_color_day }};
        --card-bg: {{ section.settings.card_bg_color_day }};
        }
    {%- elsif section.settings.bg_color_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
            background-color: {{ section.settings.bg_color_day }};
            --text-color: {{ section.settings.text_color_night }};
            --card-bg: {{ section.settings.card_bg_color_day }};
        }
    {%- endif -%}

    {%- if section.settings.bg_gradient_night != blank -%}
        body.night-mode .section-{{ section.id }} {
        background: {{ section.settings.bg_gradient_night }};
        --text-color: {{ section.settings.text_color_night }};
        --card-bg: {{ section.settings.card_bg_color_night }};
        }
    {%- elsif section.settings.bg_color_night != blank -%}
        body.night-mode .section-{{ section.id }} {
            background-color: {{ section.settings.bg_color_night }};
            --text-color: {{ section.settings.text_color_night }};
            --card-bg: {{ section.settings.card_bg_color_night }};
        }
    {%- endif -%}
{% endstyle %}

<style>
  .km-faq {
    --km-faq-text: #fffbf6;
    --km-faq-answer-text: rgba(25, 31, 56, 0.78);
    --km-faq-card-bg: #ffffff;
    --km-faq-card-radius: 12px;

    background: linear-gradient(180deg, var(--km-faq-bg-top) 0%, var(--km-faq-bg-bottom) 100%);
    padding: var(--spacing-sections-mobile, 40px) var(--gap-xl);
    font-family: var(--font-body-family);
    color: var(--km-faq-text);
    padding: 64px 20px;
  }

  .km-faq__container {
    max-width: 744px;
    margin: 0 auto;
  }

  /* ---------- Header ---------- */
  .km-faq__header {
    text-align: center;
    margin-bottom: 40px;
  }
{% comment %} 
  .km-faq__title {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: normal;
    font-weight: var(--font-500-weight, 500);
    font-size: 30px;
    line-height: 1;
    letter-spacing: 1.5px;
    text-align: center;
    color: var(--text-color);
  } {% endcomment %}

  .km-faq__subtext {
    margin: var(--gap-xl) auto 0;
    max-width: 420px;
    font-family: var(--font-body-family);
    font-style: normal;
    font-weight: var(--font-400-weight, 400);
    font-size: var(--km-body, 16px);
    line-height: 24px;
    letter-spacing: 0;
    text-align: center;
    color: var(--text-color);
  }

  /* ---------- List ---------- */
  .km-faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .km-faq__item {
    background: var(--card-bg);
    border-radius: var(--km-faq-card-radius);
    overflow: hidden;
  }

  .km-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-xl);
    padding: var(--gap-2xl);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-body-family);
    font-style: normal;
    font-weight: var(--font-600-weight, 600);
    font-size: var(--km-body, 16px);
    line-height: 24px;
    letter-spacing: 0;
    color: var(--text-color);
  }

  .km-faq__question::-webkit-details-marker { display: none; }
  .km-faq__question::marker { content: ""; }

  .km-faq__question:focus-visible {
    outline: 2px solid var(--text-color);
    outline-offset: -2px;
  }

  /* Plus / Minus icon box */
.km-faq__icon {
    position: relative;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border: 1px solid var(--text-color);
    border-radius: 8px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
}
details.km-faq__item .km-faq__icon svg {
    transition: .4s;
}   
details.km-faq__item .km-faq__icon svg * {
    stroke: var(--text-color);
}
details.km-faq__item[open] .km-faq__icon svg {
    transform: rotate(45deg);
}
  {% comment %} .km-faq__icon::before,
  .km-faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    background: #2C3A60; 
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease, opacity 0.25s ease;
  } {% endcomment %}

  .km-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .km-faq__item[open] .km-faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
    opacity: 0;
  }

  /* Answer */
  .km-faq__answer {
    padding: 0 var(--gap-2xl) var(--gap-2xl);
    font-family: var(--font-body-family);
    font-style: normal;
    font-weight: var(--font-500-weight, 500);
    font-size: var(--km-body-sm, 14px);
    line-height: 20px;
    letter-spacing: 0;
    color: var(--text-color);
  }

  .km-faq__answer p { margin: 0 0 var(--gap-md); }
  .km-faq__answer p:last-child { margin-bottom: 0; }
  .km-faq__answer a { color: inherit; text-decoration: underline; }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .km-faq {
      padding: 120px 0;
    }

    .km-faq__header { margin-bottom: 48px; }

    .km-faq__subtext {
      max-width: 460px;
      font-size: var(--km-body-lg, 20px);
      line-height: 28px;
    }

    .km-faq__question {
      padding: 24px;
      font-size: var(--km-body-lg, 20px);
      line-height: 28px;
    }

    .km-faq__answer {
      padding: 0 24px 24px;
      font-size: 18px;
      line-height: 24px;
    }
  }
  @media screen and (min-width: 749px) {
    .km-faq__question {
    padding: 20px;
}
.km-faq__answer {
    padding: 0 20px 20px;
}
}
  @media (prefers-reduced-motion: reduce) {
    .km-faq__icon::before,
    .km-faq__icon::after { transition: none; }
  }
</style>

{% schema %}
{
  "name": "KM FAQ Accordion",
  "tag": "section",
  "class": "km-faq-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you start"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Sub text",
      "default": "Everything people usually ask before switching to a day-and-night oral care system."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "card_bg_color_day",
      "label": "Card Background Color (Day)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "color",
      "id": "card_bg_color_night",
      "label": "Card Background Color (Night)",
      "default": "#191f38"
    },
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Why two formulas instead of one?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Because your mouth doesn’t do the same job all day. Daytime is exposure — acids, sugars, coffee — so Awake protects, activates and brightens. Night is repair — saliva drops and your body regenerates — so Asleep soothes, rebalances and remineralises while you sleep.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KM FAQ Accordion",
      "blocks": [
        { "type": "faq_item" },
        {
          "type": "faq_item",
          "settings": { "question": "Is Karmicare fluoride-free?", "answer": "<p>Add your answer here.</p>" }
        },
        {
          "type": "faq_item",
          "settings": { "question": "Will Karmicare offer a biorhythmic toothpaste with fluoride?", "answer": "<p>Add your answer here.</p>" }
        },
        {
          "type": "faq_item",
          "settings": { "question": "What is nano-hydroxyapatite?", "answer": "<p>Add your answer here.</p>" }
        },
        {
          "type": "faq_item",
          "settings": { "question": "Should I rinse after brushing?", "answer": "<p>Add your answer here.</p>" }
        },
        {
          "type": "faq_item",
          "settings": { "question": "How quickly will I notice a difference?", "answer": "<p>Add your answer here.</p>" }
        }
      ]
    }
  ]
}
{% endschema %}