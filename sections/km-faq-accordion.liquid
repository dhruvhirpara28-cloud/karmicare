{%- comment -%}
  Section: KM FAQ Accordion ("Before you start")
  File: sections/km-faq-accordion.liquid
  Note: koi pan class / CSS ma section.id vaparyu nathi. Root variables (:root) vaparya che.
{%- endcomment -%}
{% style %}
      .section-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }} {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }
      {%- if section.settings.bg_gradient_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
          background: {{ section.settings.bg_gradient_day }};
        }
      {%- elsif section.settings.bg_color_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
          background-color: {{ section.settings.bg_color_day }};
        }
      {%- endif -%}

      {%- if section.settings.bg_gradient_night != blank -%}
        body.night-mode .section-{{ section.id }} {
          background: {{ section.settings.bg_gradient_night }};
        }
      {%- elsif section.settings.bg_color_night != blank -%}
        body.night-mode .section-{{ section.id }} {
          background-color: {{ section.settings.bg_color_night }};
        }
      {%- endif -%}

      .km-faq__header {
        text-align: center;
        max-width: 442px;
        margin: 0 auto;
        margin-bottom: 45px;
    }

    .km-faq__header p {
        margin-top: 16px;
    }

    /* Filters */
    .km-faq__filters {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-bottom: 40px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .km-faq__filter-btn {
      background: transparent;
      border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
      color: color-mix(in srgb, currentColor 76%, transparent);
      border-radius: 40px;
      padding: 8px 15px;
      font-size: var(--kc-responsive-label-sm-text-size);
      cursor: pointer;
      transition: all 0.3s ease;
      text-transform: uppercase;
    }

    .km-faq__filter-btn.active {
      background-color: var(--kc-mapped-surface-accent-default);
      color: var(--kc-mapped-text-accent-default-on-accent);
      border-color: var(--kc-mapped-surface-accent-default);
    }
    details.km-faq__item {
        max-width: 680px;
        margin: 0 auto;
        padding:24px;
    }
    body.day-mode .section-{{- section.id }} details.km-faq__item { background-color: {{ section.settings.card_bg_color_day }}; }
    body.night-mode .section-{{ section.id }} details.km-faq__item { background-color: {{ section.settings.card_bg_color_night }}; }

  details.km-faq__item{ margin-top: 16px; }

  summary.km-faq__question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
  }

  span.km-faq__question-text {
      flex: 1;
  }

  .km-faq__answer { margin-top: 24px; }

  span.km-faq__icon {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid currentColor;
      border-radius: 8px;
  }

  details.km-faq__item .km-faq__icon .minus {
      display: none;
  }
  details.km-faq__item[open] .km-faq__icon .plus {
      display: none;
  }
  details.km-faq__item[open] .km-faq__icon .minus {
      display: block;
  }
  @media screen and (max-width: 750px) {
    .km-faq__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      -ms-overflow-style: none;
      scrollbar-width: none;
      margin-left: -15px;
      margin-right: -15px;
      padding-left: 15px;
      padding-right: 15px;
    }
    .km-faq__filters::-webkit-scrollbar {
      display: none;
    }
    .km-faq__filter-btn {
      white-space: nowrap;
      flex-shrink: 0;
    }
    details.km-faq__item {
        padding: 20px;
    }
    .km-faq__answer,.km-faq__header p,details.km-faq__item {
    margin-top: 12px;
    }
  }
{% endstyle %}
<div class="km-faq section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="km-faq__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="km-faq__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="km-faq__subtext text-xl">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign categories = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.category != blank -%}
        {%- assign categories = categories | append: block.settings.category | append: '|||' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign categories_array = categories | split: '|||' | uniq -%}

    {%- if categories_array.size > 0 -%}
      <div class="km-faq__filters">
        <span class="km-faq__filter-btn active" data-filter="all">ALL</span>

        {%- for category in categories_array -%}
          {%- if category != blank -%}
            <span class="km-faq__filter-btn" data-filter="{{ category | handleize }}">{{ category }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="km-faq__list">
      {%- for block in section.blocks -%}
        <details
          class="km-faq__item extra-primary-border-radius"
          data-category="{{ block.settings.category | handleize }}"
          {% if section.settings.open_first and forloop.first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="km-faq__question">
            <span class="km-faq__question-text h5">
              {{- block.settings.question | escape -}}
            </span>
            <span class="km-faq__icon primary-border-radius" aria-hidden="true">
              <svg
                class="plus"
                width="11"
                height="11"
                viewBox="0 0 11 11"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M0.75 5.41667L10.0833 5.41667M5.41667 0.75L5.41667 10.0833" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <svg
                class="minus"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M3.33398 8L12.6673 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <div class="km-faq__answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const filterBtns = document.querySelectorAll('.km-faq__filter-btn');
    const faqItems = document.querySelectorAll('.km-faq__item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        // Remove active class from all buttons
        filterBtns.forEach((b) => b.classList.remove('active'));
        // Add active class to clicked button
        this.classList.add('active');

        const filterValue = this.getAttribute('data-filter');

        faqItems.forEach((item) => {
          if (filterValue === 'all') {
            item.style.display = 'block';
          } else {
            if (item.getAttribute('data-category') === filterValue) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "KM FAQ Accordion",
  "tag": "section",
  "class": "km-faq-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you start"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Sub text",
      "default": "Everything people usually ask before switching to a day-and-night oral care system."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "color",
      "id": "card_bg_color_day",
      "label": "Card Background Color (Day)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "color",
      "id": "card_bg_color_night",
      "label": "Card Background Color (Night)",
      "default": "#191f38"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "info": "Used for filtering (e.g. THE SYSTEM). Leave blank if no filter is needed."
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Why two formulas instead of one?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Because your mouth doesn’t do the same job all day. Daytime is exposure — acids, sugars, coffee — so Awake protects, activates and brightens. Night is repair — saliva drops and your body regenerates — so Asleep soothes, rebalances and remineralises while you sleep.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KM FAQ Accordion",
      "blocks": [{ "type": "faq_item" }]
    }
  ]
}
{% endschema %}
