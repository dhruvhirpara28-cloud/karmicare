{{ 'section-hero-karmicare.css' | asset_url | stylesheet_tag: preload: true }}

{%- style -%}
  #shopify-section-{{ section.id }} .hero-karmicare {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    transition: color 0.4s ease;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hero-karmicare {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        {%- if block.settings.heading_color_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__heading-{{ block.id }} {
            color: {{ block.settings.heading_color_day }};
          }
        {%- endif -%}
        {%- if block.settings.heading_color_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__heading-{{ block.id }} {
            color: {{ block.settings.heading_color_night }};
          }
        {%- endif -%}
        {%- if block.settings.bold_opacity != blank -%}
          #shopify-section-{{ section.id }} .hero-karmicare__heading-{{ block.id }} strong,
          #shopify-section-{{ section.id }} .hero-karmicare__heading-{{ block.id }} b {
            opacity: {{ block.settings.bold_opacity | divided_by: 100.0 }};
          }
        {%- endif -%}

      {%- when 'text' -%}
        {%- if block.settings.text_color_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__text-{{ block.id }} {
            color: {{ block.settings.text_color_day }};
          }
        {%- endif -%}
        {%- if block.settings.text_color_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__text-{{ block.id }} {
            color: {{ block.settings.text_color_night }};
          }
        {%- endif -%}
      {%- when 'image' -%}
        {%- if block.settings.blob_bg_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__blob-{{ block.id }} {
            background: {{ block.settings.blob_bg_day }};
          }
        {%- endif -%}
        {%- if block.settings.blob_bg_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__blob-{{ block.id }} {
            background: {{ block.settings.blob_bg_night }};
          }
        {%- endif -%}

      {%- when 'rhythm_toggle' -%}
        {%- if block.settings.block_bg_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__toggle-wrapper-{{ block.id }} {
            background: {{ block.settings.block_bg_day }};
          }
        {%- endif -%}
        {%- if block.settings.block_bg_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__toggle-wrapper-{{ block.id }} {
            background: {{ block.settings.block_bg_night }};
          }
        {%- endif -%}

        {%- if block.settings.pill_bg_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__pill-toggle-{{ block.id }} {
            background: {{ block.settings.pill_bg_day }};
          }
        {%- endif -%}
        {%- if block.settings.pill_bg_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__pill-toggle-{{ block.id }} {
            background: {{ block.settings.pill_bg_night }};
          }
        {%- endif -%}

        {%- if block.settings.pill_active_bg_day != blank or block.settings.pill_active_text_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__pill-toggle-{{ block.id }} .kc_day {
            {%- if block.settings.pill_active_bg_day != blank -%}background-color: {{ block.settings.pill_active_bg_day }};{%- endif -%}
            {%- if block.settings.pill_active_text_day != blank -%}color: {{ block.settings.pill_active_text_day }};{%- endif -%}
          }
        {%- endif -%}
        {%- if block.settings.pill_inactive_text_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__pill-toggle-{{ block.id }} .kc_night {
            color: {{ block.settings.pill_inactive_text_day }};
          }
        {%- endif -%}

        {%- if block.settings.pill_active_bg_night != blank or block.settings.pill_active_text_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__pill-toggle-{{ block.id }} .kc_night {
            {%- if block.settings.pill_active_bg_night != blank -%}background-color: {{ block.settings.pill_active_bg_night }};{%- endif -%}
            {%- if block.settings.pill_active_text_night != blank -%}color: {{ block.settings.pill_active_text_night }};{%- endif -%}
          }
        {%- endif -%}
        {%- if block.settings.pill_inactive_text_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__pill-toggle-{{ block.id }} .kc_day {
            color: {{ block.settings.pill_inactive_text_night }};
          }
        {%- endif -%}

        {%- if block.settings.status_color_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__status-text-{{ block.id }} {
            color: {{ block.settings.status_color_day }};
          }
        {%- endif -%}
        {%- if block.settings.status_color_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__status-text-{{ block.id }} {
            color: {{ block.settings.status_color_night }};
          }
        {%- endif -%}

      {%- when 'testimonial_badge' -%}
        {%- if block.settings.text_color_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__badge-{{ block.id }} {
            color: {{ block.settings.text_color_day }};
          }
        {%- endif -%}
        {%- if block.settings.text_color_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__badge-{{ block.id }} {
            color: {{ block.settings.text_color_night }};
          }
        {%- endif -%}
        {%- if block.settings.bg_color_day != blank -%}
          body.day-mode #shopify-section-{{ section.id }} .hero-karmicare__badge-{{ block.id }} {
            background-color: {{ block.settings.bg_color_day }};
            padding: 0.8rem 1.4rem;
          }
        {%- endif -%}
        {%- if block.settings.bg_color_night != blank -%}
          body.night-mode #shopify-section-{{ section.id }} .hero-karmicare__badge-{{ block.id }} {
            background-color: {{ block.settings.bg_color_night }};
            padding: 0.8rem 1.4rem;
          }
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endstyle -%}

{%- comment -%} Translated defaults; t output is escaped, so settings join them with escape_once {%- endcomment -%}
{%- assign hero_label_default = 'kc.hero.aria_label' | t -%}
<div
  id="HeroKarmicare-{{ section.id }}"
  class="hero-karmicare kc-surface"
  data-kc-surface="{{ section.settings.surface }}"
  aria-label="{{ section.settings.accessibility_label | default: hero_label_default | escape_once }}"
>
  <div class="page-width hero-karmicare__container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <div class="hero-karmicare__heading-wrapper" {{ block.shopify_attributes }}>
            {%- assign heading_tag = block.settings.heading_tag | default: 'h1' -%}
            <{{ heading_tag }} class="hero-karmicare__heading hero-karmicare__heading-{{ block.id }}">
              {{ block.settings.heading }}
            </{{ heading_tag }}>
          </div>

        {%- when 'text' -%}
          <div class="hero-karmicare__text-wrapper" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <p class="hero-karmicare__text text-xl hero-karmicare__text-{{ block.id }}">
                {{ block.settings.text | escape }}
              </p>
            {%- endif -%}
          </div>

        {%- when 'buttons' -%}
          <div class="hero-karmicare__buttons-wrapper" {{ block.shopify_attributes }}>
            {%- if block.settings.button_label_1 != blank -%}
              <a
                href="{{ block.settings.button_link_1 | default: '#' }}"
                class="hero-karmicare__btn hero-karmicare__btn-1 karmicare__btn-primary"
                {% if block.settings.button_link_1 == blank %}
                  role="button" aria-disabled="true"
                {% endif %}
              >
                {{ block.settings.button_label_1 | escape }}
              </a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              {%- liquid
                # Same as the badge: a section anchor is rebuilt on this template's id
                assign button_link_2 = block.settings.button_link_2
                if button_link_2 contains '#shopify-section-template--'
                  assign button_template = section.id | split: '__' | first
                  assign button_target = button_link_2 | split: '__' | last
                  assign button_link_2 = '#shopify-section-' | append: button_template | append: '__' | append: button_target
                endif
              -%}
              <a
                href="{{ button_link_2 | default: '#' }}"
                class="hero-karmicare__btn hero-karmicare__btn-2 karmicare__btn-secondary"
                {% if block.settings.button_link_2 == blank %}
                  role="button" aria-disabled="true"
                {% endif %}
              >
                {{ block.settings.button_label_2 | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- when 'image' -%}
          <figure class="hero-karmicare__image-wrapper" {{ block.shopify_attributes }}>
            <div
              class="
                hero-karmicare__blob
                hero-karmicare__blob-{{ block.id }}
              "
              aria-hidden="true"
            >
              &nbsp;
            </div>
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign hero_alt_default = 'kc.hero.image_alt' | t
                assign hero_alt = block.settings.image.alt | default: hero_alt_default | escape_once
                assign hero_image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              -%}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  width: block.settings.image.width,
                  height: hero_image_height,
                  loading: 'eager',
                  fetchpriority: 'high',
                  decoding: 'async',
                  preload: true,
                  sizes: '(min-width: 990px) 900px, 92vw',
                  widths: '375, 550, 750, 840, 1100, 1400, 1800',
                  class: 'hero-karmicare__image',
                  alt: hero_alt
              }}
            {%- else -%}
              <div class="hero-karmicare__image-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero-karmicare__placeholder-svg' }}
              </div>
            {%- endif -%}
          </figure>

        {%- when 'rhythm_toggle' -%}
          <div
            class="hero-karmicare__toggle-wrapper hero-karmicare__toggle-wrapper-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <div
              class="hero-karmicare__pill-toggle hero-karmicare__pill-toggle-{{ block.id }}"
              role="group"
              aria-label="{{ 'kc.hero.switcher_label' | t }}"
            >
              {%- liquid
                assign hero_awake_name = block.settings.awake_label | default: 'Awake'
                assign hero_asleep_name = block.settings.asleep_label | default: 'Asleep'
              -%}
              <button
                type="button"
                class="
                  body-gl-nunito-xsm  hero-karmicare__pill-btn
                  kc_day
                "
                data-mode="day"
                aria-label="{{ 'kc.hero.mode_label' | t: label: hero_awake_name }}"
              >
                {{ block.settings.awake_label | default: 'AWAKE' | escape }}
              </button>
              <button
                type="button"
                class="body-gl-nunito-xsm hero-karmicare__pill-btn kc_night"
                data-mode="night"
                aria-label="{{ 'kc.hero.mode_label' | t: label: hero_asleep_name }}"
              >
                {{ block.settings.asleep_label | default: 'ASLEEP' | escape }}
              </button>
            </div>

            <div class="hero-karmicare__status-wrapper">
              <p
                class="
                  body-gl-nunito-xsm
                  hero-karmicare__status-text
                  hero-karmicare__status-text-{{ block.id }}
                "
              >
                <time
                  class="kc-hero-live-time"
                  datetime="          {{- 'now' | date: '%Y-%m-%dT%H:%M' -}}"
                >
                  {%- if request.locale.iso_code == 'en' -%}
                    {{- 'now' | date: '%-I:%M %p' -}}
                  {%- else -%}
                    {{- 'now' | date: '%H:%M' -}}
                  {%- endif -%}
                </time>
                ·
                <span class="kc-hero-status-day">
                  {{- block.settings.status_day_text | default: 'DAYTIME PROTECTION' | escape -}}
                </span>
                <span class="kc-hero-status-night">
                  {{- block.settings.status_night_text | default: 'NIGHTTIME RESTORATION' | escape -}}
                </span>
              </p>
            </div>
          </div>

        {%- when 'testimonial_badge' -%}
          <div
            class="hero-karmicare__badge-wrapper hero-karmicare__badge-wrapper-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {%- liquid
              # A section anchor carries the template id, which differs per theme copy: point it at this template
              assign badge_link = block.settings.link
              if badge_link contains '#shopify-section-template--'
                assign badge_template = section.id | split: '__' | first
                assign badge_target = badge_link | split: '__' | last
                assign badge_link = '#shopify-section-' | append: badge_template | append: '__' | append: badge_target
              endif
            -%}
            {%- if badge_link != blank -%}
              <a
                href="{{ badge_link }}"
                class="hero-karmicare__badge hero-karmicare__badge-{{ block.id }}"
                aria-label="{{ block.settings.heading | default: 'Backed by health professionals' | escape }}"
              >
            {%- else -%}
              <div class="hero-karmicare__badge hero-karmicare__badge-{{ block.id }}">
            {%- endif -%}
            <div
              class="hero-karmicare__badge-avatar-wrap"
              {% if block.settings.rotate_professionals %}
                data-kc-rotate
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 168
                  | image_tag:
                    class: 'hero-karmicare__badge-avatar',
                    loading: 'eager',
                    fetchpriority: 'high',
                    decoding: 'async',
                    width: 56,
                    height: 72,
                    widths: '56, 112, 168',
                    sizes: '56px',
                    alt: block.settings.heading
                  | default: 'Health professional'
                  | escape
                }}
              {%- else -%}
                <div class="hero-karmicare__badge-avatar hero-karmicare__badge-avatar--placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
              {%- if block.settings.rotate_professionals -%}
                <script>
                  // The photo hides until the section script has picked an ambassador, so the block
                  // image does not flash first. Without JavaScript this never runs and the block image
                  // stays; if the section script never picks, it shows again after 3s.
                  (function (wrap) {
                    wrap.classList.add('is-picking');
                    setTimeout(function () {
                      wrap.classList.remove('is-picking');
                    }, 3000);
                  })(document.currentScript.parentElement);
                </script>
              {%- endif -%}
            </div>

            <div class="hero-karmicare__badge-content">
              {%- if block.settings.rating_text != blank -%}
                <div class="hero-karmicare__badge-rating">
                  <svg
                    class="hero-karmicare__badge-star"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M8.91749 0H6.91749L5.4304 4.57681L0.618034 4.57682L0 6.47893L3.89329 9.30756L2.40621 13.8843L4.02425 15.0599L7.9175 12.2313L11.8108 15.0599L13.4288 13.8843L11.9417 9.30754L15.835 6.47892L15.2169 4.57681H10.4046L8.91749 0Z" fill="{{ block.settings.star_color | default: '#7FB9FF' }}"/>
                  </svg>
                  <span class="hero-karmicare__badge-rating-text">{{ block.settings.rating_text | escape }}</span>
                </div>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <div class="hero-karmicare__badge-heading-wrap">
                  {%- liquid
                    # The last word and the arrow stay on one line, so the arrow never wraps alone
                    assign heading_words = block.settings.heading | escape | split: ' '
                    assign heading_lead_count = heading_words.size | minus: 1
                  -%}
                  <span class="hero-karmicare__badge-heading text-xl">
                    {%- for word in heading_words limit: heading_lead_count -%}
                      {{ word }}{{ ' ' }}
                    {%- endfor -%}
                    <span class="hero-karmicare__badge-heading-end">
                    {{- heading_words | last -}}
                    {{ ' ' }}
                    <svg
                      class="hero-karmicare__badge-arrow"
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M3.33398 8.00004H12.6673M8.00065 12.6667L12.6673 8.00004L8.00065 3.33337" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    </span>
                  </span>
                </div>
              {%- endif -%}
            </div>
            {%- if badge_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
            {%- if block.settings.rotate_professionals -%}
              {%- comment -%}
                Pauses the ambassador rotation (WCAG 2.2.2), on the photo's corner; outside the link, as
                a button may not sit inside one. Shown by the section script only while it rotates.
              {%- endcomment -%}
              <button
                type="button"
                class="hero-karmicare__badge-pause"
                data-label-pause="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
                data-label-play="{{ 'sections.slideshow.play_slideshow' | t | escape }}"
                aria-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
                hidden
              >
                <svg
                  class="hero-karmicare__badge-pause-icon hero-karmicare__badge-pause-icon--pause"
                  xmlns="http://www.w3.org/2000/svg"
                  width="10"
                  height="10"
                  viewBox="0 0 10 10"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M2.5 1.5v7M7.5 1.5v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                <svg
                  class="hero-karmicare__badge-pause-icon hero-karmicare__badge-pause-icon--play"
                  xmlns="http://www.w3.org/2000/svg"
                  width="10"
                  height="10"
                  viewBox="0 0 10 10"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M3 1.6v6.8L8.6 5z" fill="currentColor"/>
                </svg>
              </button>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    // The time under the toggle (Victor, 23 Oct): the live time while the page follows the sun.
    // Switched by hand to the other mode, it rolls to that ritual's hour, 07:00 for Awake and
    // 22:00 for Asleep (the clock section's hours), and back to the live time once the mode
    // matches the sun again. Each language writes time its own way: 7:00 AM in EN, 07:00 in NL
    // and FR. Screen readers get the plain time; the rolling digits are hidden from them.
    var heroLocale = '{{ request.locale.iso_code }}';
    var heroTimeFormat = new Intl.DateTimeFormat(heroLocale, {
      hour: heroLocale === 'en' ? 'numeric' : '2-digit',
      minute: '2-digit',
    });
    function heroTime() {
      var date = new Date();
      var shown = document.body.classList.contains('night-mode') ? 'night' : 'day';
      if (window.KCDayNight && window.KCDayNight.state().mode !== shown) date.setHours(shown === 'day' ? 7 : 22, 0, 0, 0);
      return date;
    }
    function rollTo(element, text, animate) {
      var roll = element.querySelector('.kc-roll');
      var label = element.querySelector('.visually-hidden');
      var previous = label ? label.textContent : '';
      var chars = roll ? roll.children : [];
      // A new shape (length or digit places changed, 9:59 to 10:00): rebuild, with each digit
      // starting from the previous time's digit in the same place from the right, so it still rolls
      var same =
        roll &&
        chars.length === text.length &&
        Array.prototype.every.call(chars, function (char, i) {
          return char.hasAttribute('data-digit') === /\d/.test(text[i]);
        });
      if (!same) {
        label = document.createElement('span');
        label.className = 'visually-hidden';
        roll = document.createElement('span');
        roll.className = 'kc-roll is-still';
        roll.setAttribute('aria-hidden', 'true');
        text.split('').forEach(function (character, i) {
          var char = document.createElement('span');
          char.className = 'kc-roll__char';
          if (/\d/.test(character)) {
            var from = previous[i - text.length + previous.length];
            char.setAttribute('data-digit', '');
            char.style.setProperty('--kc-roll-digit', /\d/.test(from) ? from : character);
            char.innerHTML = '<span class="kc-roll__strip">' + '0123456789'.split('').join('<br>') + '</span>';
          }
          roll.append(char);
        });
        element.replaceChildren(label, roll);
        void roll.offsetWidth;
      }
      label.textContent = text;
      roll.classList.toggle('is-still', !animate);
      Array.prototype.forEach.call(roll.children, function (char, i) {
        if (char.hasAttribute('data-digit')) char.style.setProperty('--kc-roll-digit', text[i]);
        else char.textContent = text[i];
      });
    }
    function updateHeroLiveTime(animate) {
      var timeElements = document.querySelectorAll('#HeroKarmicare-{{ section.id }} .kc-hero-live-time');
      if (!timeElements.length) return;
      var date = heroTime();
      var text = heroTimeFormat.format(date);
      var stamp = String(date.getHours()).padStart(2, '0') + ':' + String(date.getMinutes()).padStart(2, '0');
      timeElements.forEach(function (element) {
        element.setAttribute('datetime', stamp);
        rollTo(element, text, animate === true);
      });
    }
    updateHeroLiveTime(false);
    setInterval(function () {
      updateHeroLiveTime(true);
    }, 30000);
    new MutationObserver(function () {
      updateHeroLiveTime(true);
    }).observe(document.body, { attributes: true, attributeFilter: ['class'] });

    // The hero fills the first screen below the announcement bar and header: pass their
    // height (the hero's distance from the page top) to the CSS as --hero-offset
    var hero = document.getElementById('HeroKarmicare-{{ section.id }}');
    function updateHeroOffset() {
      if (!hero) return;
      var offset = Math.max(0, hero.getBoundingClientRect().top + window.scrollY);
      hero.style.setProperty('--hero-offset', offset + 'px');
    }
    updateHeroOffset();
    window.addEventListener('load', updateHeroOffset);
    window.addEventListener('resize', updateHeroOffset, { passive: true });

    // Ambassador rotation in the badge (Victor, 23 Oct): all ambassadors from the Trusted
    // Professionals cards on this page in random order, a new photo 3s after the last one showed;
    // after the last a new random round starts, never with the photo just shown. It runs past
    // five seconds, so the pause button next to the photo stops it until the visitor plays it
    // again (WCAG 2.2.2). It also waits while the badge is hovered or focused, off screen or in a
    // hidden tab, and goes on when that ends. Reduced motion keeps the random
    // first photo, without rotation or button. Below 750px the badge is hidden, and without cards
    // the block's own image stays. One transition at a time: every reschedule or stop starts a
    // new generation, so a photo that finishes loading for an older schedule changes nothing.
    var wrap = hero && hero.querySelector('.hero-karmicare__badge-avatar-wrap[data-kc-rotate]');
    function startRotation() {
      var current = wrap.querySelector('.hero-karmicare__badge-avatar');
      var cards = document.querySelectorAll(
        '.trusted-professionals__card:not([data-marquee-clone]) .trusted-professionals__card-image img'
      );
      if (!current || current.tagName !== 'IMG' || !cards.length || !window.matchMedia('(min-width: 750px)').matches) {
        wrap.classList.remove('is-picking');
        return;
      }
      // The badge's 56px avatar at up to 3x: the card image's CDN URL at 168px wide
      var urls = Array.prototype.map.call(cards, function (img) {
        var url = new URL(img.getAttribute('src'), window.location.href);
        url.searchParams.set('width', '168');
        return url.href;
      });
      // A random order of all photos; a new round never starts with the photo just shown
      function shuffled(avoidFirst) {
        var order = urls.slice();
        for (var i = order.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var swap = order[i];
          order[i] = order[j];
          order[j] = swap;
        }
        if (avoidFirst && order.length > 1 && order[0] === avoidFirst) {
          var k = 1 + Math.floor(Math.random() * (order.length - 1));
          order[0] = order[k];
          order[k] = avoidFirst;
        }
        return order;
      }
      var round = shuffled();
      var upcoming = null; // the next round, made once the current one is at its end
      var position = -1; // the photo showing in this round; -1 while the block's own image shows
      function peek() {
        if (position + 1 < round.length) return round[position + 1];
        if (!upcoming) upcoming = shuffled(round[round.length - 1]);
        return upcoming[0];
      }
      function advance() {
        if (position + 1 < round.length) {
          position += 1;
        } else {
          round = upcoming || shuffled(round[round.length - 1]);
          upcoming = null;
          position = 0;
        }
      }
      // Each photo loads once: true when it loaded, false when it failed
      var loads = {};
      function load(url) {
        if (!loads[url]) {
          loads[url] = new Promise(function (resolve) {
            var image = new Image();
            image.onload = function () {
              resolve(true);
            };
            image.onerror = function () {
              resolve(false);
            };
            image.src = url;
          });
        }
        return loads[url];
      }
      var next = current.cloneNode(false);
      [current, next].forEach(function (img) {
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        // Decorative: the badge's link and heading carry its name (R49 N2)
        img.alt = '';
      });
      next.classList.add('hero-karmicare__badge-avatar--next', 'is-hidden');
      wrap.append(next);
      wrap.setAttribute('aria-hidden', 'true');

      var layers = [current, next];
      var active = 0;
      var generation = 0;
      var timer;
      var hovered = false;
      var focused = false;
      var pausedByVisitor = false;
      var visible = false; // until the observer's first report
      var stopped = false;
      var picked = false; // the first photo (or the block's own image) is showing
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var badgeWrapper = wrap.closest('.hero-karmicare__badge-wrapper');
      var pauseButton = badgeWrapper.querySelector('.hero-karmicare__badge-pause');

      // The button shows only while there is something to pause: more than one photo and no
      // reduced motion
      function updateButton() {
        if (!pauseButton) return;
        pauseButton.hidden = stopped || reducedMotion.matches || urls.length < 2;
        pauseButton.classList.toggle('is-paused', pausedByVisitor);
        pauseButton.setAttribute(
          'aria-label',
          pausedByVisitor ? pauseButton.dataset.labelPlay : pauseButton.dataset.labelPause
        );
      }

      function show(url) {
        var incoming = layers[1 - active];
        var outgoing = layers[active];
        incoming.src = url;
        incoming.classList.remove('is-hidden', 'is-above');
        incoming.classList.add('is-below');
        void incoming.offsetWidth;
        incoming.classList.remove('is-below');
        outgoing.classList.add('is-above');
        active = 1 - active;
      }

      // The next photo 3s after the last one showed, loaded ahead; a failed one is skipped and the
      // one after it gets its own 3s. Waiting (paused, off screen, hidden tab) clears the timer;
      // going on starts a fresh 3s.
      function schedule() {
        clearTimeout(timer);
        generation += 1;
        updateButton();
        if (stopped || !picked || reducedMotion.matches || urls.length < 2) return;
        if (pausedByVisitor || hovered || focused || !visible || document.hidden) return;
        var token = generation;
        var target = peek();
        load(target);
        timer = setTimeout(function () {
          load(target).then(function (ok) {
            if (token !== generation || target !== peek()) return;
            advance();
            if (ok) show(target);
            schedule();
          });
        }, 3000);
      }

      // The first photo once it has loaded; after 1.5s, or if it failed, the block's own image
      // shows and the first ambassador follows in the rotation
      Promise.race([
        load(round[0]),
        new Promise(function (resolve) {
          setTimeout(resolve, 1500, false);
        }),
      ]).then(function (ok) {
        if (stopped) return;
        if (ok) {
          advance();
          current.src = round[0];
          current.classList.add('is-below');
        }
        wrap.classList.remove('is-picking');
        void current.offsetWidth;
        current.classList.remove('is-below');
        picked = true;
        schedule();
      });

      // Hover and focus on the badge itself hold the rotation; the pause button does not, so a
      // click on play starts it at once (the WAI carousel pattern)
      var badge = wrap.closest('.hero-karmicare__badge');
      badge.addEventListener('mouseenter', function () {
        hovered = true;
        schedule();
      });
      badge.addEventListener('mouseleave', function () {
        hovered = false;
        schedule();
      });
      badge.addEventListener('focusin', function () {
        focused = true;
        schedule();
      });
      badge.addEventListener('focusout', function (event) {
        focused = badge.contains(event.relatedTarget);
        schedule();
      });
      if (pauseButton) {
        pauseButton.addEventListener('click', function () {
          pausedByVisitor = !pausedByVisitor;
          schedule();
        });
      }
      var observer = new IntersectionObserver(function (entries) {
        visible = entries[entries.length - 1].isIntersecting;
        schedule();
      });
      observer.observe(wrap);
      document.addEventListener('visibilitychange', schedule);
      reducedMotion.addEventListener('change', schedule);
      updateButton();

      // Theme editor: a re-rendered section runs its own copy of this script, so this one stops
      // and lets go of its timer, observer and listeners (R49 N3)
      function dispose(event) {
        if (event.detail.sectionId !== '{{ section.id }}') return;
        stopped = true;
        clearTimeout(timer);
        generation += 1;
        observer.disconnect();
        document.removeEventListener('visibilitychange', schedule);
        reducedMotion.removeEventListener('change', schedule);
        document.removeEventListener('shopify:section:unload', dispose);
      }
      document.addEventListener('shopify:section:unload', dispose);
    }
    if (wrap) {
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startRotation);
      else startRotation();
    }
  })();
</script>

