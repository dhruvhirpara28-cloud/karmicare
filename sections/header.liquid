<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- comment -%} Render-blocking: the "Coming soon" tooltips must be hidden before the menu paints {%- endcomment -%}
{{ 'kc-coming-soon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kc-coming-soon.js' | asset_url }}" defer="defer"></script>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- style -%}
  header-drawer {
    justify-self: start;
  }
  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper { width: 75%; }
  {%- endif -%}
  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer { display: none; }
    }
  {%- endif -%}
  .menu-drawer-container { display: flex; }
  .list-menu { list-style: none; padding: 0; margin: 0; }
  .list-menu--inline { display: inline-flex; flex-wrap: wrap; }
  summary.list-menu__item { padding-right: 2.7rem; }
  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }
  .list-menu__item--link {
    text-decoration: none;
    padding: 0.5rem 0;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  .section-header {
    position: sticky;
    top: 0;
    z-index: 100;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  #shopify-section-{{ section.id }} .header {
    border-radius: var(--kc-shape-radius-sm);
    max-width: 1200px;
    margin: 1.2rem auto;
    align-items: center;
  }
  @media screen and (max-width: 1199px){
    #shopify-section-{{ section.id }} .header {
      margin-left: 1.2rem;
      margin-right: 1.2rem;
    }
  }

  /* BEGIN NOW: KC/Button, Nunito Bold 12/12, 16px sides; 44px tall on desktop, 40px on mobile */
  #shopify-section-{{ section.id }} .header__cta-btn {
    min-height: 4.4rem;
    padding: 0 1.6rem;
  }

  /* Desktop: compact centred glass bar (Figma KC_navigation) */
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .header {
      display: flex;
      align-items: center;
      gap: 3px;
      width: fit-content;
      max-width: calc(100% - 2.4rem);
      /* 16px lower than the setting (Victor, 20 Oct) */
      margin: calc({{ section.settings.padding_top }}px + 1.6rem) auto {{ section.settings.padding_bottom }}px;
      padding: var(--kc-responsive-spacing-layout-xxs);
      {%- if section.settings.enable_glass_blur %}
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
      {%- endif %}
    }
    #shopify-section-{{ section.id }} .header__heading-link {
      display: flex;
      align-items: center;
      margin: 0;
      padding: 0.8rem 1.6rem;
    }
    #shopify-section-{{ section.id }} .header__inline-menu {
      display: flex;
    }
    #shopify-section-{{ section.id }} .header__inline-menu .list-menu--inline {
      flex-wrap: nowrap;
      gap: 3px;
      align-items: center;
    }
    #shopify-section-{{ section.id }} .header__inline-menu .header__menu-item {
      min-height: 4.4rem;
      padding: 0 1.2rem;
      border-radius: var(--primary-border-radius);
      font-family: var(--font-body-family);
      font-weight: var(--font-600-weight);
      font-size: 1.5rem;
      line-height: 2rem;
      letter-spacing: 0;
      white-space: nowrap;
      text-decoration: none;
      transition: background-color 0.15s ease-out;
    }
    #shopify-section-{{ section.id }} .header__inline-menu summary.header__menu-item {
      padding-right: 2.7rem;
    }
    /* Hover fills the whole 44px cell with an opaque KC surface, so it reads on any page behind the glass */
    #shopify-section-{{ section.id }} .header__inline-menu .header__menu-item:not(.kc-coming-soon):hover {
      background-color: var(--kc-mapped-surface-primary-default-hover);
    }
    #shopify-section-{{ section.id }} .header__icons {
      display: flex;
      align-items: center;
      gap: 3px;
    }
    #shopify-section-{{ section.id }} .desktop-localization-wrapper:empty {
      display: none;
    }
  }

  /* Menu links that point to # (no page yet) use the shared "Coming soon" pattern
     (snippets/kc-coming-soon.liquid, assets/kc-coming-soon.css and .js); the drawer
     placement overrides are further down */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .header__menu-item {
      transition: none !important;
    }
  }

  /* Mobile and tablet: glass bar per Figma "Navigation · Mobile" (2766:10918), 4px below the
     announcement bar plus 16px (Victor, 20 Oct), 4px padding, logo cell 16/8, BEGIN NOW and the
     menu button 3px apart.
     The open menu drops down from the bar as one panel on the same surface. */
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .header__inline-menu {
      display: none !important;
    }
    #shopify-section-{{ section.id }} .header {
      display: flex;
      align-items: center;
      margin-top: 2rem;
      padding: 0.4rem;
      position: relative;
      z-index: 100;
      {%- if section.settings.enable_glass_blur %}
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
      {%- endif %}
    }

    /* Paints the bar surface above the menu overlay (Dawn draws the overlay inside the header) */
    #shopify-section-{{ section.id }} .header::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--kc-shape-radius-sm);
      z-index: -1;
    }

    /* Open menu: bar and panel form one box */
    #shopify-section-{{ section.id }}:has(details[open]) .header,
    #shopify-section-{{ section.id }}:has(details[open]) .header::before {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    #shopify-section-{{ section.id }} .header__heading {
      order: 1;
      margin-right: auto;
    }
    #shopify-section-{{ section.id }} .header__heading-link {
      display: flex;
      align-items: center;
      margin: 0;
      padding: 0.8rem 1.6rem;
    }
    #shopify-section-{{ section.id }} .header__heading-logo-svg svg {
      width: 105px;
    }
    #shopify-section-{{ section.id }} .header__icons {
      order: 2;
      align-self: stretch;
      align-items: stretch;
      padding: 0;
    }
    #shopify-section-{{ section.id }} header-drawer {
      order: 3;
      display: flex;
      margin-left: var(--kc-responsive-spacing-layout-xxs);
    }

    #shopify-section-{{ section.id }} .header__cta-btn {
      min-height: 4rem;
      margin: 0;
    }

    /* KC/Button, icon only: accent subtle surface, control border, 16px glyph */
    #shopify-section-{{ section.id }} .header__icon--menu {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 4rem;
      height: 4rem;
      padding: 0;
      background-color: var(--kc-mapped-surface-accent-default-subtle);
      border: var(--kc-shape-stroke-thin) solid var(--kc-mapped-border-control-default);
      border-radius: var(--kc-shape-radius-sm);
      color: var(--kc-mapped-text-accent-default-on-accent);
    }
    #shopify-section-{{ section.id }} .header__icon--menu:focus-visible {
      outline: 2px solid var(--kc-mapped-border-focus-default);
      outline-offset: 2px;
    }
    #shopify-section-{{ section.id }} .header__icon--menu > span {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 1.6rem;
      height: 1.6rem;
    }
    #shopify-section-{{ section.id }} .header__icon--menu .icon-hamburger {
      width: 13px;
      height: 10px;
    }
    #shopify-section-{{ section.id }} .header__icon--menu .icon.icon-close {
      width: 1.1rem;
      height: 1.1rem;
    }

    /* Menu panel */
    #shopify-section-{{ section.id }} .menu-drawer {
      display: none;
    }
    #shopify-section-{{ section.id }} details[open] .menu-drawer,
    #shopify-section-{{ section.id }} details[open].menu-opening .menu-drawer {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: auto;
      max-height: calc(100vh - 12rem);
      overflow-y: auto;
      box-sizing: border-box;
      margin: 0;
      padding: 0 0.4rem 1.2rem;
      border: none;
      border-radius: 0 0 var(--kc-shape-radius-sm) var(--kc-shape-radius-sm);
      transform: none;
      visibility: visible;
    }
    #shopify-section-{{ section.id }} .menu-drawer__inner-container,
    #shopify-section-{{ section.id }} .menu-drawer__navigation-container {
      height: auto;
    }
    #shopify-section-{{ section.id }} .menu-drawer__navigation {
      padding: 0;
    }
    #shopify-section-{{ section.id }} .menu-drawer__menu {
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .menu-drawer__menu li {
      margin: 0;
    }
    /* Links: the mobile footer link style (body/lg Semibold), 44px rows, text aligned with the logo */
    #shopify-section-{{ section.id }} .menu-drawer__menu-item {
      display: flex;
      align-items: center;
      min-height: 4.4rem;
      margin: 0;
      padding: 0 1.6rem;
      border-radius: var(--kc-shape-radius-sm);
      font-family: var(--kc-font-role-backbone);
      font-weight: var(--font-600-weight);
      font-size: var(--kc-responsive-body-lg-text-size);
      line-height: var(--kc-responsive-body-lg-line-height);
      letter-spacing: var(--kc-responsive-body-lg-letter-spacing);
      text-decoration: none;
    }
    #shopify-section-{{ section.id }} .menu-drawer__menu-item:focus-visible {
      outline: 2px solid var(--kc-mapped-border-focus-default);
      outline-offset: -2px;
    }
    /* Same hover surface as the desktop links (Dawn's 4% tint is near invisible on the panel) */
    #shopify-section-{{ section.id }} .menu-drawer__menu-item:hover,
    #shopify-section-{{ section.id }} .menu-drawer__menu-item:focus {
      background-color: var(--kc-mapped-surface-primary-default-hover);
    }
    #shopify-section-{{ section.id }} .menu-drawer__menu-item.kc-coming-soon:hover,
    #shopify-section-{{ section.id }} .menu-drawer__menu-item.kc-coming-soon:focus {
      background-color: transparent;
    }
    /* "Coming soon" sits next to the label in the panel row */
    #shopify-section-{{ section.id }} .menu-drawer__menu-item.kc-coming-soon {
      gap: var(--kc-responsive-spacing-layout-xs);
    }
    #shopify-section-{{ section.id }} .menu-drawer .kc-coming-soon__tip {
      position: static;
      transform: none;
      translate: -4px 0;
    }
    #shopify-section-{{ section.id }} .menu-drawer .kc-coming-soon__tip::before {
      content: none;
    }
    /* Shown tooltip slides back to 0, above the -4px rest position (the shared shown-state
       rules in kc-coming-soon.css carry no section id, so they cannot outrank it) */
    #shopify-section-{{ section.id }} .menu-drawer .kc-coming-soon:focus-visible .kc-coming-soon__tip,
    #shopify-section-{{ section.id }} .menu-drawer .kc-coming-soon.is-open .kc-coming-soon__tip {
      translate: 0 0;
    }
    @media (hover: hover) {
      #shopify-section-{{ section.id }} .menu-drawer .kc-coming-soon:hover .kc-coming-soon__tip {
        translate: 0 0;
      }
    }
    #shopify-section-{{ section.id }} .menu-drawer__utility-links {
      display: none;
    }
  }

  /* ── SECTION BACKGROUND (from section schema settings) ── */
  {%- if section.settings.section_bg_color_day != blank -%}
    body.day-mode #shopify-section-{{ section.id }},
    body.day-mode #shopify-section-{{ section.id }} .header-wrapper {
      background-color: {{ section.settings.section_bg_color_day }};
    }
  {%- endif -%}
  {%- if section.settings.section_bg_color_night != blank -%}
    body.night-mode #shopify-section-{{ section.id }},
    body.night-mode #shopify-section-{{ section.id }} .header-wrapper {
      background-color: {{ section.settings.section_bg_color_night }};
    }
  {%- endif -%}

  /* ── DAY MODE COLORS (from section schema settings) ── */
  {%- if section.settings.bg_color_day != blank -%}
    body.day-mode #shopify-section-{{ section.id }} .header,
    body.day-mode #shopify-section-{{ section.id }} .header::before,
    body.day-mode #shopify-section-{{ section.id }} details[open].menu-opening .menu-drawer {
      background-color: {{ section.settings.bg_color_day }};
    }
  {%- endif -%}
  {%- if section.settings.border_color_day != blank -%}
    body.day-mode #shopify-section-{{ section.id }} .header {
      border: 1px solid {{ section.settings.border_color_day }};
    }
  {%- endif -%}
  {%- if section.settings.text_color_day != blank -%}
    body.day-mode #shopify-section-{{ section.id }} .header,
    body.day-mode #shopify-section-{{ section.id }} .header a:not(.header__cta-btn) {
      color: {{ section.settings.text_color_day }};
      fill: {{ section.settings.text_color_day }};
    }
  {%- endif -%}

  /* ── NIGHT MODE COLORS (from section schema settings) ── */
  {%- if section.settings.bg_color_night != blank -%}
    body.night-mode #shopify-section-{{ section.id }} .header,
    body.night-mode #shopify-section-{{ section.id }} .header::before,
    body.night-mode #shopify-section-{{ section.id }} details[open].menu-opening .menu-drawer {
      background-color: {{ section.settings.bg_color_night }};
    }
  {%- endif -%}
  {%- if section.settings.border_color_night != blank -%}
    body.night-mode #shopify-section-{{ section.id }} .header {
      border: 1px solid {{ section.settings.border_color_night }};
    }
  {%- endif -%}
  {%- if section.settings.text_color_night != blank -%}
    body.night-mode #shopify-section-{{ section.id }} .header,
    body.night-mode #shopify-section-{{ section.id }} .header a:not(.header__cta-btn) {
      color: {{ section.settings.text_color_night }};
      fill: {{ section.settings.text_color_night }};
    }
  {%- endif -%}

  /* Smooth transition for background color changes (prevents jerk when returning to top) */
  #shopify-section-{{ section.id }} .header,
  #shopify-section-{{ section.id }} .header::before {
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  /* ── PRODUCT PAGE OVERRIDES ── */
  {% render 'product-header-css', section: section %}

  /* ── GLASS BACKGROUND (bar colour at reduced opacity, Figma surface/glass) ── */
  {%- liquid
    assign glass_alpha = section.settings.glass_opacity | divided_by: 100.0
    assign glass_bg_day = section.settings.bg_color_day
    assign glass_bg_night = section.settings.bg_color_night
    if template.name == 'product' or request.page_type == 'product'
      if section.settings.product_bg_color_day != blank
        assign glass_bg_day = section.settings.product_bg_color_day
      endif
      if section.settings.product_bg_color_night != blank
        assign glass_bg_night = section.settings.product_bg_color_night
      endif
    endif
  -%}
  @media screen and (min-width: 990px) {
    {%- if glass_bg_day != blank %}
      body.day-mode #shopify-section-{{ section.id }} .header {
        background-color: {{ glass_bg_day | color_modify: 'alpha', glass_alpha }};
      }
    {%- endif %}
    {%- if glass_bg_night != blank %}
      body.night-mode #shopify-section-{{ section.id }} .header {
        background-color: {{ glass_bg_night | color_modify: 'alpha', glass_alpha }};
      }
    {%- endif %}
  }
  /* Mobile: ::before paints the bar (it sits above Dawn's menu overlay). Glass while closed;
     opaque with the panel while the menu is open. The blur is dropped while open because a
     backdrop-filter would trap the fixed full-screen overlay inside the bar. */
  @media screen and (max-width: 989px) {
    body.day-mode #shopify-section-{{ section.id }} .header,
    body.night-mode #shopify-section-{{ section.id }} .header {
      background-color: transparent;
    }
    #shopify-section-{{ section.id }}:has(details[open]) .header {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    {%- if glass_bg_day != blank %}
      body.day-mode #shopify-section-{{ section.id }} .header::before {
        background-color: {{ glass_bg_day | color_modify: 'alpha', glass_alpha }};
      }
      body.day-mode #shopify-section-{{ section.id }}:has(details[open]) .header::before,
      body.day-mode #shopify-section-{{ section.id }} details[open] .menu-drawer {
        background-color: {{ glass_bg_day }};
      }
    {%- endif %}
    {%- if glass_bg_night != blank %}
      body.night-mode #shopify-section-{{ section.id }} .header::before {
        background-color: {{ glass_bg_night | color_modify: 'alpha', glass_alpha }};
      }
      body.night-mode #shopify-section-{{ section.id }}:has(details[open]) .header::before,
      body.night-mode #shopify-section-{{ section.id }} details[open] .menu-drawer {
        background-color: {{ glass_bg_night }};
      }
    {%- endif %}
  }

  /* ── CTA BUTTON COLORS (from section schema settings) ── */
  {%- if section.settings.btn_bg_day != blank or section.settings.btn_text_day != blank %}
    body:not(.night-mode) #shopify-section-{{ section.id }} .header__cta-btn {
      {%- if section.settings.btn_bg_day != blank %}
        background-color: {{ section.settings.btn_bg_day }};
      {%- endif %}
      {%- if section.settings.btn_text_day != blank %}
        color: {{ section.settings.btn_text_day }};
      {%- endif %}
    }
  {%- endif %}
  {%- if section.settings.btn_bg_night != blank or section.settings.btn_text_night != blank %}
    body.night-mode #shopify-section-{{ section.id }} .header__cta-btn {
      {%- if section.settings.btn_bg_night != blank %}
        background-color: {{ section.settings.btn_bg_night }};
      {%- endif %}
      {%- if section.settings.btn_text_night != blank %}
        color: {{ section.settings.btn_text_night }};
      {%- endif %}
    }
  {%- endif %}

  .header__heading-logo-wrapper--svg {
    display: inline-flex;
    align-items: center;
  }

  .header__heading-logo-svg {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    color: inherit;
  }

  .header__heading-logo-svg svg {
    width: {{ settings.logo_width }}px;
    height: auto;
    max-width: 100%;
    display: block;
    color: inherit;
  }

  .header__heading-logo-svg svg,
  .header__heading-logo-svg svg path,
  .header__heading-logo-svg svg [fill] {
    fill: currentColor;
    transition: fill 0.3s ease;
  }
{%- endstyle -%}

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif

  # The colour the first section arrives on (snippets/kc-surface.liquid). The bar paints its own
  # colour pickers: product_section_bg_color_* (the page colour) on product pages,
  # section_bg_color_* (the accent) everywhere else (sections/header-group.json).
  assign surface_edge = 'accent'
  if template.name == 'product' or request.page_type == 'product'
    assign surface_edge = 'page'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  data-kc-surface-edge="{{ surface_edge }}"
  class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">
    {%- liquid
      if section.settings.menu != blank
        render 'header-drawer'
      endif

      if section.settings.show_search
        if section.settings.logo_position == 'top-center' or section.settings.menu == blank
          render 'header-search', input_id: 'Search-In-Modal-1'
        endif
      endif
    -%}

    {%- if section.settings.logo_position != 'middle-center' -%}
      <div class="header__heading">
        <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
          {%- if settings.logo_svg != blank -%}
            <div class="header__heading-logo-wrapper header__heading-logo-wrapper--svg">
              <div class="header__heading-logo-svg">
                {{ settings.logo_svg }}
              </div>
            </div>
          {%- elsif settings.logo != blank -%}
            <div class="header__heading-logo-wrapper">
              {%- capture sizes -%}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{%- endcapture -%}
              {%- capture widths -%}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{%- endcapture -%}
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
              {{
                settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'header__heading-logo motion-reduce',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes
              }}
            </div>
          {%- else -%}
            <span class="h2">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}

    {%- liquid
      if section.settings.menu != blank
        if section.settings.menu_type_desktop == 'dropdown'
          render 'header-dropdown-menu'
        elsif section.settings.menu_type_desktop != 'drawer'
          render 'header-mega-menu'
        endif
      endif
    %}

    {%- if section.settings.logo_position == 'middle-center' -%}
      <div class="header__heading">
        <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
          {%- if settings.logo_svg != blank -%}
            <div class="header__heading-logo-wrapper header__heading-logo-wrapper--svg">
              <div class="header__heading-logo-svg">
                {{ settings.logo_svg }}
              </div>
            </div>
          {%- elsif settings.logo != blank -%}
            <div class="header__heading-logo-wrapper">
              {%- capture sizes -%}(min-width: 750px) {{ settings.logo_width }}px, 50vw{%- endcapture -%}
              {%- capture widths -%}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{%- endcapture -%}
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
              {{
                settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'header__heading-logo',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes
              }}
            </div>
          {%- else -%}
            <span class="h2">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      {%- if section.settings.show_search -%}
        {% render 'header-search', input_id: 'Search-In-Modal' %}
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%}
        No bag icon and no cart notification (Victor, 16 Oct): there is no theme cart, see layout/theme.liquid
      {%- endcomment -%}

      {%- if section.settings.show_cta_button and section.settings.cta_text != blank -%}
        <a
          href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
          class="header__cta-btn karmicare__btn-primary"
        >
          {{ section.settings.cta_text }}
        </a>
      {%- endif -%}
    </div>
  </header>
</{{ header_tag }}>

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_linkedin_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

