<style>
  {%- if section.settings.bg_gradient_day != blank -%}
  body:not(.night-mode) .section-{{ section.id }},
  body.day-mode .section-{{ section.id }} {
      background: {{ section.settings.bg_gradient_day }};
  }
  {%- elsif section.settings.bg_color_day != blank -%}
  body:not(.night-mode) .section-{{ section.id }},
  body.day-mode .section-{{ section.id }} {
      background-color: {{ section.settings.bg_color_day }};
  }
  {%- endif -%}

  {%- if section.settings.bg_gradient_night != blank -%}
  body.night-mode .section-{{ section.id }} {
      background: {{ section.settings.bg_gradient_night }};
  }
  {%- elsif section.settings.bg_color_night != blank -%}
  body.night-mode .section-{{ section.id }} {
      background-color: {{ section.settings.bg_color_night }};
  }
  {%- endif -%}
/* DAY MODE */
  {% if section.settings.text_color_day != blank %}
    body:not(.night-mode) .section-{{ section.id }} *,
    body.day-mode .section-{{ section.id }} * {
      color: {{ section.settings.text_color_day }};
    }
  {% endif %}


  /* NIGHT MODE */
  {% if section.settings.text_color_night != blank %}
    body.night-mode .section-{{ section.id }} * {
      color: {{ section.settings.text_color_night }};
    }
  {% endif %}
</style>
{% liquid
  assign comparison = product.metafields.custom.comparison_section.value
%}

{% if comparison != blank %}
  {% liquid
    assign comparison = product.metafields.custom.comparison_section.value

    assign section_subtitle = comparison.sub_title.value
    assign section_title = comparison.title
    assign section_description = comparison.short_description.value

    assign table_title = comparison.table_title.value
    assign table_logo = comparison.table_brand_logo.value
    assign table_rows = comparison.table_list.value

    assign button_text = comparison.table_button_text.value
    assign button_url = comparison.table_button_url.value

    assign table_headers = table_title | split: '|'
  %}

  <section class="comparison-section">
    <div class="comparison-section__inner">
      <!--
        ==========================================
             TOP CONTENT
        ===========================================
      -->

      {% if section_subtitle != blank %}
        <div class="comparison-section__subtitle">
          {{ section_subtitle }}
        </div>
      {% endif %}

      {% if section_title != blank %}
        <h2 class="comparison-section__title">
          {{ section_title | metafield_tag }}
        </h2>
      {% endif %}

      {% if section_description != blank %}
        <div class="comparison-section__description">
          {{ section_description }}
        </div>
      {% endif %}

      <!--
        ==========================================
             COMPARISON TABLE
        ===========================================
      -->

      <div class="comparison-table-wrapper">
        <div class="comparison-table">
          <!--
            ========================================
                 TABLE HEADER
            =========================================
          -->

          <!-- Column 1 -->
          <div class="comparison-table__header comparison-table__header--first">
            {% if table_headers[0] != blank %}
              {{ table_headers[0] | strip }}
            {% endif %}
          </div>

          <!-- Column 2 - LOGO -->
          <div class="comparison-table__header comparison-table__header--brand">

            {% if table_logo != blank %}
                <div class="comparison-table__brand-logo">
                {{ table_logo }}
                </div>
            {% endif %}

            </div>


          <!-- Column 3 -->
          <div class="comparison-table__header">
            {% if table_headers[2] != blank %}
              {{ table_headers[2] | strip }}
            {% endif %}
          </div>

          <!-- Column 4 -->
          <div class="comparison-table__header">
            {% if table_headers[3] != blank %}
              {{ table_headers[3] | strip }}
            {% endif %}
          </div>

          <!-- Column 5 -->
          <div class="comparison-table__header">
            {% if table_headers[4] != blank %}
              {{ table_headers[4] | strip }}
            {% endif %}
          </div>

          <!--
            ========================================
                 TABLE BODY
            =========================================
          -->

          {% if table_rows != blank %}
            {% for row in table_rows %}
              {% assign cells = row | split: '|' %}

              <!-- Column 1 -->
              <div class="comparison-table__cell comparison-table__cell--first">
                {% if cells[0] != blank %}
                  {{ cells[0] | strip }}
                {% endif %}
              </div>

              <!-- Column 2 -->
              <div class="comparison-table__cell comparison-table__cell--brand">
                {% if cells[1] != blank %}
                  {{ cells[1] | strip }}
                {% endif %}
              </div>

              <!-- Column 3 -->
              <div class="comparison-table__cell">
                {% if cells[2] != blank %}
                  {{ cells[2] | strip }}
                {% endif %}
              </div>

              <!-- Column 4 -->
              <div class="comparison-table__cell">
                {% if cells[3] != blank %}
                  {{ cells[3] | strip }}
                {% endif %}
              </div>

              <!-- Column 5 -->
              <div class="comparison-table__cell">
                {% if cells[4] != blank %}
                  {{ cells[4] | strip }}
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <!--
          ========================================
               BUTTON
          =========================================
        -->

        {% if button_text != blank %}
          <div class="comparison-section__button-wrapper">
            {% if button_url != blank %}
              <a
                href="{{ button_url }}"
                class="comparison-section__button"
              >
                {{ button_text }}
              </a>

            {% else %}
              <button
                type="button"
                class="comparison-section__button"
              >
                {{ button_text }}
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

<style>
.comparison-section {
  width: 100%;
  padding: 80px 20px 100px;
  box-sizing: border-box;
}

.comparison-section__inner {
  width: 100%;
  max-width: 1050px;
  margin: 0 auto;
}

.comparison-section__subtitle {
  text-align: center;
  font-size: var(--km-body-sm);
  line-height: 1.4;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.comparison-section__title {
  max-width: 720px;
  margin: 0 auto;
  text-align: center;
}

.comparison-section__title p {
  margin: 0;
}

.comparison-section__description {
  max-width: 620px;
  margin: 20px auto 0;
  text-align: center;
 font-size: var(--km-body-lg);
  line-height: 1.5;
}

.comparison-table-wrapper {
  position: relative;
  width: 100%;
  margin-top: 125px;
  padding-bottom: 65px;
  box-sizing: border-box;
}

.comparison-table {
  width: 100%;
  display: grid;
  grid-template-columns:
    1.15fr
    1.25fr
    1.25fr
    1.25fr
    1.25fr;
  box-sizing: border-box;
}

.comparison-table__header {
  min-height: 54px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 11px;
  line-height: 1.35;
  font-weight: 500;
  box-sizing: border-box;
}

.comparison-table__header--first {
  justify-content: flex-start;
  text-align: left;
}

.comparison-table__header--brand {
  position: relative;
  border: 1px solid;
  border-bottom: 0;
  border-radius: 12px 12px 0 0;
  padding: 10px 20px;
}

.comparison-table__brand-logo svg path{
  display:flex;
}

.comparison-table__cell {
  min-height: 70px;
  padding: 15px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 11px;
  line-height: 1.45;
  box-sizing: border-box;
  border-top: 1px solid;
}

.comparison-table__cell--first {
  justify-content: flex-start;
  text-align: left;
  font-weight: 500;
}

.comparison-table__cell--brand {
  border-left: 1px solid;
  border-right: 1px solid;
}

.comparison-table__cell--brand:nth-last-child(4) {
  border-bottom: 1px solid;
  border-radius: 0 0 12px 12px;
}

.comparison-section__button-wrapper {
  position: absolute;
  left: calc(100% * 1.15 / 6.15);
  width: calc(100% * 1.25 / 6.15);
  bottom: 0;
  display: flex;
  justify-content: center;
}

.comparison-section__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 24px;
  border-radius: 6px;
  text-decoration: none;
  font-size: 10px;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  white-space: nowrap;
  box-sizing: border-box;
}

@media screen and (max-width: 900px) {
  .comparison-section {
    padding: 60px 15px 80px;
  }

  .comparison-table-wrapper {
    margin-top: 75px;
    overflow-x: auto;
    padding-bottom: 65px;
  }

  .comparison-table {
    min-width: 850px;
  }
}

@media screen and (max-width: 600px) {
  .comparison-section {
    padding: 50px 12px 70px;
  }

  .comparison-section__subtitle {
    font-size: 9px;
  }

  .comparison-section__title {
    font-size: 34px;
  }

  .comparison-section__description {
    font-size: 12px;
  }

  .comparison-table-wrapper {
    margin-top: 55px;
  }

  .comparison-table {
    min-width: 820px;
  }

  .comparison-table__header,
  .comparison-table__cell {
    font-size: 10px;
  }
}
</style>

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "class": "comparison-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "color",
      "id": "card_bg_color_day",
      "label": "Card Background Color (Day)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "color",
      "id": "card_bg_color_night",
      "label": "Card Background Color (Night)",
      "default": "#191f38"
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
