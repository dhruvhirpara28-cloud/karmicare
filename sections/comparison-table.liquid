{{ 'section-comparison-table.css' | asset_url | stylesheet_tag }}
{%- style -%}
  {%- if section.settings.bg_gradient_day != blank -%}
      body:not(.night-mode) .section-{{ section.id }},
      body.day-mode .section-{{ section.id }} {
        background: {{ section.settings.bg_gradient_day }};
    }
  {%- elsif section.settings.bg_color_day != blank -%}
    body:not(.night-mode) .section-{{ section.id }},
    body.day-mode .section-{{ section.id }} {
        background-color: {{ section.settings.bg_color_day }};
    }
  {%- endif -%}
  {%- if section.settings.col_text_day != blank -%}
    body.day-mode .section-{{ section.id }} .comparison-table__brand-logo svg path {
        color: {{ section.settings.col_text_day }};
    }
    body.day-mode .section-{{ section.id }} .comparison-table__cell,
    body.day-mode .section-{{ section.id }} .comparison-table__cell span {
        color: {{ section.settings.col_text_day }};
    }
  {%- endif -%}

  {%- if section.settings.bg_gradient_night != blank -%}
  body.night-mode .section-{{ section.id }} {
      background: {{ section.settings.bg_gradient_night }};
  }
  {%- elsif section.settings.bg_color_night != blank -%}
  body.night-mode .section-{{ section.id }} {
      background-color: {{ section.settings.bg_color_night }};
  }
  {%- endif -%}

  /* DAY MODE */
  {% if section.settings.text_color_day != blank %}
    body:not(.night-mode) .section-{{ section.id }} *,
    body.day-mode .section-{{ section.id }} * {
      color: {{ section.settings.text_color_day }};
    }
  {% endif %}

  /* TABLE DAY MODE SPECIFIC OVERRIDES */
  body:not(.night-mode) .section-{{ section.id }} .comparison-table__cell,
  body.day-mode .section-{{ section.id }} .comparison-table__cell,
  body:not(.night-mode) .section-{{ section.id }} .comparison-table__cell--first,
  body.day-mode .section-{{ section.id }} .comparison-table__cell--first {
      background-color: transparent;
      border-color: rgba(0,0,0,0.08);
  }

  body:not(.night-mode) .section-{{ section.id }} .comparison-table__header--brand,
  body.day-mode .section-{{ section.id }} .comparison-table__header--brand,
  body:not(.night-mode) .section-{{ section.id }} .comparison-table__cell--brand,
  body.day-mode .section-{{ section.id }} .comparison-table__cell--brand {
      background-color: var(--kc-mapped-surface-accent-default, #212A49);
  }

  body:not(.night-mode) .section-{{ section.id }} .comparison-table__header--brand *,
  body.day-mode .section-{{ section.id }} .comparison-table__header--brand *,
  body:not(.night-mode) .section-{{ section.id }} .comparison-table__cell--brand span,
  body.day-mode .section-{{ section.id }} .comparison-table__cell--brand * {
      color: #FFFFFF !important;
  }

  /* NIGHT MODE */
  {% if section.settings.text_color_night != blank %}
    body.night-mode .section-{{ section.id }} * {
      color: {{ section.settings.text_color_night }};
    }
  {% endif %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{% liquid
  assign comparison = product.metafields.custom.comparison_section.value
%}

{% if comparison != blank %}
  {% liquid
    assign comparison = product.metafields.custom.comparison_section.value

    assign section_subtitle = comparison.sub_title.value
    assign section_title = comparison.title
    assign section_description = comparison.short_description.value

    assign table_title = comparison.table_title.value
    assign table_logo = comparison.table_brand_logo.value
    assign table_rows = comparison.table_list.value

    assign button_text = comparison.table_button_text.value
    assign button_url = comparison.table_button_url.value

    assign table_headers = table_title | split: '|'
  %}

  <section
    class="comparison-section section-{{ section.id }} section-{{ section.id }}-padding"
    id="section-{{ section.id }}"
  >
    <div class="comparison-section__inner page-width">
      <!--
        ==========================================
             TOP CONTENT
        ===========================================
      -->
      <div class="section-main-header">
        {% if section_subtitle != blank %}
          <p class="comparison-section__subtitle">
            {{ section_subtitle }}
          </p>
        {% endif %}

        {% if section_title != blank %}
          <h2 class="comparison-section__title">
            {{ section_title | metafield_tag }}
          </h2>
        {% endif %}

        {% if section_description != blank %}
          <div class="comparison-section__description">
            {{ section_description }}
          </div>
        {% endif %}
      </div>
      <!--
        ==========================================
             COMPARISON TABLE
        ===========================================
      -->

      <div class="comparison-table-wrapper">
        <div class="comparison-table">
          <!--
            ========================================
                 TABLE HEADER
            =========================================
          -->

          <!-- Column 1 -->
          <div class="comparison-table__header comparison-table__header--first">
            {% if table_headers[0] != blank %}
              {{ table_headers[0] | strip }}
            {% endif %}
          </div>

          <!-- Column 2 - LOGO -->
          <div class="comparison-table__header comparison-table__header--brand">
            {% if table_logo != blank %}
              <div class="comparison-table__brand-logo">
                {{ table_logo }}
              </div>
            {% endif %}
          </div>

          <!-- Column 3 -->
          <div class="comparison-table__header">
            {% if table_headers[2] != blank %}
              {{ table_headers[2] | strip }}
            {% endif %}
          </div>

          <!-- Column 4 -->
          <div class="comparison-table__header">
            {% if table_headers[3] != blank %}
              {{ table_headers[3] | strip }}
            {% endif %}
          </div>

          <!-- Column 5 -->
          <div class="comparison-table__header">
            {% if table_headers[4] != blank %}
              {{ table_headers[4] | strip }}
            {% endif %}
          </div>

          <!--
            ========================================
                 TABLE BODY
            =========================================
          -->

          {% if table_rows != blank %}
            {% for row in table_rows %}
              {% assign cells = row | split: '|' %}

              <!-- Column 1 -->
              <div class="comparison-table__cell comparison-table__cell--first comparison-table__cell--first{{ forloop.index }}">
                {% if cells[0] != blank %}
                  {{ cells[0] | strip }}
                {% endif %}
              </div>

              <!-- Column 2 -->
              <div class="comparison-table__cell comparison-table__cell--brand">
                {% if cells[1] != blank %}
                  <span>{{ cells[1] | strip }}</span>
                {% endif %}
              </div>

              <!-- Column 3 -->
              <div class="comparison-table__cell">
                {% if cells[2] != blank %}
                  <span>{{ cells[2] | strip }}</span>
                {% endif %}
              </div>

              <!-- Column 4 -->
              <div class="comparison-table__cell">
                {% if cells[3] != blank %}
                  <span>{{ cells[3] | strip }}</span>
                {% endif %}
              </div>

              <!-- Column 5 -->
              <div class="comparison-table__cell comparison-table__cell-last{{ forloop.index }}">
                {% if cells[4] != blank %}
                  <span>{{ cells[4] | strip }}</span>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <!--
          ========================================
               BUTTON
          =========================================
        -->

        {% if button_text != blank %}
          <div class="comparison-section__button-wrapper">
            {% if button_url != blank %}
              <a
                href="{{ button_url }}"
                class="comparison-section__button"
              >
                {{ button_text }}
              </a>

            {% else %}
              <button
                type="button"
                class="comparison-section__button"
              >
                {{ button_text }}
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "class": "comparison-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "color",
      "id": "col_text_day",
      "label": "Table Text Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "header",
      "content": "padding settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing (Desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing (Desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Spacing (Mobile)",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Spacing (Mobile)",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
