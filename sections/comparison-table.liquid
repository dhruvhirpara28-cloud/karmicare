<style>
.comparison-section {
    width: 100%;
    padding: 80px 20px 100px;
    box-sizing: border-box;
}

.comparison-section__inner {
  width: 100%;
  max-width: 1130px;
  margin: 0 auto;
}

.comparison-section .section-main-header{
    max-width: 604px;
    margin: 0 auto;
    width: 100%;
    text-align: center;
}

/* =========================
   TYPOGRAPHY
   ========================= */

.comparison-section__subtitle {
  text-align: center;
  font-family: "Noto Sans", sans-serif;
  font-size: 12px;
  line-height: 16px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.comparison-section__title,
.comparison-section__title p {
  margin: 0 auto;
  text-align: center;

  font-family: "Noto Sans", sans-serif;
  font-size: 40px;
  line-height: 1.04;
  font-weight: 500;
  letter-spacing: -1.5px;
}

.comparison-section__title p {
  margin: 0;
}

.comparison-section__title i,
.comparison-section__title em {
  opacity: 0.68;
  font-style: normal;
}

.comparison-section__description {
  max-width: 620px;
  margin: 24px auto 0;
  text-align: center;

  font-family: "Noto Sans", sans-serif;
  font-size: 16px;
  line-height: 1.45;
  font-weight: 400;
  letter-spacing: 0;
}


/* =========================
   TABLE
   ========================= */

.comparison-table-wrapper {
  position: relative;
  width: 100%;
  margin-top: 112px;
  padding-bottom: 65px;
  box-sizing: border-box;
}

.comparison-table {
  width: 100%;
  display: grid;
  grid-template-columns:
    1.15fr
    1.25fr
    1.25fr
    1.25fr
    1.25fr;
  box-sizing: border-box;
  background: #191F38;
}

.comparison-table__header {
  min-height: 54px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;

  font-family: "Noto Sans", sans-serif;
  font-size: 16px;
  line-height: 22px;
  font-weight: 500;
  letter-spacing: 0;
}

.comparison-table__header--first {
  justify-content: flex-start;
  text-align: left;
}

.comparison-table__header--brand {
  position: relative;
  background: #212A49;
  border-bottom: 0;
  border-radius: 16px 16px 0 0;
  padding: 10px 20px;
}

.comparison-table__brand-logo svg path {
  display: flex;
}

.comparison-table__cell {
  min-height: 70px;
  padding: 15px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  border-top: 1px solid rgba(127, 185, 255, 0.1);

  font-family: "Noto Sans", sans-serif;
  font-size: 14px;
  line-height: 20px;
  font-weight: 400;
  letter-spacing: 0;
}

.comparison-table__cell--first {
  justify-content: flex-start;
  text-align: left;
  font-weight: 500;
}

.comparison-table__cell--brand {
  background: #212A49;
}

.comparison-table__cell--brand:nth-last-child(4) {
  border-bottom: 0;
  border-radius: 0;
}


/* =========================
   BUTTON
   ========================= */

.comparison-section__button-wrapper {
  position: absolute;
  top: 0;
  bottom: 0;
  left: calc(100% * 1.15 / 6.15);
  width: calc(100% * 1.25 / 6.15);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 20px 10px;
  box-sizing: border-box;
  border: 1px solid #7FB9FF;
  border-radius: 16px;
  background: transparent;
  z-index: 5;
  pointer-events: none;
}

.comparison-section__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 24px;
  border-radius: 6px;
  text-decoration: none;
  box-sizing: border-box;
  white-space: nowrap;
  position: relative;
  z-index: 2;
  pointer-events: auto;

  font-family: "Noto Sans", sans-serif;
  font-size: 10px;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;

  background: #7FB9FF;
  color: #0A1628;
}

.comparison-section__button:hover,
.comparison-section__button:focus {
  color: #0A1628;
}


/* =========================
   TABLET
   ========================= */

@media screen and (max-width: 900px) {

  .comparison-section {
    padding: 60px 15px 80px;
  }

  .comparison-table-wrapper {
    margin-top: 75px;
    overflow-x: auto;
    padding-bottom: 65px;
  }

  .comparison-table {
    min-width: 850px;
  }

  .comparison-table__header {
    font-size: 15px;
    line-height: 21px;
  }

  .comparison-table__cell {
    font-size: 14px;
    line-height: 20px;
  }

  .comparison-section__button-wrapper {
    left: calc(850px * 1.15 / 6.15);
    width: calc(850px * 1.25 / 6.15);
  }
}


/* =========================
   MOBILE
   ========================= */

@media screen and (max-width: 600px) {

  .comparison-section {
    padding: 50px 12px 70px;
  }

  .comparison-section__subtitle {
    font-size: 9px;
    line-height: 13px;
    letter-spacing: 1.7px;
  }

  .comparison-section__title,
  .comparison-section__title p {
    font-size: 34px;
    line-height: 1.06;
    letter-spacing: -1.1px;
  }

  .comparison-section__description {
    font-size: 12px;
    line-height: 1.5;
  }

  .comparison-table-wrapper {
    margin-top: 55px;
  }

  .comparison-table {
    min-width: 820px;
  }

  .comparison-table__header {
    font-size: 15px;
    line-height: 20px;
  }

  .comparison-table__cell {
    font-size: 13px;
    line-height: 18px;
  }

  .comparison-section__button-wrapper {
    left: calc(820px * 1.15 / 6.15);
    width: calc(820px * 1.25 / 6.15);
  }
}
</style>
