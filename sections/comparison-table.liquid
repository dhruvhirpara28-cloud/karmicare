{{ 'section-comparison-table.css' | asset_url | stylesheet_tag }}
{%- style -%}
  {%- if section.settings.text_color_day != blank -%}
    body:not(.night-mode) .section-{{ section.id }} {
      color: {{ section.settings.text_color_day }};
    }
  {%- endif -%}
  {%- if section.settings.text_color_night != blank -%}
    body.night-mode .section-{{ section.id }} {
      color: {{ section.settings.text_color_night }};
    }
  {%- endif -%}
  {%- if section.settings.col_text_day != blank -%}
    body:not(.night-mode) .section-{{ section.id }} .comparison-table__cell:not(.comparison-table__cell--brand),
    body:not(.night-mode) .section-{{ section.id }} .comparison-table__header:not(.comparison-table__header--brand) {
      color: {{ section.settings.col_text_day }};
    }
  {%- endif -%}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{% liquid
  assign comparison = product.metafields.custom.comparison_section.value
%}

{% if comparison != blank %}
  {% liquid
    assign section_subtitle = comparison.sub_title.value
    assign section_title = comparison.title
    assign section_description = comparison.short_description.value

    assign table_title = comparison.table_title.value
    assign table_logo = comparison.table_brand_logo.value
    assign table_rows = comparison.table_list.value

    assign button_text = comparison.table_button_text.value
    assign button_url = comparison.table_button_url.value | strip
    if button_url == '#'
      assign button_url = ''
    endif

    # Without a real link in the metaobject the button buys the plan the plans table features
    # (custom.compare_table, featured, not hidden) straight to checkout, by selling plan ID, the same
    # way as that plan's own button (assets/kc-plan-select.js; Victor, 20 Oct). No featured plan, or
    # one this product does not sell: the button goes to the buybox plan cards.
    assign buy_choose = ''
    assign buy_plan_id = ''
    assign buy_group_id = ''
    assign buy_title = ''
    if button_url == blank
      for buy_plan in product.metafields.custom.compare_table.value.compare_plans.value
        if buy_plan.featured.value != true or buy_plan.hide_plan.value == true
          continue
        endif
        assign buy_title = buy_plan.title.value | default: buy_plan.title
        assign buy_kind = buy_plan.handle_item.value | default: buy_plan.handle_item | downcase | replace: '-', ' ' | strip
        if buy_kind == 'once' or buy_kind == 'one time'
          assign buy_choose = 'once'
        else
          assign buy_raw_id = buy_plan.selling_plan_id.value | default: buy_plan.selling_plan_id | append: '' | strip
          capture buy_resolved
            render 'kc-plan-resolve', product: product, plan_id: buy_raw_id
          endcapture
          if buy_resolved != blank
            assign buy_parts = buy_resolved | split: '|'
            assign buy_choose = 'plan'
            assign buy_plan_id = buy_parts[0]
            assign buy_group_id = buy_parts[1]
          endif
        endif
        break
      endfor
      if buy_choose == blank
        assign button_url = '#loop-selling-plan-fieldset'
      endif
    endif

    assign table_headers = table_title | split: '|'
  %}

  <section
    class="comparison-section section-{{ section.id }} section-{{ section.id }}-padding kc-surface"
    id="section-{{ section.id }}"
    data-kc-surface="{{ section.settings.surface }}"
    data-kc-plan-feedback-scope
  >
    <div class="comparison-section__inner page-width">
      <div class="comparison-section__header">
        {% if section_subtitle != blank %}
          <span class="comparison-section__subtitle subtitle-item">{{ section_subtitle }}</span>
        {% endif %}

        {% if section_title != blank %}
          <h2 class="comparison-section__title">
            {{ section_title | metafield_tag }}
          </h2>
        {% endif %}

        {% if section_description != blank %}
          <div class="comparison-section__description">
            {{ section_description }}
          </div>
        {% endif %}

        {%- comment -%} KC/Button, primary, large (Figma 3391:12478) {%- endcomment -%}
        {% if button_text != blank %}
          {% if button_url != blank %}
            <a href="{{ button_url }}" class="comparison-section__button">{{ button_text }}</a>
          {% else %}
            {%- comment -%}
              Accessible name: the visible label plus the plan it buys, "Begin now, 60-Day Rhythm" (R14 F3)
            {%- endcomment -%}
            <button
              type="button"
              class="comparison-section__button"
              aria-labelledby="comparison-buy-label-{{ section.id }}{% if buy_title != blank %} comparison-buy-plan-{{ section.id }}{% endif %}"
              data-kc-plan-product="{{ product.id }}"
              data-kc-plan-title="{{ buy_title | escape }}"
              data-kc-plan-choose="{{ buy_choose }}"
              {%- if buy_choose == 'plan' %}
                data-selling-plan-id="{{ buy_plan_id }}"
                data-selling-plan-group-id="{{ buy_group_id }}"
              {%- endif %}
            >
              <span id="comparison-buy-label-{{ section.id }}">{{ button_text }}</span>
              {%- if buy_title != blank -%}
                <span class="visually-hidden" id="comparison-buy-plan-{{ section.id }}">{{ buy_title }}</span>
              {%- endif -%}
              {%- render 'kc-plan-spinner' -%}
            </button>
            {%- render 'kc-plan-feedback' -%}
          {% endif %}
        {% endif %}
      </div>

      <div class="comparison-table-wrapper">
        <div class="comparison-table">
          <div class="comparison-table__header comparison-table__header--first">
            {%- if table_headers[0] != blank -%}{{ table_headers[0] | strip }}{%- endif -%}
          </div>
          <div class="comparison-table__header comparison-table__header--brand">
            {% if table_logo != blank %}
              <div class="comparison-table__brand-logo">
                {{ table_logo }}
              </div>
            {% endif %}
          </div>
          {%- for i in (2..4) -%}
            <div class="comparison-table__header">
              {%- if table_headers[i] != blank -%}{{ table_headers[i] | strip }}{%- endif -%}
            </div>
          {%- endfor -%}

          {% if table_rows != blank %}
            {% for row in table_rows %}
              {% assign cells = row | split: '|' %}
              <div class="comparison-table__cell comparison-table__cell--first">
                {%- if cells[0] != blank -%}{{ cells[0] | strip }}{%- endif -%}
              </div>
              <div class="comparison-table__cell comparison-table__cell--brand">
                {%- if cells[1] != blank -%}{{ cells[1] | strip }}{%- endif -%}
              </div>
              {%- for i in (2..4) -%}
                <div class="comparison-table__cell">
                  {%- if cells[i] != blank -%}{{ cells[i] | strip }}{%- endif -%}
                </div>
              {%- endfor -%}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "class": "comparison-section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Colours follow the KC tokens in Day and Night. Leave the colour fields empty unless this table needs an override."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Section surface",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "accent", "label": "Accent" },
        { "value": "transition", "label": "Transition" }
      ],
      "default": "transition",
      "info": "Page and Accent hold their colour. Transition fades from the colour of the section above to the other one. A hold that follows the other colour is shown as a transition and flagged here."
    },
    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "col_text_day",
      "label": "Table Text Color (Day)"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "header",
      "content": "padding settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing (Desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing (Desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Spacing (Mobile)",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Spacing (Mobile)",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
