{%- comment -%}
  How it works / Ritual steps section (Swiper slider version)
  - Slides: Desktop 3, Tablet 2.1, Mobile 1.2
  - No color settings and no color values in CSS.
  - Section header snippet ka use nahi hua.
  - Video: Shopify uploaded video, YouTube ya Vimeo link.
  - Font-family, font-weight, font-style, font-size, max-width static hain (CSS mein edit karo).
{%- endcomment -%}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{{ 'section-how-it-works-steps.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- if section.settings.bg_gradient_day != blank -%}
      body:not(.night-mode) .section-{{ section.id }},
      body.day-mode .section-{{ section.id }} {
          background: {{ section.settings.bg_gradient_day }};
      }
  {%- elsif section.settings.bg_color_day != blank -%}
      body:not(.night-mode) .section-{{ section.id }},
      body.day-mode .section-{{ section.id }} {
          background-color: {{ section.settings.bg_color_day }};
      }
  {%- endif -%}

  {%- if section.settings.bg_gradient_night != blank -%}
      body.night-mode .section-{{ section.id }} {
          background: {{ section.settings.bg_gradient_night }};
      }
  {%- elsif section.settings.bg_color_night != blank -%}
      body.night-mode .section-{{ section.id }} {
          background-color: {{ section.settings.bg_color_night }};
      }
  {%- endif -%}


  .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
      .section-{{ section.id }} {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      }
  }

  .kc-how-it-steps .kc-card {
      aspect-ratio: {{ section.settings.aspect_ratio }};
      border-radius: {{ section.settings.radius }}px;
  }
{%- endstyle -%}

{% if blocks.size != 0 %}
  <section class="kc-how-it-steps section-{{ section.id }}">
    <div class="page-width">
      {%- if section.settings.subtitle != blank
        or section.settings.title != blank
        or section.settings.description != blank
      -%}
        <div class="kc-head center">
          {%- if section.settings.subtitle != blank -%}
            <span class="subtitle-item">{{ section.settings.subtitle }}</span>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <{{ section.settings.heading_tag | default: 'h2' }} class="kc-title {{ section.settings.heading_size | default: 'h2' }}">{{ section.settings.title }}</{{ section.settings.heading_tag | default: 'h2' }}>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            {{- section.settings.description -}}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- capture slider_classes -%}
        {% if section.settings.slider_mobile %} slider--mobile{% endif %}
        {% if section.settings.slider_tablet %} slider--tablet{% endif %}
        {% if section.settings.slider_laptop %} slider--desktop{% endif %}
        {% if section.settings.slider_desktop %} slider--desktop{% endif %}
      {%- endcapture -%}

      {%- assign show_slider = false -%}
      {%- if section.settings.slider_mobile
        or section.settings.slider_tablet
        or section.settings.slider_laptop
        or section.settings.slider_desktop
      -%}
        {%- assign show_slider = true -%}
      {%- endif -%}

      {%- if show_slider -%}
        <slider-component>
      {%- endif -%}

      <ul
        class="kc-grid{% if show_slider %} slider{{ slider_classes }}{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
        style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-laptop: {{ section.settings.columns_laptop }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign video_type = 'none'
            if block.settings.video != blank
              assign video_type = 'shopify'
            elsif block.settings.video_url != blank
              assign video_type = block.settings.video_url.type
            endif
            assign loop = block.settings.loop
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="kc-step{% if show_slider %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="kc-card" data-type="{{ video_type }}" data-loop="{{ loop }}">
              <div class="kc-media">
                {%- if video_type == 'shopify' -%}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '900x',
                      autoplay: false,
                      loop: loop,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata'
                  }}
                {%- elsif video_type == 'youtube' -%}
                  {%- liquid
                    assign yt_src = 'https://www.youtube-nocookie.com/embed/' | append: block.settings.video_url.id | append: '?enablejsapi=1&controls=0&mute=1&playsinline=1&rel=0&modestbranding=1'
                    if loop
                      assign yt_src = yt_src | append: '&loop=1&playlist=' | append: block.settings.video_url.id
                    endif
                  -%}
                  <iframe
                    src="{{ yt_src }}"
                    title="{{ block.settings.title | escape }}"
                    loading="lazy"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- elsif video_type == 'vimeo' -%}
                  {%- liquid
                    assign vm_src = 'https://player.vimeo.com/video/' | append: block.settings.video_url.id | append: '?muted=1&controls=0&playsinline=1&title=0&byline=0&portrait=0'
                    if loop
                      assign vm_src = vm_src | append: '&loop=1'
                    endif
                  -%}
                  <iframe
                    src="{{ vm_src }}"
                    title="{{ block.settings.title | escape }}"
                    loading="lazy"
                    allow="autoplay; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- elsif block.settings.poster != blank -%}
                  {{ block.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900' }}
                {%- endif -%}
              </div>

              {%- if block.settings.number != blank -%}
                <h2 class="kc-number">{{ block.settings.number }}</h2>
              {%- endif -%}

              {%- if video_type != 'none' -%}
                <div class="kc-overlay">
                  <span class="kc-play">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <foreignObject x="-20" y="-20" width="88" height="88"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(10px);clip-path:url(#bgblur_0_4002_231_clip_path);height:100%;width:100%"></div></foreignObject><g data-figma-bg-blur-radius="20">
                      <path d="M0 24C0 10.7452 10.7452 0 24 0C37.2548 0 48 10.7452 48 24C48 37.2548 37.2548 48 24 48C10.7452 48 0 37.2548 0 24Z" fill="var(--kc-mapped-surface-accent-default)"/>
                      <path d="M19.332 19.3332C19.332 19.0986 19.3938 18.8682 19.5113 18.6651C19.6288 18.462 19.7978 18.2936 20.0012 18.1767C20.2046 18.0598 20.4353 17.9987 20.6699 17.9995C20.9045 18.0003 21.1347 18.063 21.3374 18.1812L29.3354 22.8466C29.5372 22.9637 29.7048 23.1317 29.8213 23.3339C29.9379 23.5361 29.9993 23.7653 29.9995 23.9987C29.9997 24.232 29.9387 24.4614 29.8225 24.6637C29.7063 24.8661 29.539 25.0344 29.3374 25.1519L21.3374 29.8186C21.1347 29.9368 20.9045 29.9995 20.6699 30.0003C20.4353 30.0011 20.2046 29.94 20.0012 29.8231C19.7978 29.7062 19.6288 29.5378 19.5113 29.3347C19.3938 29.1316 19.332 28.9012 19.332 28.6666V19.3332Z" fill="#0A1628" stroke="#0A1628" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </g>
                      <defs>
                      <clipPath id="bgblur_0_4002_231_clip_path" transform="translate(20 20)"><path d="M0 24C0 10.7452 10.7452 0 24 0C37.2548 0 48 10.7452 48 24C48 37.2548 37.2548 48 24 48C10.7452 48 0 37.2548 0 24Z"/>
                      </clipPath></defs>
                    </svg>
                  </span>
                  {%- if section.settings.hint_text != blank -%}
                    <span class="kc-hint opacity-xl">{{ section.settings.hint_text }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.show_text -%}
              {%- if block.settings.title != blank -%}
                <h4 class="kc-step-title">{{ block.settings.title }}</h4>
              {%- endif -%}
              {%- if block.settings.show_description and block.settings.description != blank -%}
                <p class="kc-step-desc opacity-xl">{{ block.settings.description }}</p>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_slider and section.settings.show_slider_arrows -%}
        <div
          class="slider-buttons no-js-hidden"
          style="width: 100%; justify-content: center; gap: 16px; margin-top: 1rem;"
        >
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{ 'icon-caret.svg' | inline_asset_content }}
            </span>
          </button>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{ 'icon-caret.svg' | inline_asset_content }}
            </span>
          </button>
        </div>
      {%- endif -%}
      {%- if show_slider -%}
        </slider-component>
      {%- endif -%}

      {%- if section.settings.bottom_text != blank -%}
        <p class="kc-bottom">{{ section.settings.bottom_text }}</p>
      {%- endif -%}
    </div>
  </section>

  <script>
    (function () {
      var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      function post(iframe, data) {
        if (iframe && iframe.contentWindow) iframe.contentWindow.postMessage(JSON.stringify(data), '*');
      }

      function play(card) {
        var type = card.dataset.type;
        if (type === 'shopify') {
          var v = card.querySelector('video');
          if (v) {
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          }
        } else if (type === 'youtube') {
          post(card.querySelector('iframe'), { event: 'command', func: 'playVideo', args: [] });
        } else if (type === 'vimeo') {
          post(card.querySelector('iframe'), { method: 'play' });
        } else {
          return;
        }
        card.classList.add('is-playing');
      }

      function pause(card) {
        var type = card.dataset.type;
        if (type === 'shopify') {
          var v = card.querySelector('video');
          if (v) v.pause();
        } else if (type === 'youtube') {
          post(card.querySelector('iframe'), { event: 'command', func: 'pauseVideo', args: [] });
        } else if (type === 'vimeo') {
          post(card.querySelector('iframe'), { method: 'pause' });
        } else {
          return;
        }
        card.classList.remove('is-playing');
      }

      document.querySelectorAll('.kc-how-it-steps:not([data-kc-init])').forEach(function (root) {
        root.setAttribute('data-kc-init', 'true');

        root.querySelectorAll('.kc-card').forEach(function (card) {
          var pinned = false;

          function togglePin() {
            if (pinned) {
              pinned = false;
              card.classList.remove('is-pinned');
              pause(card);
            } else {
              pinned = true;
              card.classList.add('is-pinned');
              play(card);
            }
          }

          if (canHover) {
            // Desktop: hover = play, leave = pause (sirf agar click/pin nahi kiya)
            card.addEventListener('mouseenter', function () {
              if (!pinned) play(card);
            });
            card.addEventListener('mouseleave', function () {
              if (!pinned) pause(card);
            });
            // Click = pin (bahar jaane pe bhi chalta rahega), dobara click = pause
            card.addEventListener('click', togglePin);
          } else {
            // Mobile: tap = play/pause toggle
            card.addEventListener('click', togglePin);
          }
        });
      });
    })();
  </script>
{% endif %}
{% schema %}
{
  "name": "How it works (Steps)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The Ritual" },
    { "type": "text", "id": "title", "label": "Title", "default": "How Karmicare works." },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "p" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2",
      "label": "SEO Heading tag"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Short description",
      "default": "<p>Become a pro at brushing. Feel your teeth by sliding your tongue.</p>"
    },
    { "type": "text", "id": "hint_text", "label": "Video hint text", "default": "Hover or tap to watch" },
    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Section bottom tag",
      "default": "Not to be combined with fluoride oral care. One duo lasts 64 days at two brushings a day."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video aspect ratio",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "9 / 16", "label": "Portrait 9:16" }
      ]
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Video corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Grid & Slider Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop (1200px+)",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "slider_desktop",
      "label": "Enable Slider on Desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_laptop",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columns on Laptop (990px - 1199px)",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "slider_laptop",
      "label": "Enable Slider on Laptop",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columns on Tablet (750px - 989px)",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "slider_tablet",
      "label": "Enable Slider on Tablet",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile (< 750px)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.3", "label": "1.3" },
        { "value": "1.5", "label": "1.5" },
        { "value": "1.8", "label": "1.8" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "1.5"
    },
    {
      "type": "checkbox",
      "id": "slider_mobile",
      "label": "Enable Slider on Mobile",
      "default": true
    },
    {
