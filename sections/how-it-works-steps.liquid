          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h4",
          "label": "Heading size"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" },
            { "value": "p", "label": "p" },
            { "value": "div", "label": "div" }
          ],
          "default": "h4",
          "label": "SEO Heading tag"
        },
        { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Start with a rinse before brushing."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works (Steps)",
      "blocks": [
        {
          "type": "step",
          "settings": { "number": "01", "title": "Rinse before", "description": "Start with a rinse before brushing." }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Pump and brush",
            "description": "Apply one pump and brush gently for two minutes."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Spit, no rinse",
            "description": "Spit out the excess. Do not rinse afterwards."
          }
        }
      ]
    }
  ]
}
{% endschema %}
