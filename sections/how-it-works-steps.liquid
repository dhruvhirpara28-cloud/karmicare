{%- comment -%}
  How it works / ritual steps.
  Figma: PDP band 3391:12461, card KC/UX/Video ritual step (State = Poster at rest,
  State = Preview while the clip plays). Colours, type and spacing come from
  assets/kc-tokens.css (see assets/section-how-it-works-steps.css).
  Video: Shopify uploaded video, YouTube or Vimeo link. A mouse hover previews the clip;
  click, tap, Enter or Space pause a playing clip and play a paused one.
{%- endcomment -%}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{{ 'section-how-it-works-steps.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
      .section-{{ section.id }} {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      }
  }

  .kc-how-it-steps .kc-card {
      aspect-ratio: {{ section.settings.aspect_ratio }};
      border-radius: {{ section.settings.radius }}px;
  }
{%- endstyle -%}

{% if blocks.size != 0 %}
  <section
    class="kc-how-it-steps section-{{ section.id }}{% if section.settings.media_text_color == 'light' %} kc-how-it-steps--media-text-light{% endif %} kc-surface"
    data-kc-surface="{{ section.settings.surface }}"
  >
    <div class="page-width">
      {%- if section.settings.subtitle != blank
        or section.settings.title != blank
        or section.settings.description != blank
      -%}
        <div class="kc-head">
          {%- if section.settings.subtitle != blank -%}
            <p class="kc-eyebrow">{{ section.settings.subtitle }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <{{ section.settings.heading_tag | default: 'h2' }} class="kc-title {{ section.settings.heading_size | default: 'h2' }}">{{ section.settings.title }}</{{ section.settings.heading_tag | default: 'h2' }}>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="kc-description">{{- section.settings.description -}}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- capture slider_classes -%}
        {% if section.settings.slider_mobile %} slider--mobile{% endif %}
        {% if section.settings.slider_tablet %} slider--tablet{% endif %}
        {% if section.settings.slider_laptop %} slider--desktop{% endif %}
        {% if section.settings.slider_desktop %} slider--desktop{% endif %}
      {%- endcapture -%}

      {%- assign show_slider = false -%}
      {%- if section.settings.slider_mobile
        or section.settings.slider_tablet
        or section.settings.slider_laptop
        or section.settings.slider_desktop
      -%}
        {%- assign show_slider = true -%}
      {%- endif -%}

      {%- if show_slider -%}
        <slider-component>
      {%- endif -%}

      <ul
        class="kc-grid{% if show_slider %} slider{{ slider_classes }}{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
        style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-laptop: {{ section.settings.columns_laptop }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign video_type = 'none'
            if block.settings.video != blank
              assign video_type = 'shopify'
            elsif block.settings.video_url != blank
              assign video_type = block.settings.video_url.type
            endif
            assign loop = block.settings.loop
            assign play_label = 'products.product.media.play_video' | t
            if block.settings.title != blank
              assign play_label = play_label | append: ': ' | append: block.settings.title
            endif
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="kc-step{% if show_slider %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div
              class="kc-card"
              data-type="{{ video_type }}"
              data-loop="{{ loop }}"
              {% if video_type != 'none' %}
                role="button" tabindex="0" aria-pressed="false" aria-label="{{ play_label | escape }}"
              {% endif %}
            >
              <div class="kc-media">
                {%- if video_type == 'shopify' -%}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '900x',
                      autoplay: false,
                      loop: loop,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata'
                  }}
                {%- elsif video_type == 'youtube' -%}
                  {%- liquid
                    assign yt_src = 'https://www.youtube-nocookie.com/embed/' | append: block.settings.video_url.id | append: '?enablejsapi=1&controls=0&mute=1&playsinline=1&rel=0&modestbranding=1'
                    if loop
                      assign yt_src = yt_src | append: '&loop=1&playlist=' | append: block.settings.video_url.id
                    endif
                  -%}
                  <iframe
                    src="{{ yt_src }}"
                    title="{{ block.settings.title | escape }}"
                    loading="lazy"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- elsif video_type == 'vimeo' -%}
                  {%- liquid
                    assign vm_src = 'https://player.vimeo.com/video/' | append: block.settings.video_url.id | append: '?muted=1&controls=0&playsinline=1&title=0&byline=0&portrait=0'
                    if loop
                      assign vm_src = vm_src | append: '&loop=1'
                    endif
                  -%}
                  <iframe
                    src="{{ vm_src }}"
                    title="{{ block.settings.title | escape }}"
                    loading="lazy"
                    allow="autoplay; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- elsif block.settings.poster != blank -%}
                  {{ block.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900' }}
                {%- endif -%}
              </div>

              {%- if block.settings.number != blank -%}
                <span class="kc-number">{{ block.settings.number }}</span>
              {%- endif -%}

              {%- comment -%} State = Preview: shown only while the clip plays {%- endcomment -%}
              {%- if video_type != 'none' -%}
                <div class="kc-overlay" aria-hidden="true">
                  <span class="kc-play">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                      <path d="M11.9997 2L9.99968 2C9.63149 2 9.33301 2.29848 9.33301 2.66667V13.3333C9.33301 13.7015 9.63149 14 9.99968 14H11.9997C12.3679 14 12.6663 13.7015 12.6663 13.3333L12.6663 2.66667C12.6663 2.29848 12.3679 2 11.9997 2Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M5.99967 2L3.99967 2C3.63148 2 3.33301 2.29848 3.33301 2.66667L3.33301 13.3333C3.33301 13.7015 3.63148 14 3.99967 14H5.99967C6.36786 14 6.66634 13.7015 6.66634 13.3333L6.66634 2.66667C6.66634 2.29848 6.36786 2 5.99967 2Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  {%- if section.settings.hint_text != blank -%}
                    <span class="kc-hint">{{ section.settings.hint_text }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.show_text -%}
              <div class="kc-step-content">
                {%- if block.settings.title != blank -%}
                  <h4 class="kc-step-title">{{ block.settings.title }}</h4>
                {%- endif -%}
                {%- if block.settings.show_description and block.settings.description != blank -%}
                  <p class="kc-step-desc">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_slider and section.settings.show_slider_arrows -%}
        <div
          class="slider-buttons no-js-hidden"
          style="width: 100%; justify-content: center; gap: 16px; margin-top: 1rem;"
        >
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{ 'icon-caret.svg' | inline_asset_content }}
            </span>
          </button>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{ 'icon-caret.svg' | inline_asset_content }}
            </span>
          </button>
        </div>
      {%- endif -%}
      {%- if show_slider -%}
        </slider-component>
      {%- endif -%}

      {%- if section.settings.bottom_text != blank -%}
        <p class="kc-bottom">{{ section.settings.bottom_text }}</p>
      {%- endif -%}
    </div>
  </section>

  <script>
    (function () {
      function post(iframe, data) {
        if (iframe && iframe.contentWindow) iframe.contentWindow.postMessage(JSON.stringify(data), '*');
      }

      function startMedia(card, onFail) {
        var type = card.dataset.type;
        if (type === 'shopify') {
          var v = card.querySelector('video');
          if (v) {
            var p = v.play();
            if (p && p.catch) p.catch(onFail);
          }
        } else if (type === 'youtube') {
          post(card.querySelector('iframe'), { event: 'command', func: 'playVideo', args: [] });
        } else if (type === 'vimeo') {
          post(card.querySelector('iframe'), { method: 'play' });
        }
      }

      function stopMedia(card) {
        var type = card.dataset.type;
        if (type === 'shopify') {
          var v = card.querySelector('video');
          if (v) v.pause();
        } else if (type === 'youtube') {
          post(card.querySelector('iframe'), { event: 'command', func: 'pauseVideo', args: [] });
        } else if (type === 'vimeo') {
          post(card.querySelector('iframe'), { method: 'pause' });
        }
      }

      document.querySelectorAll('.kc-how-it-steps:not([data-kc-init])').forEach(function (root) {
        root.setAttribute('data-kc-init', 'true');

        root.querySelectorAll('.kc-card').forEach(function (card) {
          if (card.dataset.type === 'none') return;

          // rest: poster, no choice made · preview: playing because the mouse is over it
          // playing: started by the visitor · paused: stopped by the visitor (hover leaves it alone)
          var state = 'rest';
          var request = 0; // a failed play() only resets the state if nothing happened since

          // One place for the visual state (Preview overlay) and aria-pressed
          function setState(next) {
            state = next;
            var playing = next === 'preview' || next === 'playing';
            card.classList.toggle('is-playing', playing);
            card.setAttribute('aria-pressed', String(playing));
          }

          function play(next) {
            var current = ++request;
            setState(next);
            startMedia(card, function () {
              if (current === request) setState('rest');
            });
          }

          function pause(next) {
            request++;
            stopMedia(card);
            setState(next);
          }

          // Click, tap, Enter and Space: the visible pause control pauses whatever is playing,
          // including a hover preview; the next activation plays again
          function activate() {
            if (state === 'preview' || state === 'playing') {
              pause('paused');
            } else {
              play('playing');
            }
          }

          card.addEventListener('click', activate);
          card.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            if (!event.repeat) activate();
          });

          // Mouse hover previews from rest only; touch and pen go through click
          card.addEventListener('pointerenter', function (event) {
            if (event.pointerType === 'mouse' && state === 'rest') play('preview');
          });
          card.addEventListener('pointerleave', function (event) {
            if (event.pointerType === 'mouse' && state === 'preview') pause('rest');
          });

          var video = card.querySelector('video');
          if (video) {
            video.addEventListener('ended', function () {
              setState('rest');
            });
          }
        });
      });
    })();
  </script>
{% endif %}
{% schema %}
{
  "name": "How it works (Steps)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The Ritual" },
    { "type": "text", "id": "title", "label": "Title", "default": "How Karmicare works." },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "p" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2",
      "label": "SEO Heading tag"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Short description",
      "default": "<p>Become a pro at brushing. Feel your teeth by sliding your tongue.</p>"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Video preview caption",
      "info": "Shown under the pause control while a clip plays.",
      "default": "Preview · sound off"
    },
    {
      "type": "select",
      "id": "media_text_color",
      "label": "Step number and caption on the video",
      "info": "Token follows Figma (dark text in Day, light in Night). Use Light while the clips have a dark background.",
      "options": [
        { "value": "token", "label": "Token (Figma)" },
        { "value": "light", "label": "Light (off-white, for dark clips)" }
      ],
      "default": "token"
    },
    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Section bottom tag",
      "default": "Not to be combined with fluoride oral care. One duo lasts 64 days at two brushings a day."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video aspect ratio",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "9 / 16", "label": "Portrait 9:16" }
      ]
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Video corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Grid & Slider Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop (1200px+)",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "slider_desktop",
      "label": "Enable Slider on Desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_laptop",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columns on Laptop (990px - 1199px)",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "slider_laptop",
      "label": "Enable Slider on Laptop",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Columns on Tablet (750px - 989px)",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "slider_tablet",
      "label": "Enable Slider on Tablet",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile (< 750px)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.3", "label": "1.3" },
        { "value": "1.5", "label": "1.5" },
        { "value": "1.8", "label": "1.8" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "1.3"
    },
    {
      "type": "checkbox",
      "id": "slider_mobile",
      "label": "Enable Slider on Mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slider_arrows",
      "label": "Show Slider Arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Section surface",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "accent", "label": "Accent" },
        { "value": "transition", "label": "Transition" }
      ],
      "default": "accent",
      "info": "Page and Accent hold their colour. Transition fades from the colour of the section above to the other one. A hold that follows the other colour is shown as a transition and flagged here."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Step number", "default": "01" },
        { "type": "video", "id": "video", "label": "Shopify video (uploaded file)" },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "YouTube / Vimeo link",
          "accept": ["youtube", "vimeo"],
          "info": "Agar Shopify video select hai to wo use hoga, ye link ignore hoga."
        },
        { "type": "image_picker", "id": "poster", "label": "Image" },
        { "type": "checkbox", "id": "loop", "label": "Loop video", "default": true },
        { "type": "checkbox", "id": "show_text", "label": "Show title below video", "default": true },
        { "type": "text", "id": "title", "label": "Title", "default": "Rinse before" },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h4",
          "label": "Heading size"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" },
            { "value": "p", "label": "p" },
            { "value": "div", "label": "div" }
          ],
          "default": "h4",
          "label": "SEO Heading tag"
        },
        { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Start with a rinse before brushing."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works (Steps)",
      "blocks": [
        {
          "type": "step",
          "settings": { "number": "01", "title": "Rinse before", "description": "Start with a rinse before brushing." }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Pump and brush",
            "description": "Apply one pump and brush gently for two minutes."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Spit, no rinse",
            "description": "Spit out the excess. Do not rinse afterwards."
          }
        }
      ]
    }
  ]
}
{% endschema %}
