{%- comment -%}
  How it works / Ritual steps section
  - No color settings and no color values in CSS.
  - Section header snippet ka use nahi hua.
  - Video: Shopify uploaded video, YouTube ya Vimeo link.
  - Font-family, font-weight, font-style, font-size, max-width static hain (CSS mein edit karo).
{%- endcomment -%}

{%- style -%}
    {%- if section.settings.bg_gradient_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
            background: {{ section.settings.bg_gradient_day }};
        }
    {%- elsif section.settings.bg_color_day != blank -%}
        body:not(.night-mode) .section-{{ section.id }},
        body.day-mode .section-{{ section.id }} {
            background-color: {{ section.settings.bg_color_day }};
        }
    {%- endif -%}

    {%- if section.settings.bg_gradient_night != blank -%}
        body.night-mode .section-{{ section.id }} {
            background: {{ section.settings.bg_gradient_night }};
        }
    {%- elsif section.settings.bg_color_night != blank -%}
        body.night-mode .section-{{ section.id }} {
            background-color: {{ section.settings.bg_color_night }};
        }
    {%- endif -%}

    {% if section.settings.text_color_day != blank %}
        body:not(.night-mode) .karmicare-footer *,
        body.day-mode .karmicare-footer * {
        color: {{ section.settings.text_color_day }};
        }
    {% endif %}

    {% if section.settings.text_color_night != blank %}
        body.night-mode .karmicare-footer * {
        color: {{ section.settings.text_color_night }};
        }
    {% endif %}

  .kc-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: inherit;
    font-weight: 400;
    font-style: normal;
  }
  .kc-section .kc-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .kc-section .kc-head {
    text-align: center;
    margin-bottom: 40px;
  }
  .kc-section .kc-subtitle {
    margin: 0 0 16px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .kc-section .kc-title {
    margin: 0 0 16px;
  }
  .kc-section .kc-description {
    margin: 0 auto;
    max-width: 640px;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.75;
  }
  .kc-section .kc-description p { margin: 0; }

  .kc-section .kc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .kc-section .kc-card {
    position: relative;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .kc-section .kc-media,
  .kc-section .kc-media video,
  .kc-section .kc-media iframe,
  .kc-section .kc-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    display: block;
  }
  .kc-section .kc-media iframe { pointer-events: none; }

  .kc-section .kc-number {
    position: absolute;
    top: 14px;
    left: 18px;
    z-index: 2;
    font-family: inherit;
    font-weight: 400;
    font-style: normal;
    font-size: 32px;
    line-height: 1;
    pointer-events: none;
  }
  .kc-section .kc-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .kc-section .kc-play {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  .kc-section .kc-play svg { width: 12px; height: 12px; margin-left: 2px; fill: currentColor; }
  .kc-section .kc-hint { font-size: 11px; }
  .kc-section .kc-card.is-playing .kc-overlay { opacity: 0; }

  .kc-section .kc-step-title {
    margin: 20px 0 6px;
    font-family: inherit;
    font-weight: 400;
    font-style: normal;
    font-size: 20px;
    line-height: 1.25;
  }
  .kc-section .kc-step-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.75;
  }
  .kc-section .kc-bottom {
    margin: 48px 0 0;
    text-align: center;
    font-size: 11px;
  }

  @media screen and (min-width: 750px) {
    .kc-section .kc-title { font-size: 36px; }
    .kc-section .kc-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<section class="kc-section section-{{ section.id }}">
  <div class="kc-inner">

    {%- if section.settings.subtitle != blank or section.settings.title != blank or section.settings.description != blank -%}
      <div class="kc-head">
        {%- if section.settings.subtitle != blank -%}
          <p class="kc-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="kc-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="kc-description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="kc-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign video_type = 'none'
          if block.settings.video != blank
            assign video_type = 'shopify'
          elsif block.settings.video_url != blank
            assign video_type = block.settings.video_url.type
          endif
          assign loop = block.settings.loop
        -%}
        <div class="kc-step" {{ block.shopify_attributes }}>
          <div class="kc-card" data-type="{{ video_type }}" data-loop="{{ loop }}">
            <div class="kc-media">
              {%- if video_type == 'shopify' -%}
                {{
                  block.settings.video
                  | video_tag:
                    image_size: '900x',
                    autoplay: false,
                    loop: loop,
                    muted: true,
                    controls: false,
                    playsinline: true,
                    preload: 'metadata'
                }}
              {%- elsif video_type == 'youtube' -%}
                {%- liquid
                  assign yt_src = 'https://www.youtube-nocookie.com/embed/' | append: block.settings.video_url.id | append: '?enablejsapi=1&controls=0&mute=1&playsinline=1&rel=0&modestbranding=1'
                  if loop
                    assign yt_src = yt_src | append: '&loop=1&playlist=' | append: block.settings.video_url.id
                  endif
                -%}
                <iframe src="{{ yt_src }}" title="{{ block.settings.title | escape }}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
              {%- elsif video_type == 'vimeo' -%}
                {%- liquid
                  assign vm_src = 'https://player.vimeo.com/video/' | append: block.settings.video_url.id | append: '?muted=1&controls=0&playsinline=1&title=0&byline=0&portrait=0'
                  if loop
                    assign vm_src = vm_src | append: '&loop=1'
                  endif
                -%}
                <iframe src="{{ vm_src }}" title="{{ block.settings.title | escape }}" loading="lazy" allow="autoplay; picture-in-picture" allowfullscreen></iframe>
              {%- elsif block.settings.poster != blank -%}
                {{ block.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900' }}
              {%- endif -%}
            </div>

            {%- if block.settings.number != blank -%}
              <span class="kc-number">{{ block.settings.number }}</span>
            {%- endif -%}

            {%- if video_type != 'none' -%}
              <div class="kc-overlay">
                <span class="kc-play">
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 0l11 6-11 6z"/></svg>
                </span>
                {%- if section.settings.hint_text != blank -%}
                  <span class="kc-hint">{{ section.settings.hint_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.show_text -%}
            {%- if block.settings.title != blank -%}
              <h3 class="kc-step-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.show_description and block.settings.description != blank -%}
              <p class="kc-step-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.bottom_text != blank -%}
      <p class="kc-bottom">{{ section.settings.bottom_text }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    function post(iframe, data) {
      if (iframe && iframe.contentWindow) iframe.contentWindow.postMessage(JSON.stringify(data), '*');
    }

    function play(card) {
      var type = card.dataset.type;
      if (type === 'shopify') {
        var v = card.querySelector('video');
        if (v) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      } else if (type === 'youtube') {
        post(card.querySelector('iframe'), { event: 'command', func: 'playVideo', args: [] });
      } else if (type === 'vimeo') {
        post(card.querySelector('iframe'), { method: 'play' });
      } else { return; }
      card.classList.add('is-playing');
    }

    function pause(card) {
      var type = card.dataset.type;
      if (type === 'shopify') {
        var v = card.querySelector('video');
        if (v) v.pause();
      } else if (type === 'youtube') {
        post(card.querySelector('iframe'), { event: 'command', func: 'pauseVideo', args: [] });
      } else if (type === 'vimeo') {
        post(card.querySelector('iframe'), { method: 'pause' });
      } else { return; }
      card.classList.remove('is-playing');
    }

    document.querySelectorAll('.kc-section:not([data-kc-init])').forEach(function (root) {
      root.setAttribute('data-kc-init', 'true');

      root.querySelectorAll('.kc-card').forEach(function (card) {
        var pinned = false;

        function togglePin() {
          if (pinned) {
            pinned = false;
            card.classList.remove('is-pinned');
            pause(card);
          } else {
            pinned = true;
            card.classList.add('is-pinned');
            play(card);
          }
        }

        if (canHover) {
          // Desktop: hover = play, leave = pause (sirf agar click/pin nahi kiya)
          card.addEventListener('mouseenter', function () {
            if (!pinned) play(card);
          });
          card.addEventListener('mouseleave', function () {
            if (!pinned) pause(card);
          });
          // Click = pin (bahar jaane pe bhi chalta rahega), dobara click = pause
          card.addEventListener('click', togglePin);
        } else {
          // Mobile: tap = play/pause toggle
          card.addEventListener('click', togglePin);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "How it works (Steps)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The Ritual" },
    { "type": "text", "id": "title", "label": "Title", "default": "How Karmicare works." },
    { "type": "richtext", "id": "description", "label": "Short description", "default": "<p>Become a pro at brushing. Feel your teeth by sliding your tongue.</p>" },
    { "type": "text", "id": "hint_text", "label": "Video hint text", "default": "Hover or tap to watch" },
    { "type": "textarea", "id": "bottom_text", "label": "Section bottom tag", "default": "Not to be combined with fluoride oral care. One duo lasts 64 days at two brushings a day." },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video aspect ratio",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "9 / 16", "label": "Portrait 9:16" }
      ]
    },
    { "type": "range", "id": "radius", "label": "Video corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },

    { "type": "header", "content": "Custom CSS (colors yahan add karein)" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS" },

    {
      "type": "header",
      "content": "Day Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_day",
      "label": "Text Color (Day)"
    },
    {
      "type": "color",
      "id": "bg_color_day",
      "label": "Background Color (Day)"
    },
    {
      "type": "text",
      "id": "bg_gradient_day",
      "label": "Background Gradient (Day)"
    },
    {
      "type": "color",
      "id": "card_bg_color_day",
      "label": "Card Background Color (Day)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Night Mode Colors"
    },
    {
      "type": "color",
      "id": "text_color_night",
      "label": "Text Color (Night)"
    },
    {
      "type": "color",
      "id": "bg_color_night",
      "label": "Background Color (Night)"
    },
    {
      "type": "text",
      "id": "bg_gradient_night",
      "label": "Background Gradient (Night)"
    },
    {
      "type": "color",
      "id": "card_bg_color_night",
      "label": "Card Background Color (Night)",
      "default": "#191f38"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Step number", "default": "01" },
        { "type": "video", "id": "video", "label": "Shopify video (uploaded file)" },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "YouTube / Vimeo link",
          "accept": ["youtube", "vimeo"],
          "info": "Agar Shopify video select hai to wo use hoga, ye link ignore hoga."
        },
        { "type": "image_picker", "id": "poster", "label": "Image (sirf jab video na ho)" },
        { "type": "checkbox", "id": "loop", "label": "Loop video", "default": true },
        { "type": "checkbox", "id": "show_text", "label": "Show title below video", "default": true },
        { "type": "text", "id": "title", "label": "Title", "default": "Rinse before" },
        { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Start with a rinse before brushing." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works (Steps)",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Rinse before", "description": "Start with a rinse before brushing." } },
        { "type": "step", "settings": { "number": "02", "title": "Pump and brush", "description": "Apply one pump and brush gently for two minutes." } },
        { "type": "step", "settings": { "number": "03", "title": "Spit, no rinse", "description": "Spit out the excess. Do not rinse afterwards." } }
      ]
    }
  ]
}
{% endschema %}