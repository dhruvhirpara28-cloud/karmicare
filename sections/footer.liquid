{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{% comment %}
  KC footer, Figma homepage desktop 2642:2323 and mobile 2766:10773 (file iR5disvadVeKd5YmAt8sla).
  Spacing and type read the --kc-responsive-* tokens, which switch from the mobile to the
  desktop value at 750px, so one rule covers both frames. Figma text/primary, surface/primary and
  surface/secondary are held at old values (docs/design-tokens/baseline/proposals.md P1-P3);
  their same-value twins text/default/heading, surface/page and surface/page/secondary are used.
  section-footer.css stays: it defines the animateLocalization keyframe that
  component-localization-form.css runs on the country dropdown below.
{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'kc-coming-soon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kc-coming-soon.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.newsletter_enable and section.settings.klaviyo_public_key != blank -%}
  <script src="{{ 'kc-footer-newsletter.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  /* A global rule sets line-height: normal on p, span, li, label and headings; text in the
     footer takes the line height of the element that sets its type style instead. */
  .karmicare-footer :where(p, span, li, label, ul) {
    line-height: inherit;
  }

  /* --sticky-cta-height is the product page's fixed purchase bar while it shows
     (snippets/sticky-cart-block.liquid); 0 on pages without the bar. */
  .karmicare-footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    padding-bottom: calc({{ section.settings.padding_bottom_mobile }}px + var(--sticky-cta-height, 0px));
    color: var(--kc-mapped-text-default-heading);
    font-family: var(--kc-font-role-backbone);
  }

  {% if section.settings.text_color_day != blank %}
    body:not(.night-mode) .karmicare-footer *,
    body.day-mode .karmicare-footer * {
      color: {{ section.settings.text_color_day }};
    }
  {% endif %}

  {% if section.settings.text_color_night != blank %}
    body.night-mode .karmicare-footer * {
      color: {{ section.settings.text_color_night }};
    }
  {% endif %}

  .km-footer {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--kc-responsive-spacing-page-gutter);
  }

  .km-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-section-md);
    padding-top: {{ section.settings.padding_top_mobile }}px;
  }

  {% if section.settings.show_top_border %}
    .km-footer__inner {
      border-top: var(--kc-shape-stroke-thin) solid var(--kc-mapped-border-primary-hairline);
    }
  {% endif %}

  /* Footer top: brand, menu, newsletter */
  .km-footer-top {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-2xl);
  }

  .km-footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-2xl);
  }

  .km-footer-brand__logo {
    display: block;
    width: 210px;
    line-height: 0;
  }

  .km-footer-brand__logo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .km-footer-brand__name {
    margin: 0;
    font-size: var(--kc-responsive-h4-text-size);
    line-height: var(--kc-responsive-h4-line-height);
  }

  .km-footer-slogan {
    max-width: 286px;
    margin: 0;
    font-family: var(--kc-font-use-heading);
    font-weight: var(--font-500-weight);
    font-size: var(--kc-responsive-h4-text-size);
    line-height: var(--kc-responsive-h4-line-height);
    letter-spacing: var(--kc-responsive-h4-letter-spacing-sm);
    color: var(--kc-mapped-text-default-body);
  }

  .km-footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-lg);
  }

  .km-footer-heading {
    margin: 0;
    font-family: var(--kc-font-role-backbone);
    font-weight: var(--font-500-weight);
    font-size: var(--kc-responsive-label-sm-text-size);
    line-height: var(--kc-responsive-label-sm-line-height);
    letter-spacing: var(--kc-responsive-caption-letter-spacing);
    text-transform: uppercase;
    color: var(--kc-mapped-text-default-body);
  }

  .km-footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-xxs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* inline-block: the link fills its 26/28px line, a tap target of at least 24px with the
     same layout */
  .km-footer-links a {
    display: inline-block;
    font-weight: var(--font-600-weight);
    font-size: var(--kc-responsive-body-lg-text-size);
    line-height: var(--kc-responsive-body-lg-line-height);
    letter-spacing: var(--kc-responsive-body-lg-letter-spacing);
    color: var(--kc-mapped-text-default-heading);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }

  .km-footer-links a:not(.kc-coming-soon):hover {
    color: var(--kc-mapped-text-link-default-hover);
  }

  /* Coming soon (snippets/kc-coming-soon.liquid): the tip starts at the link's left edge, as
     the links do, so it stays inside the page gutter. From 1200px, where the menu column has
     room for it, it sits beside the link, so it doesn't cover the next one; beside a long FR
     label on a tablet it would widen the page, even while hidden (R15 F1). */
  .km-footer-links .kc-coming-soon .kc-coming-soon__tip {
    left: 0;
    transform: none;
  }

  @media screen and (min-width: 1200px) {
    .km-footer-links .kc-coming-soon .kc-coming-soon__tip {
      top: 50%;
      left: calc(100% + var(--kc-responsive-spacing-layout-xs));
      transform: translateY(-50%);
      translate: 0 0;
    }

    .km-footer-links .kc-coming-soon .kc-coming-soon__tip::before {
      top: 0;
      bottom: 0;
      left: auto;
      right: 100%;
      width: calc(var(--kc-responsive-spacing-layout-xs) + var(--kc-responsive-spacing-layout-xxs));
      height: auto;
    }
  }

  /* Newsletter: KC/Field (persistent label, 68px target from 750px and 60px below, 44px submit) */
  .km-footer-newsletter__body {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-md);
  }

  .km-footer-field {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-xs);
  }

  .km-footer-field__label,
  .km-footer-field__input,
  .km-footer-field__submit {
    font-family: var(--kc-font-role-backbone);
    font-weight: var(--font-400-weight);
    font-size: var(--kc-responsive-body-md-text-size);
    line-height: var(--kc-responsive-body-md-line-height);
    letter-spacing: 0;
    color: var(--kc-mapped-text-default-heading);
  }

  /* Figma insets the 44px submit by layout/sm (12 / 8) from the outer edge, with the stroke
     inside the frame: 68 / 60px outer. The border takes its width out of that inset. */
  .km-footer-field__target {
    display: flex;
    align-items: center;
    gap: var(--kc-responsive-spacing-layout-sm);
    padding: calc(var(--kc-responsive-spacing-layout-sm) - var(--kc-shape-stroke-thin)) var(--kc-responsive-spacing-layout-md);
    background-color: var(--kc-mapped-surface-page);
    border: var(--kc-shape-stroke-thin) solid var(--kc-mapped-border-control-default);
    border-radius: var(--kc-shape-radius-md);
    box-shadow: var(--kc-elevation-xs);
    transition: border-color 0.15s ease-out, box-shadow 0.15s ease-out;
  }

  .km-footer-field__target:focus-within {
    border-color: var(--kc-mapped-border-focus-default);
    box-shadow: 0 0 0 var(--kc-shape-stroke-thin) var(--kc-mapped-border-focus-default);
  }

  /* Fills the 44px row, so the whole row height is the input's click target */
  .km-footer-field__input {
    flex: 1 1 auto;
    align-self: stretch;
    min-width: 0;
    padding: 0;
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
  }

  .km-footer-field__input::placeholder {
    color: var(--kc-mapped-text-default-placeholder);
    opacity: 1;
  }

  .km-footer-field__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease-out;
  }

  .km-footer-field__submit:hover {
    color: var(--kc-mapped-text-link-default-hover);
  }

  .km-footer-field__submit:focus-visible {
    outline: 2px solid var(--kc-mapped-border-focus-default);
    outline-offset: 2px;
    border-radius: var(--kc-shape-radius-sm);
  }

  .km-footer-field__message,
  .km-footer-newsletter__note {
    margin: 0;
    font-size: var(--kc-responsive-body-sm-text-size);
    line-height: var(--kc-responsive-body-sm-line-height);
    letter-spacing: var(--kc-responsive-body-sm-letter-spacing);
  }

  .km-footer-field__message {
    color: var(--kc-mapped-text-default-heading);
  }

  /* The JS live regions exist from render so screen readers announce them; while empty they
     leave the flex flow (no gap slot) but stay in the accessibility tree. */
  .km-footer-field__message:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .km-footer-newsletter__note {
    color: var(--kc-mapped-text-default-body);
  }

  .km-footer-newsletter__note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* Footer bottom: socials + localisation, then the legal row */
  .km-footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-xl);
  }

  .km-footer-middle,
  .km-footer-legal {
    padding-top: var(--kc-responsive-spacing-layout-xl);
    border-top: var(--kc-shape-stroke-thin) solid var(--kc-mapped-border-primary-hairline);
  }

  .km-footer-middle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kc-responsive-spacing-layout-xs);
  }

  .km-footer-socials {
    display: flex;
    align-items: center;
    gap: var(--kc-responsive-spacing-layout-sm);
  }

  .km-footer-social-icon {
    display: flex;
    align-items: center;
    padding: var(--kc-responsive-spacing-layout-sm);
    background-color: var(--kc-mapped-surface-page-secondary);
    border-radius: var(--kc-shape-radius-md);
    color: var(--kc-mapped-icon-primary-default);
    text-decoration: none;
    transition: background-color 0.15s ease-out;
  }

  .km-footer-social-icon svg {
    display: block;
    flex: none;
  }

  .km-footer-social-icon:hover {
    background-color: var(--kc-mapped-surface-secondary-default-hover);
  }

  .km-footer-social-icon:focus-visible,
  .km-footer-locale__button:focus-visible,
  .km-footer-links a:focus-visible,
  .km-footer-legal__links a:focus-visible,
  .km-footer-newsletter__note a:focus-visible {
    outline: 2px solid var(--kc-mapped-border-focus-default);
    outline-offset: 2px;
  }

  .km-footer-locale {
    position: relative;
  }

  .km-footer-locale .disclosure {
    position: relative;
  }

  .km-footer .km-footer-locale__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kc-responsive-spacing-layout-md);
    min-width: 144px;
    min-height: 0;
    margin: 0;
    padding: var(--kc-responsive-spacing-layout-xs);
    background-color: var(--kc-mapped-surface-page-secondary);
    border: none;
    border-radius: var(--kc-shape-radius-sm);
    box-shadow: none;
    color: var(--kc-mapped-text-default-heading);
    font-family: var(--kc-font-role-backbone);
    font-weight: var(--font-500-weight);
    font-size: var(--kc-responsive-label-sm-text-size);
    line-height: var(--kc-responsive-label-sm-line-height);
    letter-spacing: var(--kc-responsive-caption-letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .km-footer-locale__current {
    display: flex;
    align-items: center;
    gap: var(--kc-responsive-spacing-layout-md);
  }

  .km-footer-locale__flag {
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .km-footer-locale__chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
  }

  .km-footer .km-footer-locale__chevron .icon-caret {
    position: static;
    width: 10px;
    height: 6px;
    transition: transform 0.2s ease-out;
  }

  .km-footer-locale__button[aria-expanded='true'] .icon-caret {
    transform: rotate(180deg);
  }

  .km-footer .km-footer-locale__panel {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: auto;
    top: auto;
    z-index: 3;
    margin-bottom: var(--kc-responsive-spacing-layout-xs);
    padding: 0;
    background-color: var(--kc-mapped-surface-page-secondary);
    border: var(--kc-shape-stroke-thin) solid var(--kc-mapped-border-primary-hairline);
    border-radius: var(--kc-shape-radius-md);
    box-shadow: var(--kc-elevation-xs);
    overflow: hidden;
  }

  .km-footer-locale__list {
    min-width: 200px;
    max-height: 320px;
    overflow-y: auto;
    padding: var(--kc-responsive-spacing-layout-md);
    scrollbar-width: thin;
  }

  .km-footer-locale__group-title {
    margin: 0 0 var(--kc-responsive-spacing-layout-xs);
    font-weight: var(--font-700-weight);
    font-size: var(--kc-responsive-label-sm-text-size);
    line-height: var(--kc-responsive-label-sm-line-height);
    letter-spacing: var(--kc-responsive-caption-letter-spacing);
    text-transform: uppercase;
    color: var(--kc-mapped-text-default-body);
  }

  .km-footer-locale__group + .km-footer-locale__group-title {
    margin-top: var(--kc-responsive-spacing-layout-md);
  }

  .km-footer-locale__group {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .km-footer .km-footer-locale__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kc-responsive-spacing-layout-xs);
    padding: 6px 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--kc-mapped-text-default-heading);
    text-decoration: none;
  }

  .km-footer .km-footer-locale__link:hover {
    color: var(--kc-mapped-text-link-default-hover);
  }

  .km-footer-locale__country {
    display: flex;
    align-items: center;
    gap: var(--kc-responsive-spacing-layout-xs);
  }

  .km-footer-locale__country img {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    object-fit: cover;
  }

  .km-footer-locale__currency {
    color: var(--kc-mapped-text-default-body);
  }

  .km-footer-legal {
    display: flex;
    flex-direction: column;
    gap: var(--kc-responsive-spacing-layout-xl);
  }

  .km-footer-legal__copyright,
  .km-footer-legal__links {
    font-family: var(--kc-font-use-body);
    font-weight: var(--font-400-weight);
    font-size: var(--kc-responsive-body-sm-text-size);
    line-height: var(--kc-responsive-body-sm-line-height);
    letter-spacing: var(--kc-responsive-body-sm-letter-spacing);
    color: var(--kc-mapped-text-default-body);
  }

  .km-footer-legal__copyright p {
    margin: 0 0 var(--kc-responsive-body-sm-paragraph-spacing);
  }

  .km-footer-legal__copyright p:last-child {
    margin-bottom: 0;
  }

  .km-footer-legal__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--kc-responsive-spacing-layout-comfortable);
  }

  .km-footer-legal__links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--kc-responsive-spacing-layout-xs);
  }

  .km-footer-legal__links a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .km-footer-legal__links a:hover {
    color: var(--kc-mapped-text-link-default-hover);
  }

  .km-footer-payments {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  /* The payment methods switched on in Shopify, in the Figma footer's monochrome style
     (Victor, 21 Oct, G-5). Grayscale only: each identifying mark keeps at least 3:1 on its
     own opaque chip, Day and Night alike (lowest: Mastercard's right circle 3.36:1 with the
     rule below, then Maestro 3.74:1); softening it further drops MobilePay below 3:1
     (R15 F2). */
  .km-footer-payments svg {
    display: block;
    width: 38px;
    height: 24px;
    filter: grayscale(1);
  }

  /* Mastercard's red circle turns 1.30:1 on its dark chip in grayscale (R15b F2): a light chip
     like the others, with both circles and their overlap in greys that stay apart and each
     clear 3:1 on white (#595959 7.0:1, #8c8c8c 3.4:1, #333 12.6:1). Its colours are inline
     styles (display-p3 included), hence !important. Paths: outer chip, inner chip, left
     circle, right circle, overlap. */
  .km-footer-payments svg[aria-labelledby='pi-master'] path:nth-of-type(1) {
    fill: #ededed !important;
  }
  .km-footer-payments svg[aria-labelledby='pi-master'] path:nth-of-type(2) {
    fill: #ffffff !important;
  }
  .km-footer-payments svg[aria-labelledby='pi-master'] path:nth-of-type(3) {
    fill: #595959 !important;
  }
  .km-footer-payments svg[aria-labelledby='pi-master'] path:nth-of-type(4) {
    fill: #8c8c8c !important;
  }
  .km-footer-payments svg[aria-labelledby='pi-master'] path:nth-of-type(5) {
    fill: #333333 !important;
  }

  @media screen and (min-width: 750px) {
    .karmicare-footer {
      margin-top: {{ section.settings.margin_top }}px;
      padding-bottom: calc({{ section.settings.padding_bottom }}px + var(--sticky-cta-height, 0px));
    }

    .km-footer__inner {
      padding-top: {{ section.settings.padding_top }}px;
    }

    .km-footer-top {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .km-footer-slogan {
      letter-spacing: var(--kc-responsive-h4-letter-spacing);
    }

    .km-footer-column--newsletter {
      flex: 1 1 320px;
    }

    .km-footer-legal__links a {
      text-decoration: none;
    }

    .km-footer-payments {
      gap: var(--kc-responsive-spacing-layout-xxs);
    }
  }

  /* Desktop per the Figma homepage: 286 / 215 / fill columns 160px apart */
  @media screen and (min-width: 1200px) {
    .km-footer-top {
      flex-wrap: nowrap;
      gap: var(--kc-responsive-spacing-section-lg);
    }

    .km-footer-brand {
      flex: 0 0 286px;
    }

    .km-footer-column--menu {
      flex: 0 0 215px;
    }

    /* Copyright and legal links read as two blocks (Figma 2928:20208 keeps ~80 px between them) */
    .km-footer-legal {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--kc-responsive-spacing-layout-3xl);
    }

    .km-footer-legal__copyright {
      flex: 0 1 912px;
    }

    .km-footer-legal__side {
      align-self: stretch;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--kc-responsive-spacing-layout-lg);
    }

    .km-footer-legal__links {
      flex-wrap: nowrap;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .km-footer-links a,
    .km-footer-field__target,
    .km-footer-field__submit,
    .km-footer-social-icon,
    .km-footer .km-footer-locale__chevron .icon-caret {
      transition: none;
    }
  }
{%- endstyle -%}

{%- liquid
  # Legal links go to the designed pages under /pages. The policies in Settings > Policies
  # stay for checkout and order emails, and are only the fallback here.
  assign legal_terms = section.settings.legal_terms_page
  if legal_terms == blank
    assign legal_terms = pages['terms-and-conditions-1']
  endif
  if legal_terms == blank
    assign legal_terms = shop.terms_of_service
  endif

  assign legal_privacy = section.settings.legal_privacy_page
  if legal_privacy == blank
    assign legal_privacy = pages['privacy-policy']
  endif
  if legal_privacy == blank
    assign legal_privacy = shop.privacy_policy
  endif

  assign legal_consumer_rights = section.settings.legal_consumer_rights_page
  if legal_consumer_rights == blank
    assign legal_consumer_rights = pages['new-consumer-rights']
  endif
  if legal_consumer_rights == blank
    assign legal_consumer_rights = shop.refund_policy
  endif

  # Link texts: a blank setting uses the translated default (t output is escaped, hence escape_once)
  assign legal_terms_default = 'kc.footer.legal_terms' | t
  assign legal_privacy_default = 'kc.footer.legal_privacy' | t
  assign legal_consumer_rights_default = 'kc.footer.legal_consumer_rights' | t

  # A menu item without a page yet links to '#' (the root URL plus '#' on /nl and /fr)
  assign kc_soon_url = routes.root_url | append: '#'
-%}

<footer class="karmicare-footer kc-surface" data-kc-surface="{{ section.settings.surface }}">
  <div class="km-footer">
    <div class="km-footer__inner">
      <div class="km-footer-top">
        <div class="km-footer-brand">
          {%- if section.settings.logo_svg != blank -%}
            <div class="km-footer-brand__logo">
              {{ section.settings.logo_svg }}
            </div>
          {%- else -%}
            <p class="km-footer-brand__name">{{ shop.name }}</p>
          {%- endif -%}

          {%- if section.settings.slogan != blank -%}
            {%- liquid
              # The slogan is two lines without punctuation, so the break is marked in the text itself
              # (R24-1, R27-1): "[[br]]" in the saved value or a translation becomes a line break, as
              # does a saved newline or <br>. Without a marker there is no break.
              assign slogan = section.settings.slogan | newline_to_br | replace: '[[br]]', '<br>'
            -%}
            <p class="km-footer-slogan">{{ slogan }}</p>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div class="km-footer-column km-footer-column--menu" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="km-footer-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="km-footer-links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      {%- if link.url == '#' or link.url == kc_soon_url -%}
                        {%- comment -%} No page yet: shown, not clickable, "Coming soon" on hover, focus or tap (as the header) {%- endcomment -%}
                        {%- assign soon_id = 'FooterMenu-' | append: block.id | append: '-' | append: link.handle -%}
                        {%- render 'kc-coming-soon', id: soon_id, label: link.title -%}
                      {%- else -%}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.newsletter_enable -%}
          <div class="km-footer-column km-footer-column--newsletter">
            <h3 class="km-footer-heading">{{ section.settings.newsletter_heading | default: 'NEWSLETTER' }}</h3>

            {%- liquid
              # Klaviyo (kc-footer-newsletter.js): list per language, locale for Smart Translations.
              # Empty key or list = plain Shopify form.
              assign kc_nl_lang = request.locale.iso_code | split: '-' | first | downcase
              assign kc_nl_key = section.settings.klaviyo_public_key | strip
              assign kc_nl_list = section.settings.klaviyo_list_id | strip
              case kc_nl_lang
                when 'nl'
                  assign kc_nl_locale = 'nl-BE'
                  assign kc_nl_list_override = section.settings.klaviyo_list_id_nl | strip
                when 'fr'
                  assign kc_nl_locale = 'fr-BE'
                  assign kc_nl_list_override = section.settings.klaviyo_list_id_fr | strip
                else
                  assign kc_nl_lang = 'en'
                  assign kc_nl_locale = 'en'
                  assign kc_nl_list_override = section.settings.klaviyo_list_id_en | strip
              endcase
              if kc_nl_list_override != blank
                assign kc_nl_list = kc_nl_list_override
              endif
              assign kc_nl_source = 'Footer newsletter · ' | append: kc_nl_lang
            -%}
            <div
              class="km-footer-newsletter__body"
              id="FooterNewsletter"
              data-klaviyo-key="{{ kc_nl_key | escape }}"
              data-klaviyo-list="{{ kc_nl_list | escape }}"
              data-locale="{{ kc_nl_locale }}"
              data-source="{{ kc_nl_source | escape }}"
              data-consent-version="footer-2026-10"
              data-msg-success="{{ 'kc.footer.check_inbox' | t | escape }}"
              data-msg-invalid="{{ 'kc.footer.email_invalid' | t | escape }}"
            >
              {%- form 'customer', id: 'FooterNewsletterForm', class: 'km-footer-field' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="km-footer-field__label" for="FooterNewsletterEmail">{{ 'kc.footer.email' | t }}</label>
                <div class="km-footer-field__target">
                  <input
                    id="FooterNewsletterEmail"
                    class="km-footer-field__input"
                    type="email"
                    name="contact[email]"
                    placeholder="{{ 'kc.footer.email_placeholder' | t }}"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    required
                    {% if form.errors %}
                      aria-invalid="true"
                    {% endif %}
                    aria-describedby="{% if form.errors or form.posted_successfully? %}FooterNewsletterEmail-message {% endif %}FooterNewsletterEmail-note"
                  >
                  <button type="submit" name="commit" class="km-footer-field__submit">{{ 'kc.footer.join' | t }}</button>
                </div>
                {%- if form.errors -%}
                  <p class="km-footer-field__message" id="FooterNewsletterEmail-message" role="alert">
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </p>
                {%- elsif form.posted_successfully? -%}
                  <p class="km-footer-field__message" id="FooterNewsletterEmail-message" role="status">
                    {{ 'newsletter.success' | t }}
                  </p>
                {%- endif -%}
                {%- comment -%} Live regions for kc-footer-newsletter.js: present from render, empty until used. {%- endcomment -%}
                <p class="km-footer-field__message" id="FooterNewsletterEmail-error" role="alert"></p>
                <p class="km-footer-field__message" id="FooterNewsletterEmail-status" role="status"></p>
              {%- endform -%}

              <p class="km-footer-newsletter__note" id="FooterNewsletterEmail-note">
                {{ 'kc.footer.consent_html' | t: terms_url: legal_terms.url, privacy_url: legal_privacy.url }}
              </p>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="km-footer-bottom">
        <div class="km-footer-middle">
          <div class="km-footer-socials">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" class="km-footer-social-icon" aria-label="Instagram">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                >
                  <g clip-path="url(#clip0_2906_783)">
                    <mask id="mask0_2906_783" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="16">
                      <path d="M16 0H0V16H16V0Z" fill="white"/>
                    </mask>
                    <g mask="url(#mask0_2906_783)">
                      <path d="M7.99978 3.89156C5.73125 3.89156 3.89188 5.73128 3.89188 7.99978C3.89188 10.2688 5.73125 12.1077 7.99978 12.1077C10.2688 12.1077 12.1084 10.2688 12.1084 7.99978C12.1084 5.73128 10.2688 3.89156 7.99978 3.89156ZM7.99978 10.6665C6.52728 10.6665 5.33303 9.47266 5.33303 7.99978C5.33303 6.52694 6.52725 5.33306 7.99978 5.33306C9.47262 5.33306 10.6668 6.52694 10.6668 7.99978C10.6668 9.47262 9.47262 10.6665 7.99978 10.6665ZM13.2304 3.72947C13.2304 4.25922 12.8005 4.68913 12.2704 4.68913C11.7404 4.68913 11.3104 4.25922 11.3104 3.72947C11.3104 3.1995 11.7403 2.76947 12.2704 2.76947C12.8005 2.76947 13.2304 3.1995 13.2304 3.72947ZM15.58 2.75963C15.3755 2.23331 15.102 1.78737 14.6575 1.34256C13.7608 0.445219 12.534 0.104094 11.2986 0.0481563C10.4452 0.00871875 10.1728 0 7.99978 0C5.82756 0 5.55512 0.00871875 4.70169 0.0481563C3.46334 0.104219 2.23794 0.447469 1.34291 1.34253C0.444375 2.24106 0.104844 3.46409 0.0480312 4.70169C0.00915625 5.55512 0 5.82725 0 7.99978C0 10.1723 0.00915625 10.4449 0.0480312 11.2987C0.105094 12.5406 0.444031 13.759 1.34284 14.6571C2.24153 15.5551 3.46419 15.8952 4.70169 15.9518C5.55512 15.9908 5.82756 15.9997 7.99978 15.9997C10.1728 15.9997 10.4452 15.9908 11.2987 15.9518C12.539 15.895 13.7605 15.5547 14.6574 14.6571C15.5538 13.7602 15.8958 12.5335 15.9518 11.2986C15.9908 10.4449 16 10.1723 16 7.99975C16 5.82719 15.9908 5.55509 15.9518 4.70166C15.9132 3.84994 15.7779 3.26863 15.58 2.75963ZM14.5118 11.2325C14.4723 12.1014 14.2704 13.0052 13.6382 13.6382C12.9977 14.2796 12.1073 14.472 11.2329 14.5119C10.3891 14.5501 10.1364 14.5585 7.99978 14.5585C5.86391 14.5585 5.61122 14.5501 4.76734 14.5119C3.89078 14.4719 3.00181 14.2763 2.36178 13.6383C1.72359 13.0022 1.52719 12.1008 1.48809 11.2325C1.44987 10.3891 1.4415 10.1361 1.4415 7.99975C1.4415 5.86387 1.44991 5.61087 1.48809 4.767C1.52706 3.90209 1.73284 2.99166 2.36166 2.36178C2.99922 1.72316 3.89744 1.52775 4.76741 1.48806C5.61122 1.44953 5.86391 1.44147 7.99978 1.44147C10.1361 1.44147 10.3891 1.44953 11.233 1.48806C12.109 1.52803 12.9995 1.72278 13.6381 2.36166C14.2771 3.00084 14.4722 3.89569 14.5118 4.76706C14.5505 5.61087 14.5589 5.86387 14.5589 7.99978C14.5588 10.1361 14.5505 10.3891 14.5118 11.2325Z" fill="currentColor"/>
                    </g>
                  </g>
                  <defs>
                    <clipPath id="clip0_2906_783">
                      <rect width="16" height="16" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" class="km-footer-social-icon" aria-label="Facebook">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                >
                  <g clip-path="url(#clip0_2906_755)">
                    <mask id="mask0_2906_755" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="16">
                      <path d="M16 0H0V16H16V0Z" fill="white"/>
                    </mask>
                    <g mask="url(#mask0_2906_755)">
                      <path d="M16 8C16 11.9925 13.0706 15.3025 9.24669 15.9031V10.3276H11.1058L11.4596 8.02119H9.24669V6.52454C9.24669 5.89341 9.55587 5.27848 10.547 5.27848H11.5531V3.31494C11.5531 3.31494 10.6399 3.15911 9.76687 3.15911C7.94452 3.15911 6.75331 4.26367 6.75331 6.26336V8.02119H4.72744V10.3276H6.75331V15.9031C2.93003 15.3019 0 11.9922 0 8C0 3.58174 3.58174 0 8 0C12.4183 0 16 3.58174 16 8Z" fill="currentColor"/>
                    </g>
                  </g>
                  <defs>
                    <clipPath id="clip0_2906_755">
                      <rect width="16" height="16" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_linkedin_link != blank -%}
              <a href="{{ settings.social_linkedin_link }}" class="km-footer-social-icon" aria-label="LinkedIn">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                >
                  <g clip-path="url(#clip0_2906_921)">
                    <mask id="mask0_2906_921" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="16">
                      <path d="M16 0H0V16H16V0Z" fill="white"/>
                    </mask>
                    <g mask="url(#mask0_2906_921)">
                      <path d="M13.2807 13.281H11.0582V9.80031C11.0582 8.97029 11.0434 7.90183 9.90225 7.90183C8.74467 7.90183 8.56758 8.80616 8.56758 9.73988V13.2808H6.34507V6.12306H8.47871V7.10123H8.50858C8.94365 6.35735 9.75257 5.91305 10.6137 5.945C12.8664 5.945 13.2817 7.42672 13.2817 9.35438L13.2807 13.281ZM3.83727 5.14464C3.12495 5.14478 2.5474 4.56739 2.54726 3.85508C2.54713 3.14273 3.1245 2.56517 3.83678 2.56503C4.54911 2.56489 5.12665 3.14228 5.12679 3.85459C5.12692 4.56694 4.54959 5.14454 3.83727 5.14464ZM4.94852 13.281H2.72369V6.12306H4.94852V13.281ZM14.3887 0.501033H1.60686C1.00277 0.494207 0.50738 0.978113 0.5 1.58222V14.4176C0.507137 15.022 1.00246 15.5064 1.60686 15.4999H14.3887C14.9944 15.5075 15.4916 15.0231 15.5 14.4176V1.58132C15.4914 0.976 14.994 0.493064 14.3887 0.501033Z" fill="currentColor"/>
                    </g>
                  </g>
                  <defs>
                    <clipPath id="clip0_2906_921">
                      <rect width="16" height="16" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </a>
            {%- endif -%}
          </div>

          <div class="km-footer-locale isolate">
            {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
              <form
                method="post"
                action="/localization"
                id="FooterUnifiedLocalizationForm"
                accept-charset="UTF-8"
                class="localization-form unified-localization-form"
                enctype="multipart/form-data"
              >
                <input type="hidden" name="form_type" value="localization">
                <input type="hidden" name="utf8" value="✓">
                <input type="hidden" name="_method" value="put">
                <input type="hidden" name="return_to" value="{{ request.path }}">
                <input
                  type="hidden"
                  name="country_code"
                  id="UnifiedCountryCode"
                  value="{{ localization.country.iso_code }}"
                >
                <input type="hidden" name="locale_code" id="UnifiedLocaleCode" value="{{ localization.language.iso_code }}">

                <div class="disclosure unified-disclosure">
                  <button
                    type="button"
                    class="disclosure__button localization-selector km-footer-locale__button"
                    aria-expanded="false"
                    aria-controls="UnifiedLocalizationResults"
                    onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'false' ? 'true' : 'false'); this.nextElementSibling.toggleAttribute('hidden');"
                  >
                    <span class="km-footer-locale__current">
                      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
                        {%- comment -%} Flags from Shopify's CDN: no third-party request before cookie consent {%- endcomment -%}
                        <img
                          class="km-footer-locale__flag"
                          src="{{ localization.country | image_url: width: 48 }}"
                          alt=""
                          width="24"
                          height="24"
                          loading="lazy"
                        >
                      {%- endif -%}
                      <span>
                        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
                          {{- localization.country.currency.iso_code -}}
                        {%- endif -%}
                        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
                          /{{- localization.language.iso_code | upcase -}}
                        {%- endif -%}
                      </span>
                    </span>
                    <span class="km-footer-locale__chevron">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  </button>

                  <div
                    class="disclosure__list-wrapper km-footer-locale__panel"
                    hidden
                    id="UnifiedLocalizationResults"
                  >
                    <div class="km-footer-locale__list">
                      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
                        <p class="km-footer-locale__group-title">{{ 'kc.footer.language' | t }}</p>
                        <ul role="list" class="km-footer-locale__group">
                          {%- for language in localization.available_languages -%}
                            <li>
                              <a
                                class="km-footer-locale__link unified-loc-link"
                                href="#"
                                data-value="{{ language.iso_code }}"
                                data-type="language"
                              >
                                {{ language.endonym_name | capitalize }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}

                      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
                        <p class="km-footer-locale__group-title">{{ 'kc.footer.country' | t }}</p>
                        <ul role="list" class="km-footer-locale__group">
                          {%- for country in localization.available_countries -%}
                            <li>
                              <a
                                class="km-footer-locale__link unified-loc-link"
                                href="#"
                                data-value="{{ country.iso_code }}"
                                data-type="country"
                              >
                                <span class="km-footer-locale__country">
                                  <img
                                    src="{{ country | image_url: width: 32 }}"
                                    alt=""
                                    width="16"
                                    height="16"
                                    loading="lazy"
                                  >
                                  <span>{{ country.name }}</span>
                                </span>
                                <span class="km-footer-locale__currency">{{ country.currency.iso_code }}</span>
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </form>

              <script>
                document.querySelectorAll('.unified-loc-link').forEach(function (link) {
                  link.addEventListener('click', function (e) {
                    e.preventDefault();
                    var type = this.getAttribute('data-type');
                    var val = this.getAttribute('data-value');
                    var form = document.getElementById('FooterUnifiedLocalizationForm');

                    if (type === 'language') {
                      document.getElementById('UnifiedLocaleCode').value = val;
                    } else if (type === 'country') {
                      document.getElementById('UnifiedCountryCode').value = val;
                    }

                    form.submit();
                  });
                });

                // Close dropdown when clicking outside
                document.addEventListener('click', function (e) {
                  var form = document.getElementById('FooterUnifiedLocalizationForm');
                  if (form && !form.contains(e.target)) {
                    var wrapper = form.querySelector('.disclosure__list-wrapper');
                    var btn = form.querySelector('.disclosure__button');
                    if (wrapper && !wrapper.hasAttribute('hidden')) {
                      wrapper.setAttribute('hidden', '');
                      btn.setAttribute('aria-expanded', 'false');
                    }
                  }
                });
              </script>
            {%- endif -%}
          </div>
        </div>

        <div class="km-footer-legal">
          <div class="km-footer-legal__copyright">
            {{ section.settings.copyright_text }}
          </div>

          <div class="km-footer-legal__side">
            {%- if section.settings.show_policy -%}
              <div class="km-footer-legal__links">
                <a href="{{ legal_terms.url }}">{{ section.settings.legal_terms_label | default: legal_terms_default | escape_once }}</a>
                <span aria-hidden="true">·</span>
                <a href="{{ legal_privacy.url }}">{{ section.settings.legal_privacy_label | default: legal_privacy_default | escape_once }}</a>
                <span aria-hidden="true">·</span>
                <a href="{{ legal_consumer_rights.url }}">{{ section.settings.legal_consumer_rights_label | default: legal_consumer_rights_default | escape_once }}</a>
                {%- for policy in shop.policies -%}
                  {%- comment -%} Shopify lists its cookie preferences link here as a '#' anchor, not a policy page. {%- endcomment -%}
                  {%- assign policy_url_start = policy.url | slice: 0 -%}
                  {%- if policy_url_start == '#' -%}
                    <span aria-hidden="true">·</span>
                    <a href="{{ policy.url }}">{{ policy.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if section.settings.payment_enable -%}
              <div class="km-footer-payments">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": true
    },
    {
      "type": "html",
      "id": "logo_svg",
      "label": "Logo SVG (Custom)"
    },
    {
      "type": "inline_richtext",
      "id": "slogan",
      "label": "Slogan Text",
      "default": "Your mouth has a rhythm[[br]]Now your oral care too"
    },
    {
      "type": "richtext",
      "id": "copyright_text",
      "label": "Additional Copyright Text"
    },
    {
      "type": "header",
      "content": "Newsletter Settings"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "NEWSLETTER",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "paragraph",
      "content": "Klaviyo: with a public key and a list ID the form subscribes through Klaviyo's client API (double opt-in list, locale per language). Empty = plain Shopify form. The native form stays the fallback."
    },
    {
      "type": "text",
      "id": "klaviyo_public_key",
      "label": "Klaviyo public API key (Site ID)",
      "info": "6 characters, e.g. XfYq2r. Never a private key."
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo list ID (all languages)",
      "info": "Used unless a language below has its own list."
    },
    {
      "type": "text",
      "id": "klaviyo_list_id_nl",
      "label": "Klaviyo list ID for Dutch"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id_fr",
      "label": "Klaviyo list ID for French"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id_en",
      "label": "Klaviyo list ID for English"
    },
    {
      "type": "header",
      "content": "Bottom Links & Payments"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label"
    },
    {
      "type": "page",
      "id": "legal_terms_page",
      "label": "Terms and Conditions page",
      "info": "Empty uses the page terms-and-conditions-1"
    },
    {
      "type": "text",
      "id": "legal_terms_label",
      "label": "Terms and Conditions link text",
      "info": "Blank uses the translated default (locale key kc.footer.legal_terms)"
    },
    {
      "type": "page",
      "id": "legal_privacy_page",
      "label": "Privacy Policy page",
      "info": "Empty uses the page privacy-policy"
    },
    {
      "type": "text",
      "id": "legal_privacy_label",
      "label": "Privacy Policy link text",
      "info": "Blank uses the translated default (locale key kc.footer.legal_privacy)"
    },
    {
      "type": "page",
      "id": "legal_consumer_rights_page",
      "label": "Consumer Rights page",
      "info": "Empty uses the page new-consumer-rights"
    },
    {
      "type": "text",
      "id": "legal_consumer_rights_label",
      "label": "Consumer Rights link text",
      "info": "Blank uses the translated default (locale key kc.footer.legal_consumer_rights)"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "header",
      "content": "Localization & Socials"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "Enable Country/Region selector"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "Enable Language selector"
    },
    {
      "type": "header",
      "content": "Background"
