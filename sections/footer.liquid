{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .karmicare-footer {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  {% if section.settings.bg_color_day != blank %}
    body:not(.night-mode) .karmicare-footer,
    body.day-mode .karmicare-footer {
      background-color: {{ section.settings.bg_color_day }};
    }
  {% endif %}

  {% if section.settings.text_color_day != blank %}
    body:not(.night-mode) .karmicare-footer *,
    body.day-mode .karmicare-footer * {
      color: {{ section.settings.text_color_day }};
    }
  {% endif %}

  {% if section.settings.bg_color_night != blank %}
    body.night-mode .karmicare-footer {
      background-color: {{ section.settings.bg_color_night }};
    }
  {% endif %}

  {% if section.settings.text_color_night != blank %}
    body.night-mode .karmicare-footer * {
      color: {{ section.settings.text_color_night }};
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .karmicare-footer {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
    }
  }

  .km-footer-top {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 40px;
  }

  .km-footer-top__col-1 {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .km-footer-logo-svg svg {
    max-width: 200px;
    height: auto;
    display: block;
  }
  .km-footer-top__col-1 h4 {
    max-width: 286px;
  }

  .km-footer-top__col-2 h3,
  .km-footer-top__col-3 h3 {
    text-transform: uppercase;
    margin-bottom: 20px;
    font-size: var(--kc-responsive-label-sm-text-size);
    letter-spacing: var(--kc-responsive-caption-letter-spacing);
  }

  .km-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .km-footer-links a {
    text-decoration: none;
  }

  .km-footer-newsletter-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .km-footer-newsletter-form {
    display: flex;
    border-radius: var(--primary-border-radius);
    padding: 20px 15px;
    align-items: center;
  }
  body.day-mode .km-footer-newsletter-form,
  body.day-mode .km-footer-lang-switcher .country-selector__list,
  body.day-mode .km-footer-lang-switcher .localization-selector {
    border: 1px solid color-mix(in srgb, currentColor 76%, transparent);
    background-color: var(--kc-white-surface-primary-default);
  }
  body.night-mode .km-footer-newsletter-form,
  body.night-mode .km-footer-lang-switcher .country-selector__list,
  body.night-mode .km-footer-lang-switcher .localization-selector {
    border: 1px solid color-mix(in srgb, var(--kc-day-text-color) 76%, transparent);
    background-color: var(--kc-day-text-color);
  }
  .km-footer-newsletter-form input[type='email'] {
    border: none;
    background: transparent;
    flex-grow: 1;
    outline: none;
    box-shadow: none;
    font-size: var(--km-body);
  }

  .km-footer-newsletter-form button {
    background: transparent;
    border: none;
    cursor: pointer;
    font-weight: normal;
  }
  body.night-mode .km-footer-newsletter-form button{
    color:var(--kc-white-surface-primary-default);
  }
  .km-footer-newsletter-note {
    font-size: var(--kc-responsive-label-sm-text-size);
  }

  .km-footer-newsletter-note a {
    text-decoration: underline;
  }

  .km-footer-middle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    margin-bottom: 24px;
  }

  .km-footer-socials {
    display: flex;
    gap: 16px;
  }

  .km-footer-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--extra-primary-border-radius);
    background-color: var(--kc-white-surface-primary-default);
    text-decoration: none;
  }
  @media screen and (min-width:750px){
    .km-footer-social-icon{
      width: 40px;
      height: 40px;
    }
    .km-footer-top__col-1 h4 {
      margin-top: 30px;
    }
  }
  @media screen and (max-width:749px){
    .km-footer-social-icon{
      width: 32px;
      height: 32px;
    }
    .km-footer-top__col-1 h4 {
      letter-spacing: var(--kc-responsive-h4-letter-spacing-sm);
      margin-top: 15px;
    }
  }

  .km-footer-lang-switcher {
    position: relative;
  }

  .km-footer-lang-switcher .localization-selector {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: var(--primary-border-radius);
    font-size: var(--kc-responsive-label-sm-text-size);
    font-weight: var(--font-500-weight);
    cursor: pointer;
    text-decoration: none;
    box-shadow: none;
  }

  .km-footer-lang-switcher .localization-selector span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .km-footer-lang-switcher .disclosure__list-wrapper {
    bottom: 100%;
    margin-bottom: 8px;
    border: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    border-radius: var(--primary-border-radius);
    overflow: hidden;
    padding: 0;
  }

  .km-footer-lang-switcher .country-selector__list {
    max-height: 320px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, currentColor 20%, transparent) transparent;
  }

  .km-footer-lang-switcher .country-selector__list::-webkit-scrollbar {
    width: 4px;
  }
  .km-footer-lang-switcher .country-selector__list::-webkit-scrollbar-track {
    background: transparent;
  }
  .km-footer-lang-switcher .country-selector__list::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 4px;
  }
  .km-footer-lang-switcher .country-selector__list::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, currentColor 40%, transparent);
  }

  .km-footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .km-footer-bottom-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .km-footer-bottom-links a {
    text-decoration: none;
  }

  .km-footer-payments {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .km-footer-bottom > *{
    font-size:var(--font-body-small-size-mobile);
  }
  .km-footer-bottom-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }
  @media screen and (min-width: 750px) {
    .km-footer-top {
      flex-direction: row;
      justify-content: space-between;
      gap: 60px;
    }
    .km-footer-top__col-1 {
      flex: 1;
      max-width: 400px;
    }
    .km-footer-top__col-2 {
      flex: 1;
      max-width: 250px;
    }
    .km-footer-top__col-3 {
      flex: 1;
      max-width: 400px;
    }
    .km-footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
    .km-footer-bottom-left {
      flex: 1;
      max-width: 700px;

    }
    .km-footer-bottom > *{
      font-size:var(--font-body-small-size-desktop);
    }
  }
{%- endstyle -%}

<footer class="karmicare-footer">
  <div class="page-width">
    <div class="km-footer-top">
      <div class="km-footer-top__col-1">
        {%- if section.settings.logo_svg != blank -%}
          <div class="km-footer-logo-svg">
            {{ section.settings.logo_svg }}
          </div>
        {%- else -%}
          <h2 class="h3">{{ shop.name }}</h2>
        {%- endif -%}

        {%- if section.settings.slogan != blank -%}
          <h4>{{ section.settings.slogan }}</h4>
        {%- endif -%}
      </div>

      <div class="km-footer-top__col-2">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="km-footer-links">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="km-footer-top__col-3">
        {%- if section.settings.newsletter_enable -%}
          <h3>{{ section.settings.newsletter_heading | default: 'NEWSLETTER' }}</h3>

          <div class="km-footer-newsletter-wrapper">
            <p>Email</p>
            {% form 'customer', class: 'km-footer-newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input
                type="email"
                name="contact[email]"
                placeholder="you@example.com"
                aria-label="Email address"
                required
              >
              <button type="submit" name="commit">Join</button>
            {% endform %}

            <p class="km-footer-newsletter-note">
              By subscribing you agree to the <a href="/policies/terms-of-service">Terms of Use</a> &
              <a href="/policies/privacy-policy">Privacy Policy</a>.
            </p>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="km-footer-middle">
      <div class="km-footer-socials">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="km-footer-social-icon" aria-label="Instagram">
