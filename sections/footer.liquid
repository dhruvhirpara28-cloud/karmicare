      </div>

      <div class="km-footer-localization isolate">
        {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
          <form
            method="post"
            action="/localization"
            id="FooterUnifiedLocalizationForm"
            accept-charset="UTF-8"
            class="localization-form unified-localization-form"
            enctype="multipart/form-data"
          >
            <input type="hidden" name="form_type" value="localization">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="_method" value="put">
            <input type="hidden" name="return_to" value="{{ request.path }}">
            <input
              type="hidden"
              name="country_code"
              id="UnifiedCountryCode"
              value="{{ localization.country.iso_code }}"
            >
            <input type="hidden" name="locale_code" id="UnifiedLocaleCode" value="{{ localization.language.iso_code }}">

            <div class="km-footer-lang-switcher">
              <div class="disclosure unified-disclosure">
                <button
                  type="button"
                  class="disclosure__button localization-form__select localization-selector link link--text caption-large"
                  aria-expanded="false"
                  aria-controls="UnifiedLocalizationResults"
                  onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'false' ? 'true' : 'false'); this.nextElementSibling.toggleAttribute('hidden');"
                >
                  <span>
                    {% if section.settings.enable_country_selector and localization.available_countries.size > 1 %}
                      <img
                        src="https://flagcdn.com/w40/{{ localization.country.iso_code | downcase }}.png"
                        alt=""
                        width="16"
                        height="16"
                        loading="lazy"
                        style="width: 22px; height: 22px; border-radius: 50%; object-fit: cover;display: inline-block; vertical-align: middle;"
                      >
                      {{ localization.country.currency.iso_code }}
                    {% endif %}
                    {% if section.settings.enable_language_selector and localization.available_languages.size > 1 %}
                      / {{ localization.language.iso_code | upcase }}
                    {% endif %}
                  </span>
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </button>

                <div
                  class="disclosure__list-wrapper country-selector"
                  hidden
                  id="UnifiedLocalizationResults"
                  style="bottom: 100%; margin-bottom: 8px;"
                >
                  <div class="disclosure__list country-selector__list" style="padding: 16px; min-width: 200px;">
                    {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
                      <p
                        class="caption-large text-body"
                        style="font-size:var(--kc-responsive-label-sm-text-size); font-weight: bold; margin-bottom: 8px; text-transform: uppercase;"
                      >
                        Language
                      </p>
                      <ul role="list" class="list-unstyled" style="margin-bottom: 16px;">
                        {%- for language in localization.available_languages -%}
                          <li class="disclosure__item" tabindex="-1">
                            <a
                              class="link link--text disclosure__link caption-large focus-inset unified-loc-link"
                              href="#"
                              data-value="{{ language.iso_code }}"
                              data-type="language"
                              style="padding: 4px 0; font-size: 13px;"
                            >
                              {{ language.endonym_name | capitalize }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
                      <p
                        class="caption-large text-body"
                        style="font-size:var(--kc-responsive-label-sm-text-size); font-weight: bold; margin-bottom: 8px; text-transform: uppercase;"
                      >
                        Country/Region
                      </p>
                      <ul role="list" class="list-unstyled">
                        {%- for country in localization.available_countries -%}
                          <li class="disclosure__item" tabindex="-1">
                            <a
                              class="link link--text disclosure__link caption-large focus-inset unified-loc-link"
                              href="#"
                              data-value="{{ country.iso_code }}"
                              data-type="country"
                              style="padding: 6px 0; font-size: 13px; display: flex; align-items: center; justify-content: space-between;"
                            >
                              <div style="display: flex; align-items: center; gap: 8px;">
                                <img
                                  src="https://flagcdn.com/w40/{{ country.iso_code | downcase }}.png"
                                  alt=""
                                  width="16"
                                  height="16"
                                  loading="lazy"
                                  style="width: 16px; height: 16px; border-radius: 50%; object-fit: cover;"
                                >
                                <span>{{ country.name }}</span>
                              </div>
                              <span style="opacity: 0.7;">{{ country.currency.iso_code }}</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </form>

          <script>
            document.querySelectorAll('.unified-loc-link').forEach(function (link) {
              link.addEventListener('click', function (e) {
                e.preventDefault();
                var type = this.getAttribute('data-type');
                var val = this.getAttribute('data-value');
                var form = document.getElementById('FooterUnifiedLocalizationForm');

                if (type === 'language') {
                  document.getElementById('UnifiedLocaleCode').value = val;
                } else if (type === 'country') {
                  document.getElementById('UnifiedCountryCode').value = val;
                }

                form.submit();
              });
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function (e) {
              var form = document.getElementById('FooterUnifiedLocalizationForm');
              if (form && !form.contains(e.target)) {
                var wrapper = form.querySelector('.disclosure__list-wrapper');
                var btn = form.querySelector('.disclosure__button');
                if (wrapper && !wrapper.hasAttribute('hidden')) {
                  wrapper.setAttribute('hidden', '');
                  btn.setAttribute('aria-expanded', 'false');
                }
              }
            });
          </script>
        {%- endif -%}
      </div>
    </div>

    <div class="km-footer-bottom">
      <div class="km-footer-bottom-left">
        {{ section.settings.copyright_text }}
      </div>

      <div class="km-footer-bottom-right">
        {%- if section.settings.show_policy -%}
          <div class="km-footer-bottom-links">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <a href="{{ policy.url }}">{{ policy.title }}</a>
                {%- unless forloop.last -%}
                  <span>·</span>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.payment_enable -%}
          <div class="km-footer-payments">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

