    "research_behind_system_EkjATL": {
      "type": "research-behind-system",
      "blocks": {
        "card_bDxUVT": {
          "type": "card",
          "settings": {
            "subheading": "NANO-HYDROXYAPATITE",
            "heading": "Nano-HAp sealed 98% of open dentine tubules.",
            "subtext": "Human dentine discs · 7 days",
            "result_label": "RESULT",
            "result_text": "98% occlusion vs 82% and 65% for two other desensitising technologies",
            "method_label": "METHOD",
            "method_text": "In vitro SEM comparison of three pastes, ~1% nHAp.",
            "link_label": "Kulal et al. · 2016 · J Clin Diagn Res",
            "link_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5121804/",
            "logo": "shopify://shop_images/Logo.png",
            "image": "shopify://shop_images/Picture_1.png",
            "image_badge": "DENTINE TUBULES · OPEN AND OCCLUDED"
          }
        },
        "card_yMiD9D": {
          "type": "card",
          "settings": {
            "subheading": "ORAL–SLEEP CONNECTION",
            "heading": "Poorer oral health was linked with poorer sleep.",
            "subtext": "36,559 people · 8 studies",
            "result_label": "RESULT",
            "result_text": "SMD 2.17 · p = 0.004 · 95% CI 0.68–3.66&nbsp;",
            "method_label": "METHOD",
            "method_text": "Meta-analysis of 8 studies, 2015–2023.",
            "link_label": "Lei & Hu · 2025 · Biomedical Reports",
            "link_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11704870/",
            "logo": "shopify://shop_images/Logo-2.png",
            "image": "shopify://shop_images/Sleep_airway.png",
            "image_badge": "SLEEP · AIRWAY AND ORAL CAVITY"
          }
        },
        "card_fmFMFd": {
          "type": "card",
          "settings": {
            "subheading": "XYLITOL",
            "heading": "Xylitol lowered tooth decay compared with controls.",
            "subtext": "1,478 people · 7 trials",
            "result_label": "Result",
            "result_text": "SMD −1.09 · p < 0.00001 · 95% CI −1.34 to −0.83",
            "method_label": "Method",
            "method_text": "Systematic review and meta-analysis of 7 clinical trials.",
            "link_label": "Janakiram et al. · 2017 · J Nat Sci Biol Med",
            "link_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5320817/",
            "logo": "shopify://shop_images/Logo_1.png",
            "image": "shopify://shop_images/kc-research-xylitol-specimen-1122x1402-v1.jpg",
            "image_badge": "XYLITOL CRYSTALS"
          }
        },
        "card_Hi7YUD": {
          "type": "card",
          "settings": {
            "subheading": "NANO-HYDROXYAPATITE",
            "heading": "Nano-HAp beat fluoride on tooth sensitivity.",
            "subtext": "105 people · 4 weeks",
            "result_label": "RESULT",
            "result_text": "Lower cold-air and tactile sensitivity vs fluoride and placebo, p < 0.05",
            "method_label": "METHOD",
            "method_text": "Double-blind randomised controlled trial, three arms.",
            "link_label": "Vano et al. · 2018 · Clin Oral Investig",
            "link_url": "https://doi.org/10.1007/s00784-017-2113-3",
            "logo": "shopify://shop_images/Logo_2.png",
            "image": "shopify://shop_images/kc-research-nhap-tubules-2000x2400-v1.jpg",
            "image_badge": "DENTINE TUBULES"
          }
        },
        "card_JeERX6": {
          "type": "card",
          "settings": {
            "subheading": "SLS-FREE",
            "heading": "No SLS meant fewer and shorter canker sores.",
            "subtext": "124 people · 4 crossover RCTs",
            "result_label": "RESULT",
            "result_text": "Fewer ulcers, shorter duration, fewer episodes, less pain",
            "method_label": "METHOD",
            "method_text": "Systematic review and meta-analysis of 4 crossover RCTs.",
            "link_label": "Alli et al. · 2019 · J Oral Pathol Med",
            "link_url": "https://doi.org/10.1111/jop.12845",
            "logo": "shopify://shop_images/Logo_3.png",
            "image": "shopify://shop_images/kc-research-sls-mucosa-2000x2400-v1.jpg",
            "image_badge": "ORAL MUCOSA"
          }
        }
      },
