    "chronobiology_clock_karmicare": {
      "type": "chronobiology-clock-karmicare",
      "settings": {
        "eyebrow": "CHRONOBIOLOGY",
        "title": "Your mouth runs on a 24-hour clock.",
        "heading_tag": "h2",
        "description": "<p>Bacteria, saliva and acids each keep their own hours.&nbsp;</p><p>What it needs at 07:00 is not what it needs at 22:00.</p>",
