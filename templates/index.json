    "km_faq_accordion_FYcArV": {
      "type": "km-faq-accordion",
      "blocks": {
        "faq_item_TNnqTQ": {
          "type": "faq_item",
          "settings": {
            "category": "The system",
            "question": "Why two formulas instead of one?",
            "answer": "<p>Because your mouth doesn’t do the same job all day. Daytime is exposure to acids, sugars and coffee, so Awake protects, activates and brightens. Night is repair, when saliva drops and your body regenerates, so Asleep soothes, supports your mouth’s balance and helps remineralise. Spit, don’t rinse. Left on after the evening brush, it gets extended contact time.</p>"
          }
        },
        "faq_item_AL3DKF": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "category": "Ingredients & safety",
            "question": "Is Karmicare fluoride-free?",
            "answer": "<p>Karmicare is fluoride-free, and always will be. Fluoride’s benefits don’t outweigh its known drawbacks.</p>"
          }
        },
        "faq_item_kLMHax": {
          "type": "faq_item",
          "settings": {
            "category": "The ritual",
            "question": "How long does one duo last?",
            "answer": "<p>About 64 days — one full cycle. One pump per ritual, Awake in the morning and Asleep at night, and each formula carries a little over two months of them. A delivery every 60 days keeps you a few days ahead.</p>"
          }
        },
        "faq_item_7jmEGi": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "category": "Ingredients & safety",
            "question": "Can I combine Karmicare with fluoride toothpaste or rinses?",
            "answer": "<p>Better not. Fluoride and nano-hydroxyapatite compete for the same enamel surface, so alternating dilutes both. If you switch, switch fully: Awake in the morning, Asleep at night. Your dentist can tell you if a fluoride treatment is needed for a specific reason.</p>"
          }
        },
        "faq_item_Pz4mRk": {
          "type": "faq_item",
          "settings": {
            "category": "Plans & Return on Care",
            "question": "Can I pause, skip or cancel?",
            "answer": "<p>Your membership is completely in your hands. Amend when desired.</p>"
          }
        },
        "faq_item_qUxYCn": {
          "type": "faq_item",
          "settings": {
            "category": "Shipping & guarantee",
            "question": "What does the money-back guarantee cover?",
            "answer": "<p>Every first order comes with a money-back guarantee: 14 days on Try Once, your first cycle on the 60-Day rhythm, 60 days on the Year. Your legal right to withdraw comes on top.</p>"
          }
        }
      },
