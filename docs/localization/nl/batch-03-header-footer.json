  {
   "id": "header-group:announcement-bar/announcement-bar-0/text",
   "resource_type": "section_group",
   "file_or_handle": "sections/header-group.json",
   "key_path": "sections.announcement-bar.blocks.announcement-bar-0.settings.text",
   "en": "FREE SHIPPING & 60-DAY GUARANTEE FOR MEMBERS · BELGIAN-MADE · EST. 2017",
   "en_sha1": "b4f5fb0b87d8d23a5dab8de173c2d065f017ef83",
   "nl": "GRATIS VERZENDING & 60 DAGEN GELD TERUG VOOR LEDEN · GEMAAKT IN BELGIË · SINDS 2017",
   "status": "translated",
   "flags": [],
   "notes": "claim C103 confirmed by Victor 21 Oct ('EST. 2017 is bevestigd'); EN is Victor's short line of 21 Oct; '60 DAGEN GELD TERUG' kept for '60-DAY GUARANTEE', because a bare 'garantie' reads as the legal warranty; 'EST.' as 'SINDS'; the bar scrolls up to 1199 px"
  },
