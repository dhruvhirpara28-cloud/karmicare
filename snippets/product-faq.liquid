{%- liquid
  assign faq_items = product.metafields.custom.product_faq.value

  # Practitioner request links (R76k): in the answers and section content, a link whose href
  # contains the URL trigger, or whose text contains the text trigger, becomes a link to the request
  # form (sections/kc-practitioner-request.liquid, rendered by the layout on this page). The script
  # opens the form in its popup from it; without JavaScript it jumps to the form. Its FAQ question
  # goes along as "Opened from". The triggers stay translatable block settings, as the FAQ text is.
  assign request_on = false
  assign request_url = block.settings.request_trigger_url | strip
  assign request_text = block.settings.request_trigger_text | strip | downcase
  if block.settings.request_enabled
    if request_url != blank or request_text != blank
      assign request_on = true
    endif
  endif
-%}
{%- if faq_items != blank -%}
  {{ 'product-faq.css' | asset_url | stylesheet_tag }}
  {%- if request_on -%}
    {%- comment -%}
      The links below open the form, which another section renders; the script runs once and hides
      them when that section is hidden or removed (R94 B1)
    {%- endcomment -%}
    <script src="{{ 'kc-practitioner-request.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <div class="kc-faq-block pdp">
    <div class="kc-faq-list">
      {%- for item in faq_items -%}
        {%- liquid
          assign description_html = ''
          if item.description != blank
            assign description_html = item.description | metafield_tag
          endif
          assign section_html = item.section_content
          if request_on
            assign from = item.title | strip_html | strip | escape
            for part in (1..2)
              if part == 1
                assign source = description_html
              else
                assign source = section_html
              endif
              if source == blank
                continue
              endif
              assign chunks = source | split: '<a '
              assign rebuilt = chunks.first
              for chunk in chunks offset: 1
                # a new name: reassigning the loop variable itself is not reliable in Liquid
                assign piece = chunk
                assign anchor = chunk | split: '</a>' | first
                assign attrs = anchor | split: '>' | first
                assign anchor_text = anchor | remove_first: attrs | strip_html | downcase
                assign hit = false
                if request_url != blank and attrs contains request_url
                  assign hit = true
                elsif request_text != blank and anchor_text contains request_text
                  assign hit = true
                endif
                if hit and attrs contains 'href="'
                  assign old_href = attrs | split: 'href="' | last | split: '"' | first
                  assign old_href_attr = 'href="' | append: old_href | append: '"'
                  assign new_href_attr = 'href="#KcPractitionerRequest-panel" data-kc-pr-open data-kc-pr-from="' | append: from | append: '"'
                  assign new_attrs = attrs | replace_first: old_href_attr, new_href_attr
                  assign piece = chunk | replace_first: attrs, new_attrs
                endif
                assign rebuilt = rebuilt | append: '<a ' | append: piece
              endfor
              if part == 1
                assign description_html = rebuilt
              else
                assign section_html = rebuilt
              endif
            endfor
          endif
        -%}
        <details class="kc-faq-item" name="faq-accordion">
          <summary class="kc-faq-summary">
            <span>{{ item.title }}</span>
            {% render 'icon-plus-minus' %}
          </summary>
          <div class="kc-faq-body">
            {%- if description_html != blank -%}
              <div class="kc-faq-description">
                {{ description_html }}
              </div>
            {%- endif -%}
            {%- if section_html != blank -%}
              <div class="kc-faq-section-content">
                {{ section_html }}
              </div>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const faqItems = document.querySelectorAll('.kc-faq-item');
      faqItems.forEach((item) => {
        item.addEventListener('click', function (e) {
          if (e.target.tagName !== 'SUMMARY' && !e.target.closest('summary')) return;
          if (!this.hasAttribute('open')) {
            faqItems.forEach((otherItem) => {
              if (otherItem !== this && otherItem.hasAttribute('open')) {
                otherItem.removeAttribute('open');
              }
            });
          }
        });
      });
    });
  </script>
{%- endif -%}
