<script>
  (function() {
    const stdBtn = document.getElementById('ProductSubmitButton-{{ section_id }}');
    const customBtn = document.getElementById('CustomSubmitButton-{{ section_id }}');
    const form = customBtn ? (customBtn.closest('product-form') || customBtn.closest('form')) : (stdBtn ? (stdBtn.closest('product-form') || stdBtn.closest('form')) : null);

    if (!form) return;

    const handleAction = async (e, buttonElement) => {
      e.preventDefault();
      e.stopImmediatePropagation();
      
      if (typeof window.karmiAddToCart === 'function') {
        const welcomeKitVariantIdsStr = {{ welcome_kit_variant_ids | json }};
        const welcomeKitVariantIds = welcomeKitVariantIdsStr ? welcomeKitVariantIdsStr.split(',').filter(Boolean) : [];
        
        await window.karmiAddToCart(form, buttonElement, {
          redirectToCheckout: {{ block.settings.redirect_to_checkout | default: false }},
          isBundleProduct: {{ is_bundle_product | default: false }},
          customerAlreadyReceivedFreeProduct: {% if customer and customer.tags contains 'FREE WELCOME KIT RECEIVED' %}true{% else %}false{% endif %},
          welcomeKitVariantIds: welcomeKitVariantIds
        });
      }
    };

    if (customBtn) {
      customBtn.addEventListener('click', (e) => handleAction(e, customBtn));

      if (stdBtn) {
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.attributeName === 'class') {
              const isLoading = stdBtn.classList.contains('loading');
              customBtn.classList.toggle('loading', isLoading);
              const customSpinner = customBtn.querySelector('.loading__spinner');
              if (customSpinner) customSpinner.classList.toggle('hidden', !isLoading);
            }
            if (mutation.attributeName === 'disabled') {
              stdBtn.hasAttribute('disabled') ? customBtn.setAttribute('disabled', 'disabled') : customBtn.removeAttribute('disabled');
            }
            if (mutation.attributeName === 'aria-disabled') {
              const ariaDis = stdBtn.getAttribute('aria-disabled');
              ariaDis ? customBtn.setAttribute('aria-disabled', ariaDis) : customBtn.removeAttribute('aria-disabled');
            }
          });
        });
        observer.observe(stdBtn, { attributes: true });
      }
    }

    form.addEventListener('submit', (e) => {
      {% if block.settings.redirect_to_checkout %}
        handleAction(e, stdBtn);
      {% endif %}
    }, true);

    window.addEventListener('pageshow', () => {
      [customBtn, stdBtn].forEach(btn => {
        if (btn) {
          btn.classList.remove('loading');
          const spinner = btn.querySelector('.loading__spinner');
          if (spinner) spinner.classList.add('hidden');
        }
      });
    });
  })();
</script>
