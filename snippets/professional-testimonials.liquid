{%- liquid
  assign testimonials = product.metafields.custom.professional_testimonials.value
-%}

{%- if testimonials != blank -%}
  {{ 'professional-testimonials.css' | asset_url | stylesheet_tag }}

  <div class="kc-professional-testimonials">
    <h3 class="kc-testimonials-heading" style="color: {{ block.settings.heading_color | default: '#ffffff' }};">
      {{ block.settings.heading | default: 'Approved by nature. Used by professionals' }}
    </h3>

    <div class="kc-testimonials-grid">
      {%- for testimonial in testimonials -%}
        <div class="kc-testimonial-card-item">
          {%- if testimonial.image != blank -%}
            <div class="kc-testimonial-card-bg">
              {{ testimonial.image | image_url: width: 400 | image_tag: class: 'kc-testimonial-card-img', loading: 'lazy' }}
            </div>
          {%- endif -%}
          <div class="kc-testimonial-card-overlay"></div>
          <div class="kc-testimonial-card-content">
            <div class="kc-testimonial-card-desc">
              {{ testimonial.description | metafield_tag }}
            </div>
            <div class="kc-testimonial-card-author">
              <h4 class="kc-testimonial-card-name">{{ testimonial.name }}</h4>
              <p class="kc-testimonial-card-designation">{{ testimonial.designation }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
