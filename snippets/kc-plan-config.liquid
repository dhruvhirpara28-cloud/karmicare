{%- comment -%}
  Plan selection for one Loop widget, read by assets/kc-plan-select.js (loaded in layout/theme.liquid).

  Accepts:
  - product: {Object}
  - section: {Object} the section that renders the widget; its #ProductInfo-<section.id> holds the
    widget and its form is #product-form-<section.id>
  - role: {String} 'buybox' (main-product) or 'end-cta' (featured-product). Compare plans and Try Once
    always act on the buybox.
  - default_to_subscription: {Boolean} the Loop block setting: start on the first public plan

  Every selling plan of the product is listed with its group, whether it is public, its type, its Duos
  per delivery and expected year total (snippets/kc-plan-type.liquid), its "Subscription Name" for Loop
  Loyalty (snippets/kc-plan-loyalty.liquid) and, when the custom.duos_count entry carries the plan's ID
  in its selling_plan_id field (comma-separated IDs), its duos, brushings and Return on Care.
  kc-plan-select.js writes those onto the Loop plan options by ID, so the Loop widget's name match no
  longer decides them. The theme editor lists each public plan and each year plan with its quantity
  (Duos per delivery), Shopify's price per quantity and the total the checkout charges (Shopify's price
  per quantity x quantity; for a year plan Shopify's year price per quantity x quantity, never a per-Duo
  price), red when a year plan's total differs from the expected one while year plans are 3 Duos per
  delivery.
  Public plans come from the product's compare plans (snippets/kc-plan-public.liquid). The groups
  without a public plan are hidden here from first paint, in every Loop widget and in the sticky bar,
  and kc-plan-select.js keeps them hidden and unselectable. With no valid public plan ID the widgets
  keep Loop's own visibility and the theme editor shows a warning, so the buybox is never empty.
{%- endcomment -%}
{%- liquid
  capture kc_public
    render 'kc-plan-public', product: product
  endcapture
  assign kc_public = kc_public | strip

  # The Welcome Kit variants (theme setting, as in snippets/buy-buttons.liquid): kit lines in the cart.
  # Their product handles give the cart order (assets/kc-plan-select.js KIT_ORDER), never this list.
  assign kc_kit_variant_ids = ''
  assign kc_kit_handles = ''
  for kc_kit_item in settings.welcome_kit_free_product
    assign kc_kit_product = kc_kit_item
    if kc_kit_item.id == null
      assign kc_kit_product = all_products[kc_kit_item]
    endif
    if kc_kit_product != blank and kc_kit_product.variants.first != blank
      assign kc_kit_variant_ids = kc_kit_variant_ids | append: kc_kit_product.variants.first.id | append: ','
      if kc_kit_handles != blank
        assign kc_kit_handles = kc_kit_handles | append: ', '
      endif
      assign kc_kit_key = kc_kit_product.variants.first.id | append: '' | json
      assign kc_kit_handle = kc_kit_product.handle | json
      assign kc_kit_handles = kc_kit_handles | append: kc_kit_key | append: ': ' | append: kc_kit_handle
    endif
  endfor
  assign kc_kit_variant_ids = kc_kit_variant_ids | split: ','
  assign kc_kit_handles = '{' | append: kc_kit_handles | append: '}'

  # A subscription of this product brings the Welcome Kit (as snippets/buy-buttons.liquid decides): a
  # Welcome Kit bundle product, for a customer who has not received the kit yet
  assign kc_welcome_kit = false
  for kc_bundle_item in settings.welcome_kit_bundle_products
    assign kc_bundle_product = kc_bundle_item
    if kc_bundle_item.id == null
      assign kc_bundle_product = all_products[kc_bundle_item]
    endif
    if kc_bundle_product != blank and kc_bundle_product.id == product.id
      assign kc_welcome_kit = true
    endif
  endfor
  if customer and customer.tags contains 'FREE WELCOME KIT RECEIVED'
    assign kc_welcome_kit = false
  endif

  assign kc_public_groups = ','
  for kc_group in product.selling_plan_groups
    for kc_plan in kc_group.selling_plans
      assign kc_needle = ',' | append: kc_plan.id | append: ','
      if kc_public contains kc_needle
        assign kc_public_groups = kc_public_groups | append: kc_group.id | append: ','
        break
      endif
    endfor
  endfor
-%}
<script type="application/json" data-kc-plan-config>
  {
    "productId": {{ product.id | append: '' | json }},
    "role": {{ role | json }},
    "sectionId": {{ section.id | json }},
    "formId": {{ 'product-form-' | append: section.id | json }},
    "defaultToSubscription": {% if default_to_subscription %}true{% else %}false{% endif %},
    "kitVariantIds": {{ kc_kit_variant_ids | json }},
    "kitHandles": {{ kc_kit_handles }},
    "welcomeKit": {{ kc_welcome_kit }},
    "shopCurrency": {{ shop.currency | json }},
    "plans": [
      {%- assign kc_separator = '' -%}
      {%- assign kc_missing_keys = '' -%}
      {%- assign kc_missing_duos = '' -%}
      {%- assign kc_unknown_plans = '' -%}
      {%- assign kc_unit_rows = '' -%}
      {%- assign kc_total_wrong = false -%}
      {%- for kc_group in product.selling_plan_groups -%}
        {%- for kc_plan in kc_group.selling_plans -%}
          {%- liquid
            assign kc_needle = ',' | append: kc_plan.id | append: ','
            assign kc_group_name_html = kc_group.name | escape
            capture kc_type
              render 'kc-plan-type', plan_id: kc_plan.id
            endcapture
            assign kc_type = kc_type | strip
            capture kc_units
              render 'kc-plan-type', plan_id: kc_plan.id, field: 'units'
            endcapture
            assign kc_units = kc_units | strip | plus: 0
            capture kc_expected_total
              render 'kc-plan-type', plan_id: kc_plan.id, field: 'expected_total'
            endcapture
            assign kc_expected_total = kc_expected_total | strip
            capture kc_credit_percent
              render 'kc-plan-type', plan_id: kc_plan.id, field: 'care_credit_percent'
            endcapture
            assign kc_credit_percent = kc_credit_percent | strip | plus: 0
            if kc_type == blank
              assign kc_unknown_plans = kc_unknown_plans | append: '<li><code>' | append: kc_plan.id | append: '</code> · ' | append: kc_group_name_html | append: '</li>'
            endif

            # Theme editor: what the checkout charges (Shopify's price per quantity x quantity; year plans:
            # Shopify's year price per quantity x quantity) for each public plan and each year plan (legacy
            # year plans are not sold here but renew through Loop at their price)
            assign kc_list_row = false
            if request.design_mode and role == 'buybox'
              if kc_public contains kc_needle or kc_type == 'year'
                assign kc_list_row = true
              endif
            endif
            if kc_list_row
              assign kc_allocation = null
              for kc_candidate in product.selected_or_first_available_variant.selling_plan_allocations
                if kc_candidate.selling_plan.id == kc_plan.id
                  assign kc_allocation = kc_candidate
                  break
                endif
              endfor
              assign kc_row_style = ''
              assign kc_row_note = ''
              if kc_allocation == blank
                assign kc_row_note = ' · not offered for this variant'
              else
                assign kc_plan_total = kc_allocation.price | times: kc_units
                if kc_type == 'year' and kc_units > 1
                  if kc_expected_total == blank
                    assign kc_total_wrong = true
                    assign kc_row_style = ' style="color: #b42318; font-weight: 700;"'
                    assign kc_row_note = ' · no expected total in snippets/kc-plan-type.liquid'
                  elsif cart.currency.iso_code != shop.currency
                    assign kc_row_note = ' · not checked (prices in ' | append: cart.currency.iso_code | append: ')'
                  else
                    assign kc_expected_cents = kc_expected_total | plus: 0
                    if kc_plan_total != kc_expected_cents
                      assign kc_total_wrong = true
                      assign kc_row_style = ' style="color: #b42318; font-weight: 700;"'
                      assign kc_expected_money = kc_expected_cents | money
                      assign kc_row_note = ' · expected ' | append: kc_expected_money | append: ': check the year price per quantity in Loop'
                    endif
                  endif
                endif
              endif
              unless kc_public contains kc_needle
                assign kc_row_note = ' · not on the product page' | append: kc_row_note
              endunless
              capture kc_unit_row
                echo '<li' | append: kc_row_style | append: '><code>' | append: kc_plan.id | append: '</code> · ' | append: kc_group_name_html
                echo ' · quantity ' | append: kc_units
                if kc_allocation != blank
                  assign kc_allocation_money = kc_allocation.price | money
                  assign kc_total_money = kc_plan_total | money
                  echo " · Shopify's price per quantity " | append: kc_allocation_money | append: ' · total ' | append: kc_total_money
                endif
                echo kc_row_note | append: '</li>'
              endcapture
              assign kc_unit_rows = kc_unit_rows | append: kc_unit_row
            endif
            capture kc_loyalty_key
              render 'kc-plan-loyalty', product: product, plan_id: kc_plan.id
            endcapture
            assign kc_loyalty_key = kc_loyalty_key | strip
            if kc_public contains kc_needle and kc_loyalty_key == blank
              assign kc_missing_keys = kc_missing_keys | append: '<li><code>' | append: kc_plan.id | append: '</code> · ' | append: kc_group_name_html | append: '</li>'
            endif

            # Duos, brushings and Return on Care of this plan by ID: the custom.duos_count entry whose
            # selling_plan_id field lists the plan (same sums as snippets/loop-widget-standard.liquid)
            assign kc_duos_json = 'null'
            for kc_entry in product.metafields.custom.duos_count.value
              assign kc_entry_ids = kc_entry.selling_plan_id.value | default: kc_entry.selling_plan_id | append: '' | remove: 'gid://shopify/SellingPlan/' | remove: ' '
              if kc_entry_ids == blank
                continue
              endif
              assign kc_entry_ids = ',' | append: kc_entry_ids | append: ','
              if kc_entry_ids contains kc_needle
                assign kc_duos = kc_entry.duos_count.value | default: 1
                if kc_entry.free_duo_s_count != blank
                  assign kc_duos = kc_duos | plus: kc_entry.free_duo_s_count.value
                endif
                assign kc_brushings = kc_entry.brushings_count.value | default: 120
                assign kc_return_on_care = kc_entry.return_on_care.value | default: 0
                assign kc_duos_json = '{"duos": ' | append: kc_duos | append: ', "brushings": ' | append: kc_brushings | append: ', "returnOnCare": ' | append: kc_return_on_care | append: '}'
                break
              endif
            endfor
            if kc_public contains kc_needle and kc_duos_json == 'null' and product.metafields.custom.duos_count.value != blank
              assign kc_missing_duos = kc_missing_duos | append: '<li><code>' | append: kc_plan.id | append: '</code> · ' | append: kc_group_name_html | append: '</li>'
            endif
          -%}
          {{ kc_separator }}{"id": {{ kc_plan.id | append: '' | json }}, "groupId": {{ kc_group.id | json }}, "groupName": {{ kc_group.name | json }}, "public": {% if kc_public contains kc_needle %}true{% else %}false{% endif %}, "type": {{ kc_type | json }}, "loyaltyKey": {{ kc_loyalty_key | json }}, "duos": {{ kc_duos_json }}, "units": {{ kc_units }}, "careCreditPercent": {{ kc_credit_percent }}, "expectedTotal": {% if kc_expected_total != blank %}{{ kc_expected_total | plus: 0 }}{% else %}null{% endif %}}
          {%- assign kc_separator = ',' -%}
        {%- endfor -%}
      {%- endfor -%}
    ]
  }
</script>
<style>
  .kc-plan-hidden {
    display: none !important;
  }
  {%- comment -%}
    Only the final price: no Loop discount badge ("Save x%") and no compare-at price on any option
  {%- endcomment %}
  #ProductInfo-{{ section.id }} .loop-subscription-group-discount-badge,
  #ProductInfo-{{ section.id }} .loop-subscription-group-price-amount-original,
  #ProductInfo-{{ section.id }} .loop-one-time-purchase-option-price-amount-original {
    display: none !important;
  }
  {%- comment -%}
    Express checkout: Shopify's dynamic checkout button ("Buy it now", "Buy with Shop Pay") buys the form's
    selling plan at quantity 1, not the plan's Duos per delivery, so it stays hidden while a plan is
    selected (kc-plan-select.js adds kc-express-allowed for one time only). The Shop Pay installments
    banner quotes the one-time price, never a plan's: hidden too.
  {%- endcomment %}
  #product-form-{{ section.id }}:not(.kc-express-allowed) .shopify-payment-button,
  #product-form-installment-{{ section.id }} {
    display: none !important;
  }
  {%- if kc_public != ',' -%}
    {%- for kc_group in product.selling_plan_groups -%}
      {%- assign kc_needle = ',' | append: kc_group.id | append: ',' -%}
      {%- comment -%}
        Scoped to this widget (and, from the buybox, the sticky bar), so a section reloaded in the theme
        editor never leaves a stale rule on the other widget
      {%- endcomment -%}
      {%- unless kc_public_groups contains kc_needle %}
        #ProductInfo-{{ section.id }} [id='loop-selling_plan_group-{{ kc_group.id }}']
        {%- if role == 'buybox' %},
          .sc-dd-option[data-selling-plan-group-id='{{ kc_group.id }}']
        {%- endif %} {
          display: none !important;
        }
      {%- endunless -%}
    {%- endfor -%}
  {%- endif %}
</style>
{%- if request.design_mode and role == 'buybox' -%}
  {%- if kc_public == ',' -%}
    <div
      role="note"
      style="margin: 1rem 0; padding: 0.8rem 1rem; border: 2px solid #b42318; border-radius: 8px; background: #fef3f2; color: #b42318; font-size: 1.3rem; line-height: 1.4;"
    >
      <strong>Theme editor only · plan selection:</strong>
      no compare plan of this product holds a valid public selling plan ID, so these widgets show Loop's
      own plan list (legacy offers included) and the compare plan buttons select nothing. Set
      selling_plan_id on each compare plan to one of these IDs:
      {%- render 'kc-plan-editor-list', product: product, public_plans: kc_public -%}
    </div>
  {%- endif -%}
  {%- if kc_missing_keys != blank -%}
    <div
      role="note"
      style="margin: 1rem 0; padding: 0.8rem 1rem; border: 2px solid #b42318; border-radius: 8px; background: #fef3f2; color: #b42318; font-size: 1.3rem; line-height: 1.4;"
    >
      <strong>Theme editor only · Care Credit:</strong>
      these public plans have no "Subscription Name" for Loop Loyalty, so their orders earn no Care
      Credit. Add a loyalty_key to their compare plan, or the value to snippets/kc-plan-loyalty.liquid:
      <ul style="margin: 0.4em 0 0; padding-left: 1.2em;">
        {{- kc_missing_keys -}}
      </ul>
    </div>
  {%- endif -%}
  {%- if kc_unknown_plans != blank -%}
    <div
      role="note"
      style="margin: 1rem 0; padding: 0.8rem 1rem; border: 2px solid #b42318; border-radius: 8px; background: #fef3f2; color: #b42318; font-size: 1.3rem; line-height: 1.4;"
    >
      <strong>Theme editor only · Duos per delivery:</strong>
      these selling plans are not in snippets/kc-plan-type.liquid, so the theme adds 1 Duo per delivery
      for them and they get no plan type. Add their IDs to that table:
      <ul style="margin: 0.4em 0 0; padding-left: 1.2em;">
        {{- kc_unknown_plans -}}
      </ul>
    </div>
  {%- endif -%}
  {%- if kc_unit_rows != blank -%}
    {%- liquid
      assign kc_list_color = '#344054'
      assign kc_list_background = '#f9fafb'
      if kc_total_wrong
        assign kc_list_color = '#b42318'
        assign kc_list_background = '#fef3f2'
      endif
    -%}
    <div
      role="note"
      style="margin: 1rem 0; padding: 0.8rem 1rem; border: 2px solid {{ kc_list_color }}; border-radius: 8px; background: {{ kc_list_background }}; color: {{ kc_list_color }}; font-size: 1.3rem; line-height: 1.4;"
    >
      <strong>Theme editor only · what the checkout charges:</strong>
      per public plan and per year plan, the quantity (= Duos per delivery; year plans: theme setting
      "Year plans: Duos per delivery", now {{ settings.kc_year_units_per_delivery | default: 3 }}),
      Shopify's price per quantity and the total (Shopify's price per quantity x quantity), which the
      product page shows and the checkout charges. For a year plan, Shopify's price per quantity is a year
      price, never a per-Duo price: Shopify's year price per quantity x quantity is the year total.
      {%- if kc_total_wrong %}
        A year plan's total is not the expected one: fix the year price per quantity in Loop (only for the
        emergency rollback, set the setting back to 1 together with a full-year price per quantity in Loop).
      {%- endif -%}
      <ul style="margin: 0.4em 0 0; padding-left: 1.2em;">
        {{- kc_unit_rows -}}
      </ul>
    </div>
  {%- endif -%}
  {%- if kc_missing_duos != blank -%}
    <div
      role="note"
      style="margin: 1rem 0; padding: 0.8rem 1rem; border: 2px solid #b42318; border-radius: 8px; background: #fef3f2; color: #b42318; font-size: 1.3rem; line-height: 1.4;"
    >
      <strong>Theme editor only · duos per plan:</strong>
      the duos, brushings and Return on Care of these public plans are still matched by plan name (Loop
      widget), so a renamed or translated plan loses them. Add a selling_plan_id field (single line text,
      comma-separated plan IDs) to the selling_plan_duos entries and fill it for:
      <ul style="margin: 0.4em 0 0; padding-left: 1.2em;">
        {{- kc_missing_duos -}}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}
