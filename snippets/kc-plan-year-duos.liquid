{%- comment -%}
  The line a year plan shows next to its price while year plans are more than 1 Duo per delivery (theme
  setting "Year plans: Duos per delivery" set to 3), so the customer reads the Duos of the whole year,
  not the quantity of one delivery: "6 duos · 3 now, 3 in month 6 · €59 per duo". Every number is
  computed (snippets/kc-plan-type.liquid):
  - Duos a year = Duos per delivery x deliveries
  - the month of the second delivery = 12 / deliveries
  - price per Duo = allocation price x Duos per delivery / Duos a year, in the store money format
  Strings: kc.year_plan.* in locales/en.default.json. Used by snippets/kc-plan-config.liquid for the
  buybox (assets/kc-plan-select.js yearDuos, shown by assets/loop-widget.js); the cart does not show it
  (customers go from the product page straight to checkout).

  Accepts:
  - plan_id: {String|Number} a selling plan ID
  - price: {Number} Shopify's allocation price of one Duo of that plan, in cents

  Outputs the line, or nothing for a plan that is not a year plan or while year plans are 1 Duo per
  delivery (the product page then keeps its earlier text).
{%- endcomment -%}
{%- liquid
  capture kc_year_type
    render 'kc-plan-type', plan_id: plan_id
  endcapture
  capture kc_year_table_units
    render 'kc-plan-type', plan_id: plan_id, field: 'units'
  endcapture
  assign kc_year_table_units = kc_year_table_units | plus: 0

  if kc_year_type == 'year' and kc_year_table_units > 1 and price != blank
    capture kc_year_deliveries
      render 'kc-plan-type', plan_id: plan_id, field: 'deliveries'
    endcapture
    assign kc_year_deliveries = kc_year_deliveries | plus: 0
    assign kc_year_units = kc_year_table_units
    assign kc_year_duos = kc_year_units | times: kc_year_deliveries
    assign kc_year_second_month = 12 | divided_by: kc_year_deliveries
    assign kc_year_price_per_duo = price | times: kc_year_units | times: 1.0 | divided_by: kc_year_duos | round
    assign kc_year_price_per_duo = kc_year_price_per_duo | money_without_trailing_zeros

    echo 'kc.year_plan.duos_per_year' | t: count: kc_year_duos
    echo ' · '
    echo 'kc.year_plan.deliveries' | t: count: kc_year_units, month: kc_year_second_month
    echo ' · '
    echo 'kc.year_plan.price_per_duo' | t: price: kc_year_price_per_duo
  endif
-%}
