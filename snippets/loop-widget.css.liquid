.loop-hidden {
    display: none !important;
}

.loop-full-width {
    width: 100% !important;
}

.loop-subscription-container {
    display: flex;
    flex-direction: column;
}

.loop-selling-plan-fieldset {
    padding: 0;
    margin: 15px 0;
    flex-basis: 100%;
    border: none;
    overflow: visible;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.loop-selling-plan-fieldset-legend {
    display: none;
}

.loop-one-time-purchase-option-position {
    display: flex;
    background: rgba(255, 251, 246, 0.03);
    border: 1px solid rgba(255, 251, 246, 0.1);
    border-radius: 12px;
    box-sizing: border-box;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    width: 100%;
}

.loop-purchase-options-label {
    width: auto !important;
    flex: 2;
    padding: 0 !important;
    margin: 0 !important;
    font-size: 1.1em !important;
    line-height: 1.1em !important;
    display: flex;
    gap: var(--gap-lg);
    align-items: center;
}

.loop-purchase-options-label .continuum-eyebrow {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--km-body-xs);
    color: var(--accent);
}

.loop-purchase-options-label .continuum-line {
    background: rgba(255, 251, 246, 0.15);
    flex: 1;
    height: 1px;
}

.loop-purchase-options-label .continuum-desc {
    font-size: var(--km-body-xs);
}

.loop-purchase-options-label.continuum-desc {
    flex: 0 0 auto;
    white-space: nowrap;
}

.loop-one-time-purchase-option {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 16px;
}

.loop-one-time-purchase-option-radio {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    min-height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    outline: none;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin: 0 1rem 0 0;
    padding: 0;
    flex-shrink: 0;
    transition: all 0.2s ease;
}

.loop-one-time-purchase-option-radio:checked {
    background: radial-gradient(circle, var(--accent) 0 4px, transparent 4.5px), rgba(127, 185, 255, 0.10);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(127, 185, 255, 0.30);
}

[data-theme="night"] .loop-one-time-purchase-option-radio:not(:checked) {
    border-color: #dddbd9;
    background: transparent;
}

.loop-one-time-purchase-option-label {
    width: auto;
    font-size: var(--km-body-xl);
    font-weight: 600;
    flex: 2;
    padding: 0;
    margin: 0;
    letter-spacing: -0.015em;
}

.loop-one-time-purchase-option-price-container {
    text-align: right;
    flex: 1;
}

.loop-one-time-purchase-option-price-amount {
    line-height: 1.2em;
    font-size: 1em;
}

.loop-one-time-purchase-option-price-quantity {
    line-height: 1em;
    font-size: 0.8em;
    opacity: 0.8;
}

.loop-selling-plan-allocation {
    display: flex;
    margin-bottom: 4px;
}

.loop-subscription-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    background: rgba(255, 251, 246, 0.03);
    border: 1px solid rgba(255, 251, 246, 0.1);
    border-radius: 12px;
    box-sizing: border-box;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    width: 100%;
    position: relative;
}

.loop-subscription-group-border-top {
    border-top: none;
}

.loop-subscription-group-border-bottom {
    border-bottom: none;
}

.loop-subscription-group:has(.loop-subscription-group-radio:checked),
.loop-one-time-purchase-option-position:has(.loop-one-time-purchase-option-radio:checked) {
    border-color: var(--accent, #7fb9ff);
    box-shadow: 0 0 0 1px var(--accent, #7fb9ff);
    background: rgb(22, 28, 56);
}

.loop-subscription-group:has(.loop-subscription-group-radio:checked) .loop-subscription-group-label,
.loop-one-time-purchase-option-position:has(.loop-one-time-purchase-option-radio:checked) .loop-one-time-purchase-option-label {
    color: var(--accent);
}

.loop-subscription-group .loop-subscription-group-radio {
    width: 20px !important;
}

.loop-subscription-group-radio {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 20px !important;
    height: 20px;
    min-height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    outline: none;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin: 0 1rem 0 0;
    padding: 0;
    flex-shrink: 0;
    transition: all 0.2s ease;
}

.loop-subscription-group-radio:checked {
    background: radial-gradient(circle, var(--accent) 0 4px, transparent 4.5px), rgba(127, 185, 255, 0.10);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(127, 185, 255, 0.30);
}

[data-theme="night"] .loop-subscription-group-radio:not(:checked) {
    border-color: #dddbd9;
    background: transparent;
}

.loop-subscription-group-text {
    display: flex;
    flex-wrap: wrap;
    flex: 3;
    align-items: center;
}

.loop-subscription-group-label {
    width: auto;
    padding: 0;
    margin: 0 1em 0 0;
    font-size: var(--km-body-2xl);
    font-weight: 600;
    display: flex;
    align-items: center;
    letter-spacing: -0.015em
}

.loop-subscription-group-discount-badge {
    border-radius: 50px;
    padding: 0.3em 0.8em;
    background: #53cf54;
    display: flex;
    justify-content: center;
    width: max-content;
    line-height: 1.2em;
    font-size: 1em;
}

.loop-subscription-group-price-container {
    text-align: right;
    flex: 1;
}

.loop-subscription-group-price-amount {
    line-height: 1.2em;
    font-size: 1em;
}

.loop-subscription-group-price-quantity {
    line-height: 1em;
    font-size: 0.8em;
    opacity: 0.8;
}

.loop-subscription-group-selling-plans-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 8px;
}

/* Frequency dropdown hidden — JS dynamically builds per-brushing sub-row text */
.loop-selling-plan-selector {
    display: none;
}

.loop-selling-plan-selector-label {
    display: none !important;
}

.loop-selling-plan-selector,
.loop-selling-plan-selector:focus,
.loop-selling-plan-selector:focus-visible,
.loop-selling-plan-selector:-moz-focusring {
    display: none !important;
}

.loop-selling-plan-selector-option {
    display: flex;
    align-items: center;
}

.loop-selling-plan-selector-description {
    width: 100%;
    font-size: 0.9em !important;
    line-height: normal !important;
    margin: 0 !important;
    padding: 0 !important;
    opacity: 1;
}

.loop-subscription-group-radio:not(:checked)~.loop-subscription-group-selling-plans-container {
    display: none !important;
}

/* "/ 60 days" or "/ year" label — RIGHT side, injected by JS inside price-container */
.kc-plan-interval-label {
    display: block;
    font-size: 0.72em;
    opacity: 0.7;
    margin-top: 2px;
    text-align: right;
    white-space: nowrap;
}

/* "£0.43 / brushing · ships every 60 days" — LEFT side, injected by JS inside group-text */
.loop-price-container {
    display: flex;
    align-items: center;
    flex-direction: column;
}

.loop-price-section {
    width: 100%;
    display: flex;
    flex-direction: row;
}

.loop-price-section-subscription-banner {
    display: flex;
    align-items: center;
    padding: 0px 5px;
    border: 1px solid;
    border-radius: 5px;
    line-height: 11px;
    margin-left: 8px;
}


.loop-compare-price {
    text-decoration: line-through;
}

.loop-dot {
    height: 4px;
    width: 4px;
    background-color: #000;
    border-radius: 50%;
    display: inline-block;
    margin: 0 10px;
}

.loop-display-none {
    display: none !important;
}

.loop-display-none-by-variant {
    display: none !important;
}

.loop-left-margin-0 {
    margin-left: 0 !important;
}

.loop-tooltip {
    position: relative;
    display: flex;
    align-items: center;
    width: fit-content;
    padding-bottom: 1em;
    margin-top: -10px;
}

.loop-tooltip-label {
    display: flex;
    cursor: pointer;
}

.loop-tooltip-image {
    height: 18px;
    width: 18px;
    margin-right: 10px;
    display: flex;
    align-items: center;
}

.loop-tooltip .loop-tooltiptext {
    visibility: hidden;
    width: 300px;
    min-width: 100%;
    background-color: #081d33;
    color: #fff;
    text-align: left;
    border-radius: 6px;
    padding: 15px;
    margin-top: -10px;

    position: absolute;
    z-index: 9999 !important;
    top: 100%;
    left: 0%;
}

.loop-tooltip:hover .loop-tooltiptext {
    visibility: visible;
}

.loop-tooltip-description {
    margin: 0 !important;
    padding: 0 !important;
    font-size: 1em;
}

.loop-container-arrow {
    height: 16px;
    width: 16px;
    background-color: #081d33;
    position: absolute;
}

.loop-container-arrow--tl {
    left: 32px;
    top: 0px;
    border-left: 1px solid rgba(0, 0, 0, 0.3);
    border-top: 1px solid rgba(0, 0, 0, 0.3);
    transform: translate(50%, -50%) rotate(45deg);
}

/* Welcome Kit Custom Styles */
.loop-welcome-kit-section {
    background: rgba(17, 21, 45, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
}

.loop-welcome-kit-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    cursor: pointer;
    user-select: none;
}

.loop-welcome-kit-title {
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF !important;
    font-family: inherit;
    letter-spacing: -0.2px;
}

.loop-welcome-kit-badge {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #E2E4F0 !important;
    text-transform: lowercase;
    white-space: nowrap;
    letter-spacing: -0.1px;
}

.loop-welcome-kit-toggle {
    font-size: 18px;
    font-weight: 400;
    color: #A3A7C7;
    margin-left: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    cursor: pointer;
    user-select: none;
    transition: color 0.15s ease-in-out;
}

.loop-welcome-kit-header:hover .loop-welcome-kit-toggle {
    color: #FFFFFF;
}

.loop-welcome-kit-toggle::before {
    content: "+";
}

.loop-welcome-kit-section.is-expanded .loop-welcome-kit-toggle::before {
    content: "×";
    font-size: 20px;
}

.loop-welcome-kit-products {
    display: none;
    /* Collapsed by default */
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.loop-welcome-kit-section.is-expanded .loop-welcome-kit-products {
    display: grid;
    /* Expanded */
}

.loop-welcome-kit-product {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.loop-welcome-kit-product-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin-bottom: 8px;
    border-radius: 4px;
    transition: transform 0.2s ease-in-out;
}

.loop-welcome-kit-product:hover .loop-welcome-kit-product-img {
    transform: scale(1.05);
}

.loop-welcome-kit-product-link {
    font-size: 11px;
    line-height: 1.3;
    color: #E2E4F0 !important;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    margin: 0 0 4px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.6em;
    cursor: pointer;
    transition: color 0.15s ease-in-out;
}

.loop-welcome-kit-product-link:hover {
    color: #FFFFFF !important;
}

.loop-welcome-kit-product-price {
    font-size: 11px;
    color: #A3A7C7;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    margin-top: 2px;
}

.loop-welcome-kit-product-price del {
    text-decoration: line-through;
    opacity: 0.6;
}

@media screen and (max-width: 480px) {
    .loop-welcome-kit-section {
        padding: 12px;
    }

    .loop-welcome-kit-products {
        gap: 8px;
    }

    .loop-welcome-kit-product-img {
        width: 48px;
        height: 48px;
    }

    .loop-welcome-kit-product-link {
        font-size: 10px;
    }

    .loop-welcome-kit-badge {
        padding: 3px 8px;
        font-size: 10px;
    }
}

/* KC Pricing Summary Box */
.kc-pricing-summary {
    background: var(--color-loop-pricing-summary-bg, #0d1b2e);
    border-radius: 10px;
    padding: 14px 18px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.kc-pricing-summary__total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
}

.kc-pricing-summary__label {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-loop-pricing-summary-text, #ffffff);
    letter-spacing: -0.01em;
}

.kc-pricing-summary__price {
    font-size: 26px;
    font-weight: 700;
    color: var(--color-loop-pricing-summary-text, #ffffff);
    letter-spacing: -0.02em;
}

.kc-pricing-summary__sub-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.kc-pricing-summary__per-brushing,
.kc-pricing-summary__interval {
    font-size: 12px;
    color: var(--color-loop-pricing-summary-muted, rgba(255, 255, 255, 0.55));
    letter-spacing: 0;
}

.night-mode .kc-pricing-summary {
    background: #0d1b2e;
}

/* KC Reward Grid Styles */
.kc-reward-grid {
    display: flex;
    gap: 16px;
    margin: 16px 0;
    width: 100%;
}

.kc-reward-tile {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: rgba(255, 251, 246, 0.03);
    border: 1px solid rgba(255, 251, 246, 0.1);
    border-radius: 16px;
    box-sizing: border-box;
    min-height: 90px;
}

.kc-reward-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex: 1;
    gap: 4px;
}

.kc-reward-amt {
    font-size: 24px;
    color: rgb(var(--color-foreground, 255, 255, 255));
    line-height: 1.1;
    letter-spacing: -0.04em;
}

.kc-reward-label {
    font-size: 12px;
    font-weight: 500;
    color: rgba(var(--color-foreground, 255, 255, 255), 0.8);
    line-height: 1.3;
}

.kc-laurel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: auto;
    flex-shrink: 0;
}

.kc-laurel img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
}

.kc-laurel-r img {
    transform: scaleX(-1);
}

@media screen and (max-width: 749px) {
    .kc-reward-grid {
        flex-direction: column;
        gap: 12px;
    }

    .kc-reward-tile {
        padding: 14px 16px;
        min-height: 80px;
    }

    .kc-reward-amt {
        font-size: 20px;
    }
}

/* KC Testimonial & Golden Button Styles */
.kc-testimonial-section {
    margin-top: 16px;
    width: 100%;
}

.kc-testimonial-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
}

.kc-testimonial-card {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: rgba(255, 251, 246, 0.03);
    border: 1px solid rgba(255, 251, 246, 0.1);
    border-radius: 16px;
    box-sizing: border-box;
}

.kc-testimonial-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
}

.kc-testimonial-avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 251, 246, 0.1);
    color: rgba(255, 251, 246, 0.6);
    flex-shrink: 0;
}

.kc-testimonial-avatar-fallback svg {
    width: 24px;
    height: 24px;
}

.kc-testimonial-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.kc-testimonial-stars {
    color: #ffb800;
    font-size: 14px;
    letter-spacing: 2px;
    line-height: 1;
}

.kc-testimonial-text {
    font-size: 13px;
    font-style: italic;
    color: rgb(var(--color-foreground, 255, 255, 255));
    line-height: 1.4;
    margin: 0 !important;
    padding: 0 !important;
    text-align: left;
}

body.night-mode [class*=color-scheme-] .kc-testimonial-button {
    color: #2A1A05;
}

.kc-testimonial-button {
    border-radius: 12px 0 14px 0;
    background: linear-gradient(160deg, #b8841f 13.2%, #d4a943 27.9%, #f4d781 41.2%, #fff2b8 50%, #f4d781 58.8%, #d4a943 72.1%, #b8841f 86.8%);
    box-shadow: 0 4px 14px -2px rgba(196, 152, 50, 0.55), inset 0 1px 0 rgba(255, 247, 220, 0.7), inset 0 -1px 0 rgba(120, 80, 20, 0.35);
    z-index: 2;
    overflow: hidden;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 800;
    padding: 9px 14px;
    position: absolute;
    bottom: -1.5px;
    right: -2.5px;
}


@media screen and (max-width: 749px) {
    .kc-testimonial-wrapper {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
    }

    .kc-testimonial-button {
        width: 100%;
        padding: 14px;
    }
}