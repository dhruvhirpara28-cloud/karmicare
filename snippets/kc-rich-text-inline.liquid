{%- comment -%}
  Prints a metaobject text field the way an inline_richtext setting prints:
  inline HTML only (strong, em, a), no wrapping <div> or <p>, so the result
  can sit inside a heading. Shopify's own metafield_tag wraps rich text in
  <div class="metafield-rich_text_field"><p>…</p></div>, which cannot.

  A rich_text_field value is a JSON tree: root > paragraph | heading | list >
  text (value, bold, italic) | link (url, title, target, children: text).
  Paragraphs and headings are joined with <br>; list items are run together,
  a list has no inline equivalent. Any other field type (for example a
  multi_line_text_field used in place of rich text) prints escaped, with
  its line breaks as <br>.

  Links: only http, https, mailto and tel URLs, and relative, query or anchor
  URLs (no scheme), become an <a>; anything else, such as javascript: or
  data:, prints its text without a link. The check reads the URL trimmed and
  lowercased, so case and surrounding whitespace do not get a scheme past
  it, and a tab or newline inside the scheme name fails the match. Every
  attribute is escaped; target is printed only as _blank, with rel=noopener.

  Accepts:
  - field: {Object} The metaobject field (a metafield object), for example card.heading
{%- endcomment -%}
{%- liquid
  if field.type == 'rich_text_field'
    for node in field.value.children
      unless forloop.first
        echo '<br>'
      endunless
      assign inline_nodes = node.children
      if node.type == 'list'
        assign inline_nodes = '' | split: ''
        for item in node.children
          assign inline_nodes = inline_nodes | concat: item.children
        endfor
      endif
      for child in inline_nodes
        if child.type == 'link'
          assign link_url = child.url | strip
          assign link_start = link_url | slice: 0, 1
          assign link_scheme = link_url | downcase | split: ':' | first
          assign link_ok = false
          if link_url == blank
            assign link_ok = false
          elsif link_start == '/' or link_start == '#' or link_start == '?' or link_start == '.'
            assign link_ok = true
          elsif link_url contains ':'
            if link_scheme == 'http' or link_scheme == 'https' or link_scheme == 'mailto' or link_scheme == 'tel'
              assign link_ok = true
            endif
          else
            assign link_ok = true
          endif
          if link_ok
            echo '<a href="'
            echo link_url | escape
            echo '"'
            if child.title != blank
              echo ' title="'
              echo child.title | escape
              echo '"'
            endif
            if child.target == '_blank'
              echo ' target="_blank" rel="noopener"'
            endif
            echo '>'
          endif
          for text in child.children
            if text.bold
              echo '<strong>'
            endif
            if text.italic
              echo '<em>'
            endif
            echo text.value | escape
            if text.italic
              echo '</em>'
            endif
            if text.bold
              echo '</strong>'
            endif
          endfor
          if link_ok
            echo '</a>'
          endif
        else
          if child.bold
            echo '<strong>'
          endif
          if child.italic
            echo '<em>'
          endif
          echo child.value | escape
          if child.italic
            echo '</em>'
          endif
          if child.bold
            echo '</strong>'
          endif
        endif
      endfor
    endfor
  else
    echo field.value | escape | newline_to_br
  endif
-%}
