{%- comment -%}
  The product page H1 (title block of sections/main-product.liquid).

  With the Loop block's "Try once: card on top" and a "Title line 1" (Victor, 24 Nov,
  docs/buybox-ab/PLAN.md) it is two lines in one H1: line 1 as set, line 2 the product title in the
  page language without the words set in "Line 2: leave out at the start" (default "Awake & Asleep"),
  first letter capitalised, in the second tone of the section titles. Otherwise the product title, as
  before.

  Accepts:
  - product: {Object}
  - block: {Object} the title block
  - layout: {String} the Loop block setting try_once_layout ('card' or 'link')
{%- endcomment -%}
{%- liquid
  assign kc_line_1 = block.settings.title_line_1 | strip
  assign kc_line_2 = ''
  if layout == 'card' and kc_line_1 != blank
    assign kc_line_2 = product.title
    assign kc_leave_out = block.settings.title_line_2_remove | strip
    if kc_leave_out != blank
      assign kc_start = product.title | slice: 0, kc_leave_out.size
      if kc_start == kc_leave_out
        assign kc_line_2 = product.title | remove_first: kc_leave_out | strip
        assign kc_first = kc_line_2 | slice: 0 | upcase
        assign kc_rest = kc_line_2 | slice: 1, kc_line_2.size
        assign kc_line_2 = kc_first | append: kc_rest
      endif
    endif
  endif
-%}
{%- if kc_line_2 != blank -%}
  <h1 class="h4 kc-product-title">
    <span class="kc-product-title__name">{{ kc_line_1 | escape }}</span>
    <span class="kc-product-title__line">{{ kc_line_2 | escape }}</span>
  </h1>
{%- else -%}
  <h1 class="h4">{{ product.title | escape }}</h1>
{%- endif -%}
