{%- comment -%}
  Research card body: KC/Research_card (Figma 2642:2211, component 3374:8313).
  Shared by the grid/slider and the marquee in sections/research-behind-system.liquid.
  With an image the card is the "Image=Right" variant (desktop 780 wide, picture on
  the right; mobile picture under the body). Without one it is "Image=None" (380 wide).
  The caller adds research-card--media on the <li> when block.settings.image is set.

  Accepts:
  - block: {Object} The section's card block
{%- endcomment -%}
<div class="research-card__content">
  <div class="research-card__top">
    {%- if block.settings.subheading != blank -%}
      <p class="research-card__subheading">{{ block.settings.subheading }}</p>
    {%- endif -%}
    {%- if block.settings.heading != blank -%}
      <h3 class="research-card__heading">{{ block.settings.heading }}</h3>
    {%- endif -%}
    {%- if block.settings.subtext != blank -%}
      <p class="research-card__subtext">{{ block.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <div class="research-card__details">
    {%- if block.settings.result_text != blank -%}
      <div class="research-card__detail-group">
        <span class="research-card__label">{{ block.settings.result_label }}</span>
        <p class="research-card__detail">{{ block.settings.result_text }}</p>
      </div>
    {%- endif -%}
    {%- if block.settings.method_text != blank -%}
      <div class="research-card__detail-group">
        <span class="research-card__label">{{ block.settings.method_label }}</span>
        <p class="research-card__detail">{{ block.settings.method_text }}</p>
      </div>
    {%- endif -%}

    {%- if block.settings.link_label != blank or block.settings.logo != blank -%}
      <div class="research-card__footer">
        {%- if block.settings.link_label != blank -%}
          {%- comment -%} Without a study URL the chip is a plain label: no dead "#" link, no external-link icon {%- endcomment -%}
          {%- if block.settings.link_url != blank -%}
            <a href="{{ block.settings.link_url }}" class="research-card__source">
              <span class="research-card__source-text">{{ block.settings.link_label }}</span>
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M14 6V2H10M14 2L6.66667 9.33334M12 8.66667V12.6667C12 13.0203 11.8595 13.3594 11.6095 13.6095C11.3594 13.8595 11.0203 14 10.6667 14H3.33333C2.97971 14 2.64057 13.8595 2.39052 13.6095C2.14048 13.3594 2 13.0203 2 12.6667V5.33333C2 4.97971 2.14048 4.64057 2.39052 4.39053C2.64057 4.14048 2.97971 4 3.33333 4H7.33333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- else -%}
            <span class="research-card__source">
              <span class="research-card__source-text">{{ block.settings.link_label }}</span>
            </span>
          {%- endif -%}
        {%- endif -%}
        {%- if block.settings.logo != blank -%}
          {{ block.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', class: 'research-card__logo' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if block.settings.image != blank -%}
  <div class="research-card__image-wrapper">
    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 400px, 320px', widths: '400, 640, 800' }}
    {%- if block.settings.image_badge != blank -%}
      <span class="research-card__badge">{{ block.settings.image_badge }}</span>
    {%- endif -%}
  </div>
{%- endif -%}
