{%- comment -%}
  Research card body: KC/Research_card (Figma 2642:2211, component 3374:8313).
  Shared by the grid/slider and the marquee in sections/research-behind-system.liquid.
  With an image the card is the "Image=Right" variant (desktop 780 wide, picture on
  the right; mobile picture under the body). Without one it is "Image=None" (380 wide).
  The caller adds research-card--media on the <li> when the card has an image.

  The copy comes from one of two sources, which print the same HTML:
  - block: a Research Card block of the section (the five cards duplicated per
    template today);
  - card: a research_card metaobject entry (Content > Metaobjects), the one copy
    every page shares. Fields: subheading, heading (rich text), subtext,
    result_label, result_text, method_label, method_text, link_label, link_url,
    logo, image, image_badge. Single and multi-line text prints escaped, with
    line breaks as <br>; the rich text heading prints inline through
    snippets/kc-rich-text-inline.liquid.

  Accepts:
  - block: {Object} The section's card block, or
  - card: {Object} A research_card metaobject entry
{%- endcomment -%}
{%- liquid
  if card
    assign card_subheading = card.subheading.value | escape
    assign card_subtext = card.subtext.value | escape | newline_to_br
    assign card_result_label = card.result_label.value | escape
    assign card_result_text = card.result_text.value | escape | newline_to_br
    assign card_method_label = card.method_label.value | escape
    assign card_method_text = card.method_text.value | escape | newline_to_br
    assign card_link_label = card.link_label.value | escape
    assign card_link_url = card.link_url.value
    assign card_logo = card.logo.value
    assign card_image = card.image.value
    assign card_image_badge = card.image_badge.value | escape
  else
    assign card_subheading = block.settings.subheading
    assign card_subtext = block.settings.subtext
    assign card_result_label = block.settings.result_label
    assign card_result_text = block.settings.result_text
    assign card_method_label = block.settings.method_label
    assign card_method_text = block.settings.method_text
    assign card_link_label = block.settings.link_label
    assign card_link_url = block.settings.link_url
    assign card_logo = block.settings.logo
    assign card_image = block.settings.image
    assign card_image_badge = block.settings.image_badge
  endif
-%}
{%- capture card_heading -%}
  {%- if card -%}
    {%- render 'kc-rich-text-inline', field: card.heading -%}
  {%- else -%}
    {{- block.settings.heading -}}
  {%- endif -%}
{%- endcapture -%}
<div class="research-card__content">
  <div class="research-card__top">
    {%- if card_subheading != blank -%}
      <p class="research-card__subheading">{{ card_subheading }}</p>
    {%- endif -%}
    {%- if card_heading != blank -%}
      <h3 class="research-card__heading">{{ card_heading }}</h3>
    {%- endif -%}
    {%- if card_subtext != blank -%}
      <p class="research-card__subtext">{{ card_subtext }}</p>
    {%- endif -%}
  </div>

  <div class="research-card__details">
    {%- if card_result_text != blank -%}
      <div class="research-card__detail-group">
        <span class="research-card__label">{{ card_result_label }}</span>
        <p class="research-card__detail">{{ card_result_text }}</p>
      </div>
    {%- endif -%}
    {%- if card_method_text != blank -%}
      <div class="research-card__detail-group">
        <span class="research-card__label">{{ card_method_label }}</span>
        <p class="research-card__detail">{{ card_method_text }}</p>
      </div>
    {%- endif -%}

    {%- if card_link_label != blank or card_logo != blank -%}
      <div class="research-card__footer">
        {%- if card_link_label != blank -%}
          {%- comment -%} Without a study URL (blank or a bare "#") the chip is a plain label: no dead link, no external-link icon {%- endcomment -%}
          {%- if card_link_url != blank and card_link_url != '#' -%}
            {%- comment -%} The study opens in a new tab: publishers (PMC, Spandidos, Wiley) refuse framing, and the reader keeps their place on the page {%- endcomment -%}
            <a href="{{ card_link_url }}" class="research-card__source" target="_blank" rel="noopener">
              <span class="research-card__source-text">{{ card_link_label }}</span>
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M14 6V2H10M14 2L6.66667 9.33334M12 8.66667V12.6667C12 13.0203 11.8595 13.3594 11.6095 13.6095C11.3594 13.8595 11.0203 14 10.6667 14H3.33333C2.97971 14 2.64057 13.8595 2.39052 13.6095C2.14048 13.3594 2 13.0203 2 12.6667V5.33333C2 4.97971 2.14048 4.64057 2.39052 4.39053C2.64057 4.14048 2.97971 4 3.33333 4H7.33333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
            </a>
          {%- else -%}
            <span class="research-card__source">
              <span class="research-card__source-text">{{ card_link_label }}</span>
            </span>
          {%- endif -%}
        {%- endif -%}
        {%- if card_logo != blank -%}
          {{ card_logo | image_url: width: 200 | image_tag: loading: 'lazy', class: 'research-card__logo' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if card_image != blank -%}
  <div class="research-card__image-wrapper">
    {{ card_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 400px, 320px', widths: '400, 640, 800' }}
    {%- if card_image_badge != blank -%}
      <span class="research-card__badge">{{ card_image_badge }}</span>
    {%- endif -%}
  </div>
{%- endif -%}
