{% comment %}
  Sticky buy bar: a glass card that summarises the plan the buybox has selected
  (docs/pdp-sticky-bar/PLAN.md; Figma 3rOMJvQZTzyYjnCV6oggV3, section 4079:32306).
  It mirrors the buybox and never chooses a plan itself. The CTA buys exactly what the buybox form
  holds, plan and variant (assets/kc-plan-select.js), through window.karmiAddToCart.
{% endcomment %}

{{ 'component-sticky-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_bundle_product = false
  for prod_item in settings.welcome_kit_bundle_products
    assign prod = prod_item
    if prod_item.id == null
      assign prod = all_products[prod_item]
    endif
    if prod != blank and prod.id == product.id
      assign is_bundle_product = true
    endif
  endfor

  assign welcome_kit_variant_ids = ''
  for prod_item in settings.welcome_kit_free_product
    assign prod = prod_item
    if prod_item.id == null
      assign prod = all_products[prod_item]
    endif
    if prod != blank and prod.variants.first != blank
      assign welcome_kit_variant_ids = welcome_kit_variant_ids | append: prod.variants.first.id | append: ','
    endif
  endfor

  assign kit_received = false
  if customer and customer.tags contains 'FREE WELCOME KIT RECEIVED'
    assign kit_received = true
  endif

  assign current_variant = product.selected_or_first_available_variant
-%}

{%- comment -%}
  What the checkout charges, in cents, per variant: one time, and per selling plan Shopify's price per
  quantity x quantity, the quantity being the plan's Duos per delivery (snippets/kc-plan-type.liquid;
  a year plan's year total, never a per-Duo price)
{%- endcomment -%}
{%- capture sc_prices -%}
  {"oneTime": {
  {%- for variant in product.variants -%}
    "{{ variant.id }}": {{ variant.price }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  }, "plans": {
  {%- for variant in product.variants -%}
    "{{ variant.id }}": {
    {%- for alloc in variant.selling_plan_allocations -%}
      {%- capture sc_units -%}
        {%- render 'kc-plan-type', plan_id: alloc.selling_plan.id, field: 'units' -%}
      {%- endcapture -%}
      "{{ alloc.selling_plan.id }}": {{ alloc.price | times: sc_units }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  }}
{%- endcapture -%}

<div
  class="sticky-cta"
  id="stickyCta"
  data-product-id="{{ product.id }}"
  inert
>
  {%- capture sc_spinner -%}
    <span class="loading__spinner hidden">
      <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
      </svg>
    </span>
  {%- endcapture -%}
  {%- comment -%}
    Line icons: Lucide (ISC), the "Interface" set of the KC Brand Design Library; stroke in .sc-icon
  {%- endcomment -%}

  {%- comment -%}
    Desktop (from 1081 px): the package as it will arrive, the Duo and the Welcome Kit items (the theme
    setting's products, as the buybox shows them: custom.kit_thumbnail, value struck through, Free)
  {%- endcomment -%}
  {%- liquid
    # The Duo's name on the Duo (the Welcome Kit bundle product); any other product shows its own title
    assign package_name = product.title
    if is_bundle_product
      assign package_name = block.settings.package_name | default: product.title
    endif
  -%}
  <div class="sc-package">
    <div class="sc-package-duo">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 320
          | image_tag: loading: 'lazy', width: 160, height: 160, class: 'sc-package-img', alt: package_name
        }}
      {%- endif -%}
      <p class="sc-package-name">{{ package_name | escape }}</p>
    </div>
    <span class="sc-package-plus" aria-hidden="true" data-sc-kit>+</span>
    <ul class="sc-kit" role="list" data-sc-kit>
      {%- for prod_item in settings.welcome_kit_free_product -%}
        {%- liquid
          assign prod = prod_item
          if prod_item.id == null
            assign prod = all_products[prod_item]
          endif
          if prod == blank
            continue
          endif
          assign kit_variant = prod.selected_or_first_available_variant
          assign kit_value = kit_variant.compare_at_price | default: kit_variant.price
          assign kit_thumbnail = prod.metafields.custom.kit_thumbnail.value | default: prod.featured_image
        -%}
        <li class="sc-kit-item">
          {%- if kit_thumbnail -%}
            {{ kit_thumbnail | image_url: width: 144 | image_tag: loading: 'lazy', width: 48, height: 48, class: 'sc-kit-img', alt: '' }}
          {%- endif -%}
          <span class="sc-kit-name">{{ prod.title | escape }}</span>
          <span class="sc-kit-value">
            {{- block.settings.kit_free | escape }} · <s>{{ kit_value | money_without_trailing_zeros }}</s>
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="sc-summary">
    <div class="sc-plan">
      <p class="sc-title"><span data-sc="name"></span><span class="sc-title-rest" data-sc="rest"></span></p>
      <p class="sc-kit-line" data-sc="kit-line" data-sc-kit></p>
      <p class="sc-price-line" data-sc="price"></p>
    </div>
    {%- comment -%} Control labels fall back to the schema defaults: a button never loses its name {%- endcomment -%}
    <button type="button" class="sc-change" data-sc-change>{{ block.settings.change_label | default: 'Change' | escape }}</button>
    <button type="submit" form="scCtaForm" class="sc-cta sc-cta--bar" data-sc-cta>
      <span>{{ block.settings.button_text | default: 'Begin now' | escape }}</span>
      {{- sc_spinner -}}
    </button>
  </div>
  <div class="sc-return">
    <p class="sc-credit" data-sc="credit"></p>
    <button
      type="button"
      class="sc-disclosure"
      id="scDisclosure"
      aria-expanded="false"
      aria-controls="scPanel"
    >
      <span class="visually-hidden" data-sc="panel-label"></span>
      <svg class="sc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m18 15-6-6-6 6"/></svg>
    </button>
  </div>
  <div class="sc-panel" id="scPanel" hidden>
    <p class="sc-info" data-sc="info"></p>
    <ul class="sc-rows" role="list">
      <li class="sc-row">
        <svg class="sc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
        <span data-sc="delivery"></span>
      </li>
      <li class="sc-row" data-sc-row="kit">
        <svg class="sc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>
        <span data-sc="kit"></span>
      </li>
      <li class="sc-row" data-sc-row="guarantee">
        <svg class="sc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        <span data-sc="guarantee"></span>
      </li>
      <li class="sc-row" data-sc-row="stop">
        <svg class="sc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"/><line x1="10" x2="10" y1="15" y2="9"/><line x1="14" x2="14" y1="15" y2="9"/></svg>
        <span data-sc="stop"></span>
      </li>
      <li class="sc-row" data-sc-row="brushing">
        <svg class="sc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m11 10 3 3"/><path d="M6.5 21A3.5 3.5 0 1 0 3 17.5a2.62 2.62 0 0 1-.708 1.792A1 1 0 0 0 3 21z"/><path d="M9.969 17.031 21.378 5.624a1 1 0 0 0-3.002-3.002L6.967 14.031"/></svg>
        <span data-sc="brushing"></span>
      </li>
    </ul>
    <button type="submit" form="scCtaForm" class="sc-cta sc-cta--panel" data-sc-cta>
      <span data-sc="cta"></span>
      {{- sc_spinner -}}
    </button>
    {%- comment -%} One time, straight to checkout, like the buybox's Try once (assets/kc-plan-select.js) {%- endcomment -%}
    <button
      type="button"
      class="sc-try-once"
      data-sc="try-once"
      data-kc-plan-choose="once"
      data-kc-plan-product="{{ product.id }}"
    ></button>
  </div>

  <form method="post" action="{{ routes.cart_add_url }}" id="scCtaForm" class="sc-form">
    <input type="hidden" name="id" id="scVariantId" value="{{ current_variant.id }}">
    <input type="hidden" name="selling_plan" id="scSellingPlanInput" value="">
    <input type="hidden" name="quantity" value="1">
  </form>

  <script type="application/json" data-sc-config>
    {
      "productId": {{ product.id | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "isBundle": {{ is_bundle_product | json }},
      "kitReceived": {{ kit_received | json }},
      "kitVariantIds": {{ welcome_kit_variant_ids | split: ',' | compact | json }},
      "hasPlans": {% if product.selling_plan_groups.size > 0 %}true{% else %}false{% endif %},
      "requiresPlan": {{ product.requires_selling_plan | json }},
      "productTitle": {{ product.title | json }},
      "buttonText": {{ block.settings.button_text | default: 'Begin now' | json }},
      {%- comment -%} Positions are CSS only: phones 12 px from the edges, 750–1080 centred at 448, from 1081 the centred package {%- endcomment -%}
      "prices": {{ sc_prices }},
      {%- comment -%} Copy: the block settings (P1–P7 of the brief); [price] [credit] [per_brushing] are filled per plan {%- endcomment -%}
      "copy": {
        "title_rhythm": {{ block.settings.title_rhythm | json }},
        "title_year": {{ block.settings.title_year | json }},
        "title_once": {{ block.settings.title_once | json }},
        "price_rhythm": {{ block.settings.price_rhythm | json }},
        "price_year": {{ block.settings.price_year | json }},
        "price_once": {{ block.settings.price_once | json }},
        "credit": {{ block.settings.credit | json }},
        "credit_checkup": {{ block.settings.credit_checkup | json }},
        "credit_info": {{ block.settings.credit_info | json }},
        "checkup_info": {{ block.settings.checkup_info | json }},
        "panel_label": {{ block.settings.panel_label | default: "Delivery & what's included" | json }},
        "cta_rhythm": {{ block.settings.cta_rhythm | default: 'Begin your 60-Day Rhythm' | json }},
        "cta_year": {{ block.settings.cta_year | default: 'Begin the Karmicare Year' | json }},
        "cta_once": {{ block.settings.cta_once | default: 'Try once' | json }},
        "delivery_free": {{ block.settings.delivery_free | json }},
        "delivery_once": {{ block.settings.delivery_once | json }},
        "kit": {{ block.settings.kit | json }},
        "guarantee_member": {{ block.settings.guarantee_member | json }},
        "guarantee_once": {{ block.settings.guarantee_once | json }},
        "stop_rhythm": {{ block.settings.stop_rhythm | json }},
        "stop_year": {{ block.settings.stop_year | json }},
        "per_brushing": {{ block.settings.per_brushing | json }},
        "try_once": {{ block.settings.try_once | json }}
      }
    }
  </script>
</div>

<script>
  (function () {
    'use strict';
    var bar = document.getElementById('stickyCta');
    if (!bar) return;
    var cfg = JSON.parse(bar.querySelector('[data-sc-config]').textContent);
    var form = document.getElementById('scCtaForm');
    var variantInput = document.getElementById('scVariantId');
    var planInput = document.getElementById('scSellingPlanInput');
    // Everything karmiAddToCart may disable while it works: the two CTAs and Try once
    var busyButtons = Array.prototype.slice.call(bar.querySelectorAll('[data-sc-cta], [data-sc="try-once"]'));
    var section = bar.closest('.shopify-section');
    var sectionId = section ? section.id : '';
    var ready = false;
    var shown = false;
    var disposed = false;
    var observers = [];
    // Plan mode only where the buybox shows Loop's plan choice (its server-rendered config is on the
    // page); otherwise the bar buys what the buybox form holds, one time, like that form does
    var usesLoop = cfg.hasPlans && Boolean(document.querySelector('.loopProductQuickJson-' + cfg.productId));

    // Every window and document listener goes through on(), so a theme-editor reload of the section can
    // dispose of this instance completely (dispose() below)
    var abort = typeof AbortController === 'function' ? new AbortController() : null;
    function on(target, type, handler, options) {
      var opts = Object.assign({}, options || {});
      if (abort) opts.signal = abort.signal;
      target.addEventListener(type, handler, opts);
    }

    function dispose() {
      if (disposed) return;
      disposed = true;
      if (abort) abort.abort();
      observers.forEach(function (observer) {
        observer.disconnect();
      });
      bar.remove();
      document.documentElement.style.removeProperty('--sticky-cta-height');
    }

    function field(name) {
      return bar.querySelector('[data-sc="' + name + '"]');
    }

    function setText(name, value) {
      var el = field(name);
      if (el && el.textContent !== value) el.textContent = value;
    }

    // The shop's money format (Shopify's formatMoney placeholders), whole amounts without ".00" / ",00"
    function money(cents) {
      function amount(precision, thousands, decimal) {
        var parts = (cents / 100).toFixed(precision).split('.');
        return parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands) + (parts[1] ? decimal + parts[1] : '');
      }
      if (!cfg.moneyFormat) return '€' + (cents % 100 === 0 ? amount(0, ',', '.') : amount(2, ',', '.'));
      var out = String(cfg.moneyFormat).replace(/\{\{\s*(\w+)\s*\}\}/, function (match, key) {
        if (key === 'amount_no_decimals') return amount(0, ',', '.');
        if (key === 'amount_with_comma_separator') return amount(2, '.', ',');
        if (key === 'amount_no_decimals_with_comma_separator') return amount(0, '.', ',');
        if (key === 'amount_with_apostrophe_separator') return amount(2, "'", '.');
        return amount(2, ',', '.');
      }).replace(/<[^>]*>/g, '');
      return cents % 100 === 0 ? out.replace(/[.,]00(?!\d)/, '') : out;
    }

    function fill(template, values) {
      return String(template || '').replace(/\[(price|credit|per_brushing)\]/g, function (match, key) {
        return values[key] || '';
      });
    }

    // What the buybox will buy right now: plan (or one time), variant, and the values the bar shows,
    // all by selling plan ID (assets/kc-plan-select.js). null while Loop has not chosen yet.
    function readState() {
      // A product without selling plans, or without Loop's plan choice on the page: what its buybox
      // form holds, one time
      if (!usesLoop) {
        // No variant in the form = an unavailable option combination (Dawn clears it): nothing to buy
        var idInput = document.querySelector('.product__info-container [name="id"]');
        var productVariant = idInput && idInput.value ? String(idInput.value) : '';
        if (!productVariant) return null;
        var productPrice = cfg.prices.oneTime[productVariant];
        if (productPrice == null) return null;
        return {
          type: 'product',
          planId: '',
          variantId: productVariant,
          price: productPrice,
          oneTimePrice: productPrice,
          credit: 0,
          perBrushing: 0,
          checkupReward: false
        };
      }
      var api = window.KCPlanSelect;
      var fieldset = document.getElementById('loop-selling-plan-fieldset');
      var checked = fieldset && fieldset.querySelector('input[type="radio"]:checked');
      if (!api || !checked) return null;
      var once = checked.dataset.id === 'loop-one-time-purchase';
      var planId = once ? '' : api.selectedPlanId(cfg.productId);
      var plan = planId ? api.plan(planId) : null;
      if (!once && !plan) return null;
      // Only the variant the buybox form holds; none (an unavailable combination) = nothing to buy
      var variantId = String(api.selectedVariantId(cfg.productId) || '');
      if (!variantId) return null;
      var price = once
        ? cfg.prices.oneTime[variantId]
        : (cfg.prices.plans[variantId] || {})[planId];
      if (price == null) return null;
      // Same sources as the buybox summary (assets/loop-widget.js): Return on Care %, else the plan's Care
      // Credit %; per brushing = what the checkout charges / (Duos x brushings per Duo)
      var creditPercent = plan ? (plan.returnOnCare > 0 ? plan.returnOnCare : plan.careCreditPercent || 0) : 0;
      var brushings = plan ? (plan.duos || 1) * (plan.brushings || 120) : 120;
      return {
        type: once ? 'once' : plan.type === 'year' ? 'year' : 'rhythm',
        planId: planId,
        variantId: variantId,
        price: price,
        oneTimePrice: cfg.prices.oneTime[variantId],
        credit: Math.round((price * creditPercent) / 100),
        perBrushing: Math.round(price / brushings),
        checkupReward: Boolean(plan && plan.checkupReward)
      };
    }

    // Loop can settle before kc-plan-select has read its config: try again for a few seconds
    var retries = 0;
    function render() {
      if (disposed) return false;
      var state = readState();
      if (!state) {
        // Never show (or buy) a stale plan: hidden until the buybox's selection reads again
        if (ready) {
          ready = false;
          updateVisibility();
        }
        if (retries++ < 40) setTimeout(queueRender, 300);
        return false;
      }
      retries = 0;
      var copy = cfg.copy;
      // 'product': a product without plans; its own title and price, no membership lines
      var plain = state.type === 'product';
      var once = state.type === 'once' || plain;
      var title = plain ? cfg.productTitle || '' : copy['title_' + state.type] || '';
      var cut = plain ? -1 : title.indexOf(' · ');
      setText('name', cut === -1 ? title : title.slice(0, cut));
      setText('rest', cut === -1 ? '' : title.slice(cut));
      setText('price', plain ? money(state.price) : fill(copy['price_' + state.type], { price: money(state.price) }));
      var credit =
        once || state.credit <= 0
          ? copy.panel_label
          : fill(state.checkupReward ? copy.credit_checkup : copy.credit, { credit: money(state.credit) });
      setText('credit', credit);
      setText('panel-label', copy.panel_label);
      var info = once ? '' : [copy.credit_info, state.checkupReward ? copy.checkup_info : ''].filter(Boolean).join(' ');
      setText('info', info);
      field('info').hidden = !info;
      setText('delivery', once ? copy.delivery_once : copy.delivery_free);
      // The Welcome Kit comes with a first membership order, until the customer has received it
      var kitOffered = !once && cfg.isBundle && !cfg.kitReceived;
      setText('kit', copy.kit);
      setText('kit-line', copy.kit ? '+ ' + copy.kit : '');
      bar.querySelector('[data-sc-row="kit"]').hidden = !kitOffered;
      Array.prototype.forEach.call(bar.querySelectorAll('[data-sc-kit]'), function (el) {
        el.hidden = !kitOffered;
      });
      setText('guarantee', once ? copy.guarantee_once : copy.guarantee_member);
      bar.querySelector('[data-sc-row="guarantee"]').hidden = plain;
      setText('stop', state.type === 'year' ? copy.stop_year : copy.stop_rhythm);
      bar.querySelector('[data-sc-row="stop"]').hidden = once;
      setText('brushing', fill(copy.per_brushing, { per_brushing: money(state.perBrushing) }));
      bar.querySelector('[data-sc-row="brushing"]').hidden = plain;
      setText('cta', plain ? cfg.buttonText || '' : copy['cta_' + state.type]);
      // Try once only where one time can be bought: not on subscription-only products
      var tryOnceText = !once && !cfg.requiresPlan && state.oneTimePrice != null ? fill(copy.try_once, { price: money(state.oneTimePrice) }) : '';
      setText('try-once', tryOnceText);
      // A blank setting hides the link rather than leaving an empty, focusable button
      field('try-once').hidden = !tryOnceText.trim();
      if (variantInput.value !== state.variantId) variantInput.value = state.variantId;
      if (planInput.value !== state.planId) planInput.value = state.planId;
      ready = true;
      updateVisibility();
      return true;
    }

    // One render per burst of Loop mutations (a timer, not a frame: a background tab draws no frames)
    var renderQueued = false;
    function queueRender() {
      if (renderQueued || disposed) return;
      renderQueued = true;
      setTimeout(function () {
        renderQueued = false;
        render();
      }, 50);
    }

    // Follow the buybox: Loop rewrites its fieldset on every plan or variant change. A product without
    // plans has no fieldset; its variant picker's changes reach the bar through on(document, 'change').
    function attachLoop(tries) {
      if (disposed) return;
      if (!usesLoop) {
        queueRender();
        return;
      }
      var fieldset = document.getElementById('loop-selling-plan-fieldset');
      if (!fieldset) {
        if (tries < 100) setTimeout(attachLoop, 300, tries + 1);
        return;
      }
      var loopObserver = new MutationObserver(queueRender);
      loopObserver.observe(fieldset, { subtree: true, childList: true, attributes: true });
      observers.push(loopObserver);
      queueRender();
    }

    /* The bar floats over the bottom of the page. While it shows, --sticky-cta-height holds how much of
       the bottom it covers (its height + its offset); the footer adds that much bottom padding and the
       cookie preferences panel (assets/kc-cookie-preferences.css) sits that much higher. */
    function reservePageEnd() {
      // Measured on the collapsed card only, so opening the panel never moves the page behind it
      if (open) return;
      if (shown) {
        var offset = parseFloat(getComputedStyle(bar).bottom) || 0;
        document.documentElement.style.setProperty('--sticky-cta-height', Math.ceil(bar.offsetHeight + offset) + 'px');
      } else {
        document.documentElement.style.removeProperty('--sticky-cta-height');
      }
    }

    /* When the bar shows: only once the visitor has scrolled past the buybox CTA (never over the plan
       cards while they choose), never while another way to begin is on screen (P8: the section of the
       comparison table, the plans table or the end CTA, whole, so the bar never covers their cards),
       and only once it knows the plan */
    var CTA_SELECTOR = '.product-form__submit, .comparison-section__button, [data-kc-plan-choose]';
    var buyboxCta = null;
    var pastBuybox = false;
    var sectionsOnScreen = new Set();
    var watched = new WeakSet();
    var ctaObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) sectionsOnScreen.add(entry.target);
        else sectionsOnScreen.delete(entry.target);
      });
      sectionsOnScreen.forEach(function (ctaSection) {
        if (!ctaSection.isConnected) sectionsOnScreen.delete(ctaSection);
      });
      updateVisibility();
    });
    observers.push(ctaObserver);

    // Past the buybox CTA = its bottom above the screen; from 750 px (two columns, the gallery sticky
    // beside the buybox) also past the gallery column, so the card never covers its thumbnails. Read on
    // scroll, not from an observer: a jump from below the screen to above it crosses no threshold.
    var gallery = document.querySelector('.product__media-wrapper');
    function checkBuybox() {
      var past = !buyboxCta || buyboxCta.getBoundingClientRect().bottom <= 0;
      if (past && gallery && window.innerWidth >= 750) past = gallery.getBoundingClientRect().bottom <= 0;
      if (past === pastBuybox) return;
      pastBuybox = past;
      updateVisibility();
    }

    function watchCtas() {
      if (disposed) return;
      if (!buyboxCta) {
        buyboxCta =
          document.querySelector('.product__info-container .product-form__submit') ||
          document.querySelector('.product-form__submit');
        checkBuybox();
      }
      var buyboxSection = buyboxCta && buyboxCta.closest('.shopify-section');
      Array.prototype.forEach.call(document.querySelectorAll(CTA_SELECTOR), function (cta) {
        if (cta === buyboxCta || bar.contains(cta)) return;
        var ctaSection = cta.closest('.shopify-section') || cta;
        if (ctaSection === buyboxSection || watched.has(ctaSection)) return;
        watched.add(ctaSection);
        ctaObserver.observe(ctaSection);
      });
    }

    function updateVisibility() {
      var visible = ready && pastBuybox && sectionsOnScreen.size === 0;
      if (visible === shown) return;
      shown = visible;
      if (!visible) setOpen(false);
      bar.classList.toggle('is-visible', visible);
      bar.inert = !visible;
      reservePageEnd();
    }

    /* Delivery & what's included: a disclosure. The card grows upwards; Esc and a tap outside close it. */
    var disclosure = document.getElementById('scDisclosure');
    var panel = document.getElementById('scPanel');
    var open = false;
    function setOpen(value, returnFocus) {
      if (value === open) return;
      open = value;
      bar.classList.toggle('is-open', open);
      // assets/kc-cookie-preferences.css drops its panel below the bar while this is set
      bar.classList.toggle('sc-dd-active', open);
      disclosure.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (!open) {
        reservePageEnd();
        if (returnFocus) disclosure.focus();
      }
    }

    disclosure.addEventListener('click', function () {
      setOpen(!open);
    });
    // The whole "what comes back" row opens it for pointer users; the chevron is the control
    bar.querySelector('.sc-return').addEventListener('click', function (event) {
      if (event.target.closest('button')) return;
      setOpen(!open);
    });
    on(document, 'keydown', function (event) {
      if (event.key === 'Escape' && open) setOpen(false, true);
    });
    on(document, 'pointerdown', function (event) {
      if (!open || bar.contains(event.target)) return;
      // Focus on a control inside the panel would be lost as it closes: hand it to the chevron, unless
      // the tap itself moved focus somewhere (a link, a field)
      var focusInside = bar.contains(document.activeElement);
      setOpen(false);
      if (!focusInside) return;
      setTimeout(function () {
        if (!document.activeElement || document.activeElement === document.body) disclosure.focus({ preventScroll: true });
      }, 0);
    });

    // Change (P7): one place to choose, the buybox plan cards
    bar.querySelector('[data-sc-change]').addEventListener('click', function () {
      setOpen(false);
      var plans = document.getElementById('loop-selling-plan-fieldset') || document.querySelector('.product__info-container');
      if (!plans) return;
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      plans.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
      var checked = plans.querySelector('input[type="radio"]:checked');
      if (checked) checked.focus({ preventScroll: true });
    });

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var button = event.submitter || busyButtons[0];
      // Buy exactly what the buybox holds right now, its plan included. If the bar cannot read it (a
      // variant without this plan, Loop still switching), buy nothing and hand over to the buybox.
      if (!render()) {
        var buybox = document.getElementById('loop-selling-plan-fieldset') || document.querySelector('.product__info-container');
        if (buybox) buybox.scrollIntoView({ block: 'center' });
        return;
      }
      if (typeof window.karmiAddToCart !== 'function') return;
      window.karmiAddToCart(form, button, {
        isBundleProduct: cfg.isBundle,
        customerAlreadyReceivedFreeProduct: cfg.kitReceived,
        welcomeKitVariantIds: cfg.kitVariantIds
      });
    });

    // Back from checkout (bfcache): the CTAs and Try once are usable again
    on(window, 'pageshow', function () {
      busyButtons.forEach(function (button) {
        button.disabled = false;
        button.removeAttribute('aria-disabled');
        button.classList.remove('loading');
        var spinner = button.querySelector('.loading__spinner');
        if (spinner) spinner.classList.add('hidden');
      });
    });

    function init() {
      // Out of the section's stacking context; a theme-editor reload replaces the earlier bar
      Array.prototype.forEach.call(document.querySelectorAll('body > #stickyCta'), function (old) {
        if (old !== bar) old.remove();
      });
      if (bar.parentNode !== document.body) document.body.appendChild(bar);

      if (window.ResizeObserver) {
        var barResize = new ResizeObserver(reservePageEnd);
        barResize.observe(bar);
        observers.push(barResize);
      }
      watchCtas();
      on(window, 'scroll', checkBuybox, { passive: true });
      on(window, 'resize', checkBuybox);
      // Sections that render late, and sections the theme editor adds
      setTimeout(watchCtas, 2000);
      on(document, 'shopify:section:load', watchCtas);
      // Plan and variant changes in the buybox (Loop's radios, the variant picker)
      on(document, 'change', function (event) {
        if (event.target && event.target.closest && event.target.closest('.product__info-container')) queueRender();
      });
      // Theme editor: the section is reloaded or removed; its new script builds a fresh bar
      on(document, 'shopify:section:unload', function (event) {
        if (sectionId && event.target && event.target.id === sectionId) dispose();
      });
      attachLoop(0);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
