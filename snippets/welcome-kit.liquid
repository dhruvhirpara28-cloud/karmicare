{% if settings.enable_welcome_kit %}
  <script>
    (function () {
      // ─── CONFIG (Theme Settings Driven) ──────────────────────────────────────
      const BUNDLE_PRODUCT_IDS = [
        {% for prod_item in settings.welcome_kit_bundle_products %}
          {%- liquid
            assign prod = prod_item
            if prod_item.id == nil
              assign prod = all_products[prod_item]
            endif
          -%}
          {% if prod != blank and prod.id != blank %}
            {{ prod.id }}{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ];

      const FREE_PRODUCTS = [
        {% for prod_item in settings.welcome_kit_free_product %}
          {%- liquid
            assign prod = prod_item
            if prod_item.id == nil
              assign prod = all_products[prod_item]
            endif
          -%}
          {% if prod != blank and prod.variants.first != blank %}
            {
              variantId: {{ prod.variants.first.id }},
              productId: {{ prod.id }}
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ];

      const DISCOUNT_CODE = 'Welcome Kit';

      // ─── GUARD: Exit if not configured ───────────────────────────────────────
      if (FREE_PRODUCTS.length === 0 || BUNDLE_PRODUCT_IDS.length === 0) return;

      // ─── CUSTOMER ELIGIBILITY CHECK (Server-side Liquid) ─────────────────────
      // true  = block free product (repeat buyer OR guest/not logged in)
      // false = allow free product (logged-in first-time customer only)
      const customerAlreadyReceivedFreeProduct = {% if customer.tags contains 'FREE WELCOME KIT RECEIVED' %}true{% elsif customer == null %}true{% else %}false{% endif %};

      let isUpdating = false;

      async function getCart() {
        const res = await fetch('/cart.js');
        return res.json();
      }

      async function addMultipleToCart(itemsArray) {
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsArray }),
        });
      }

      async function updateCartQuantities(updatesObject) {
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates: updatesObject }),
        });
      }

      async function applyDiscountCode() {
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ discount: DISCOUNT_CODE }),
          });
        } catch (e) {}
      }

      async function removeDiscountCode() {
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ discount: '' }),
          });
        } catch (e) {}
      }

      async function syncFreeProduct() {
        if (isUpdating) return;
        isUpdating = true;

        try {
          const cart = await getCart();
          const items = cart.items || [];

          const hasBundleItem = items.some((item) =>
            BUNDLE_PRODUCT_IDS.includes(item.product_id)
          );

          let cartChanged = false;

          if (customerAlreadyReceivedFreeProduct || !hasBundleItem) {
            // Guest OR repeat customer OR no bundle — remove free products (ONLY if they have the _welcome_kit property)
            const updates = {};
            for (const freeProd of FREE_PRODUCTS) {
              const freeLineItem = items.find((item) => 
                item.product_id === freeProd.productId && 
                item.properties && 
                item.properties['_welcome_kit'] === 'true'
              );
              if (freeLineItem) {
                updates[freeLineItem.key] = 0;
              }
            }
            if (Object.keys(updates).length > 0) {
              await updateCartQuantities(updates);
              await removeDiscountCode();
              cartChanged = true;
            }
          } else {
            // Logged-in first-time customer logic
            const toAdd = [];
            for (const freeProd of FREE_PRODUCTS) {
              const freeLineItem = items.find((item) => item.product_id === freeProd.productId);
              if (!freeLineItem) {
                toAdd.push({ 
                  id: freeProd.variantId, 
                  quantity: 1,
                  properties: { '_welcome_kit': 'true' }
                });
              }
            }
            if (toAdd.length > 0) {
              await addMultipleToCart(toAdd);
              await applyDiscountCode();
              cartChanged = true;
            }
          }

          if (cartChanged) {
            refreshCartDrawer();
          }
        } finally {
          isUpdating = false;
        }
      }

      function refreshCartDrawer() {
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        if (typeof window.refreshDawnCartUI === 'function') {
          window.refreshDawnCartUI().catch(() => {});
        } else if (typeof window.Shopify !== 'undefined') {
          fetch('/cart.js')
            .then((r) => r.json())
            .then((cart) => {
              document.dispatchEvent(
                new CustomEvent('cart:updated', { detail: { cart } })
              );
            });
        }
      }

      // ─── INTERCEPT CART EVENTS ────────────────────────────────────────────────
      const originalFetch = window.fetch;
      window.fetch = async function (...args) {
        const response = await originalFetch.apply(this, args);
        const url = typeof args[0] === 'string' ? args[0] : args[0]?.url || '';
        if (
          url.includes('/cart/add') ||
          url.includes('/cart/change') ||
          url.includes('/cart/update')
        ) {
          response.clone().json().then(() => syncFreeProduct()).catch(() => {});
        }
        return response;
      };

      document.addEventListener('cart:updated', syncFreeProduct);
      document.addEventListener('DOMContentLoaded', syncFreeProduct);
      window.karmiWelcomeKitSync = syncFreeProduct;

      // Tell the browser to run refreshCartDrawer() when the user clicks the "Back" button
      window.addEventListener('pageshow', (event) => {
        const isBackNavigation = event.persisted || 
          (window.performance && window.performance.navigation && window.performance.navigation.type === 2);
        if (isBackNavigation) {
          refreshCartDrawer();
        }
      });
    })();
  </script>
{% endif %}
