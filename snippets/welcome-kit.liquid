{% if settings.enable_welcome_kit %}
  <script>
    (function () {
      const BUNDLE_PRODUCT_IDS = [
        {% for prod_item in settings.welcome_kit_bundle_products %}
          {%- liquid
            assign prod = prod_item
            if prod_item.id == nil
              assign prod = all_products[prod_item]
            endif
          -%}
          {% if prod != blank and prod.id != blank %}
            {{ prod.id }}{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ];

      const FREE_PRODUCTS = [
        {% for prod_item in settings.welcome_kit_free_product %}
          {%- liquid
            assign prod = prod_item
            if prod_item.id == nil
              assign prod = all_products[prod_item]
            endif
          -%}
          {% if prod != blank and prod.variants.first != blank %}
            {
              variantId: {{ prod.variants.first.id }},
              productId: {{ prod.id }}
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ];

      const DISCOUNT_CODE = 'Welcome Kit';

      if (FREE_PRODUCTS.length === 0 || BUNDLE_PRODUCT_IDS.length === 0) return;

      const customerAlreadyReceivedFreeProduct = {% if customer and customer.tags contains 'FREE WELCOME KIT RECEIVED' %}true{% else %}false{% endif %};
      let isUpdating = false;

      async function getCart() {
        const res = await fetch('/cart.js');
        return res.json();
      }

      // A subscription without its whole kit (a cart that lost kit lines outside the theme: every add path
      // of the theme brings the kit in its own add). Added on its own, the kit would land above the plan
      // line, and the plan line belongs on top (cart order: assets/kc-plan-select.js addOrder). So on a
      // page that sells the plan product, its choice is added again with the whole kit, in order, through
      // KCPlanSelect.replaceChoice: one cart change at a time on the page, the earlier lines and
      // "Subscription Name" back when the add fails. Elsewhere the cart stays as it is. Reads the full cart.
      async function repairKit() {
        if (!window.KCPlanSelect) return false;
        const items = (await getCart()).items || [];
        const planItem = items.find((item) =>
          BUNDLE_PRODUCT_IDS.includes(item.product_id) &&
          item.selling_plan_allocation &&
          window.KCPlanSelect.manages(String(item.product_id))
        );
        if (!planItem) return false;
        if (FREE_PRODUCTS.every((freeProd) => items.some((item) => item.product_id === freeProd.productId))) return false;

        // The choice as it is, its rows of the same variant and plan counted together
        const planId = planItem.selling_plan_allocation.selling_plan.id;
        const quantity = items
          .filter((item) => item.variant_id === planItem.variant_id && item.selling_plan_allocation && item.selling_plan_allocation.selling_plan.id === planId)
          .reduce((sum, item) => sum + item.quantity, 0);
        const planLine = { id: planItem.variant_id, quantity: quantity, selling_plan: planId };
        if (planItem.properties && Object.keys(planItem.properties).length) planLine.properties = planItem.properties;
        const kitLines = FREE_PRODUCTS.map((freeProd) => ({
          id: freeProd.variantId,
          quantity: 1,
          properties: { '_welcome_kit': 'true' }
        }));
        const lines = window.KCPlanSelect.addOrder(kitLines.concat(planLine));
        try {
          const response = await window.KCPlanSelect.replaceChoice(String(planItem.product_id), String(planId), () =>
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-Karmi-Sync': 'false' },
              body: JSON.stringify({ items: lines }),
            })
          );
          if (!response.ok) return false;
          await applyDiscountCode();
          return true;
        } catch (e) {
          return false;
        }
      }

      async function applyDiscountCode() {
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Karmi-Sync': 'false' },
            body: JSON.stringify({ discount: DISCOUNT_CODE }),
          });
        } catch (e) {}
      }

      async function syncFreeProduct(providedCart) {
        if (isUpdating) return;
        isUpdating = true;

        try {
          const cart = (providedCart && Array.isArray(providedCart.items)) ? providedCart : await getCart();
          const items = cart.items || [];

          const hasBundleSubscription = items.some((item) =>
            BUNDLE_PRODUCT_IDS.includes(item.product_id) &&
            Boolean(
              item.selling_plan_allocation ||
              (item.selling_plan_id && !isNaN(parseInt(item.selling_plan_id)) && parseInt(item.selling_plan_id) > 0)
            )
          );

          let cartChanged = false;

          if (customerAlreadyReceivedFreeProduct || !hasBundleSubscription) {
            const updates = {};
            for (const freeProd of FREE_PRODUCTS) {
              const freeLineItem = items.find((item) =>
                item.product_id === freeProd.productId &&
                item.properties &&
                item.properties['_welcome_kit'] === 'true'
              );
              if (freeLineItem) {
                updates[freeLineItem.key] = 0;
              }
            }
            // "Subscription Name" (Care Credit) belongs to a subscription in the cart: clear it once none
            // is left, also when there are no kit lines to remove, and keep it while one remains
            // (only from a full cart: an add response lists just the added lines)
            const isFullCart = Boolean(cart.attributes);
            const hasAnySubscription = items.some((item) => item.selling_plan_allocation);
            const staleSubscriptionName = isFullCart && !hasAnySubscription && cart.attributes['Subscription Name'];
            if (Object.keys(updates).length > 0 || staleSubscriptionName) {
              const body = Object.keys(updates).length > 0 ? { updates: updates, discount: '' } : {};
              if (isFullCart && !hasAnySubscription) body.attributes = { 'Subscription Name': '' };
              await fetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Karmi-Sync': 'false' },
                body: JSON.stringify(body),
              });
              cartChanged = true;
            }
          } else {
            const kitMissing = FREE_PRODUCTS.some((freeProd) => !items.some((item) => item.product_id === freeProd.productId));
            if (kitMissing) cartChanged = await repairKit();
          }

          if (cartChanged) {
            refreshCartDrawer();
          }
        } finally {
          isUpdating = false;
        }
      }

      function refreshCartDrawer() {
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        if (typeof window.refreshDawnCartUI === 'function') {
          window.refreshDawnCartUI().catch(() => {});
        } else if (typeof window.Shopify !== 'undefined') {
          fetch('/cart.js')
            .then((r) => r.json())
            .then((cart) => {
              document.dispatchEvent(
                new CustomEvent('cart:updated', { detail: { cart } })
              );
            });
        }
      }

      const originalFetch = window.fetch;
      window.fetch = async function (...args) {
        const options = args[1] || {};
        const headers = options.headers || {};
        const isInternalSync = headers['X-Karmi-Sync'] === 'false';

        const response = await originalFetch.apply(this, args);
        const url = typeof args[0] === 'string' ? args[0] : args[0]?.url || '';
        if (
          !isInternalSync &&
          (url.includes('/cart/add') ||
          url.includes('/cart/change') ||
          url.includes('/cart/update'))
        ) {
          response.clone().json().then((cartData) => {
            syncFreeProduct(cartData && Array.isArray(cartData.items) ? cartData : null);
          }).catch(() => {
            syncFreeProduct();
          });
        }
        return response;
      };

      document.addEventListener('cart:updated', syncFreeProduct);
      document.addEventListener('DOMContentLoaded', syncFreeProduct);
      window.karmiWelcomeKitSync = syncFreeProduct;

      window.addEventListener('pageshow', (event) => {
        const isBackNavigation = event.persisted ||
          (window.performance && window.performance.navigation && window.performance.navigation.type === 2);
        if (isBackNavigation) {
          refreshCartDrawer();
        }
      });
    })();
  </script>
{% endif %}
