{% if settings.enable_welcome_kit %}
  <script>
    (function () {
      // ─── CONFIG (Theme Settings Driven) ──────────────────────────────────────
      const BUNDLE_PRODUCT_IDS = [
        {% for prod_item in settings.welcome_kit_bundle_products %}
          {%- liquid
            assign prod = prod_item
            if prod_item.id == nil
              assign prod = all_products[prod_item]
            endif
          -%}
          {% if prod != blank and prod.id != blank %}
            {{ prod.id }}{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ];

      const FREE_PRODUCTS = [
        {% for prod_item in settings.welcome_kit_free_product %}
          {%- liquid
            assign prod = prod_item
            if prod_item.id == nil
              assign prod = all_products[prod_item]
            endif
          -%}
          {% if prod != blank and prod.variants.first != blank %}
            {
              variantId: {{ prod.variants.first.id }},
              productId: {{ prod.id }}
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ];

      const DISCOUNT_CODE = 'Welcome Kit';

      console.log("Welcome Kit: Loaded configuration", {
        FREE_PRODUCTS,
        BUNDLE_PRODUCT_IDS
      });

      // ─── GUARD: Exit if not configured ───────────────────────────────────────
      if (FREE_PRODUCTS.length === 0 || BUNDLE_PRODUCT_IDS.length === 0) {
        console.warn("Welcome Kit: Exit because config is incomplete.");
        return;
      }

      // ─── ELIGIBILITY CHECK ────────────────────────────────────────────────────
      // FIX 1: Tag check now matches exact tag 'FREE WELCOME KIT RECEIVED' (with spaces)
      const customerAlreadyPurchased = {% if customer %}{% if customer.orders_count > 0 or customer.tags contains 'FREE WELCOME KIT RECEIVED' %}true{% else %}false{% endif %}{% else %}false{% endif %};

      function hasWelcomeKitCookie() {
        return document.cookie.split('; ').some(row => row.startsWith('welcome_kit_purchased='));
      }

      // Set cookie on thank you / order confirmation page
      if (
        window.location.pathname.includes('/thank_you') ||
        window.location.pathname.includes('/orders/') ||
        (typeof Shopify !== 'undefined' && Shopify.Checkout && Shopify.Checkout.page === 'thank_you')
      ) {
        document.cookie = "welcome_kit_purchased=true; path=/; max-age=31536000; SameSite=Lax; Secure";
      }

      let isUpdating = false;

      async function getCart() {
        const res = await fetch('/cart.js');
        return res.json();
      }

      async function addMultipleToCart(itemsArray) {
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsArray }),
        });
      }

      async function updateCartQuantities(updatesObject) {
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates: updatesObject }),
        });
      }

      // FIX 2: Apply discount code automatically to cart
      async function applyDiscountCode() {
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ discount: DISCOUNT_CODE }),
          });
          console.log("Welcome Kit: Discount code applied:", DISCOUNT_CODE);
        } catch (e) {
          console.error("Welcome Kit: Failed to apply discount code", e);
        }
      }

      // FIX 3: Remove discount code when free products are removed
      async function removeDiscountCode() {
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ discount: '' }),
          });
          console.log("Welcome Kit: Discount code removed.");
        } catch (e) {
          console.error("Welcome Kit: Failed to remove discount code", e);
        }
      }

      async function syncFreeProduct() {
        console.log("Welcome Kit: syncFreeProduct called", { isUpdating });
        if (isUpdating) return;
        isUpdating = true;

        try {
          const cart = await getCart();
          const items = cart.items || [];
          console.log("Welcome Kit: Current cart items:", items);

          // FIX 4: product_id in cart is a NUMBER, so parse BUNDLE_PRODUCT_IDS as numbers
          const hasBundleItem = items.some((item) =>
            BUNDLE_PRODUCT_IDS.includes(item.product_id)
          );

          const isNotEligible = customerAlreadyPurchased || hasWelcomeKitCookie();
          console.log("Welcome Kit: Evaluation", {
            hasBundleItem,
            isNotEligible,
            customerAlreadyPurchased,
            cookiePurchased: hasWelcomeKitCookie()
          });

          let cartChanged = false;

          if (isNotEligible || !hasBundleItem) {
            // Remove free products from cart
            const updates = {};
            for (const freeProd of FREE_PRODUCTS) {
              const freeLineItem = items.find(
                (item) => item.product_id === freeProd.productId
              );
              if (freeLineItem) {
                updates[freeLineItem.key] = 0;
              }
            }
            if (Object.keys(updates).length > 0) {
              console.log("Welcome Kit: Removing free products:", updates);
              await updateCartQuantities(updates);
              await removeDiscountCode();
              cartChanged = true;
            }
          } else {
            // Eligible — add missing free products
            const toAdd = [];
            for (const freeProd of FREE_PRODUCTS) {
              const freeLineItem = items.find(
                (item) => item.product_id === freeProd.productId
              );
              if (!freeLineItem) {
                toAdd.push({ id: freeProd.variantId, quantity: 1 });
              }
            }
            if (toAdd.length > 0) {
              console.log("Welcome Kit: Adding free products:", toAdd);
              await addMultipleToCart(toAdd);
              await applyDiscountCode(); // FIX 2: auto-apply discount
              cartChanged = true;
            }
          }

          if (cartChanged) {
            await refreshCartDrawer();
          }
        } catch (e) {
          console.error("Welcome Kit: error during syncFreeProduct", e);
        } finally {
          isUpdating = false;
        }
      }

      async function refreshCartDrawer() {
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        if (typeof window.refreshDawnCartUI === 'function') {
          try {
            await window.refreshDawnCartUI();
          } catch (e) {
            console.error("Error refreshing Dawn Cart UI:", e);
          }
        } else if (typeof window.Shopify !== 'undefined') {
          fetch('/cart.js')
            .then((r) => r.json())
            .then((cart) => {
              document.dispatchEvent(
                new CustomEvent('cart:updated', { detail: { cart } })
              );
            });
        }
      }

      // ─── INTERCEPT CART EVENTS ────────────────────────────────────────────────
      const originalFetch = window.fetch;
      window.fetch = async function (...args) {
        const response = await originalFetch.apply(this, args);
        const url = typeof args[0] === 'string' ? args[0] : args[0]?.url || '';
        // FIX 5: Exclude /cart/add triggered by syncFreeProduct itself to prevent infinite loop
        if (
          (url.includes('/cart/add') ||
          url.includes('/cart/change') ||
          url.includes('/cart/update')) &&
          !isUpdating
        ) {
          response.clone().json().then(() => syncFreeProduct()).catch(() => {});
        }
        return response;
      };

      document.addEventListener('cart:updated', syncFreeProduct);
      document.addEventListener('DOMContentLoaded', syncFreeProduct);
    })();
  </script>
{% endif %}
